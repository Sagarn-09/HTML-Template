package com.ecartes.controller;

import java.util.Date;

import javax.servlet.http.HttpServletRequest;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.validation.BindingResult;
import org.springframework.validation.ObjectError;
import org.springframework.validation.annotation.Validated;
import org.springframework.web.bind.WebDataBinder;
import org.springframework.web.bind.annotation.InitBinder;
import org.springframework.web.bind.annotation.ModelAttribute;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestMethod;
import org.springframework.web.servlet.ModelAndView;

import com.ecartes.bean.AssetCategoryBean;
import com.ecartes.bean.LoginBean;
import com.ecartes.model.AssetCategoryModel;
import com.ecartes.service.AssetCategoryService;
import com.ecartes.validator.AssetCategoryValidator;

@Controller
public class AssetCategoryController {
	@Autowired
	AssetCategoryService assetCategoryService;
	@Autowired
	AssetCategoryValidator assetCaategoryValidator;

	@ModelAttribute
	public void addingCommonObject(Model model, HttpServletRequest request) {
		model.addAttribute("assetCategory",
				AssetCategoryBean.prepareListBean(assetCategoryService.getListAssetParentCategory()));

	}

	@InitBinder
	public void InitBinder(WebDataBinder binder) {
		binder.addValidators(assetCaategoryValidator);
	}

	@RequestMapping(value = "/addAssetCategory", method = RequestMethod.GET)
	public ModelAndView addAssetCategory(@ModelAttribute("command") AssetCategoryBean assetCategoryBean,
			BindingResult result, HttpServletRequest request) {
		ModelAndView modelAndView = new ModelAndView("pages/assetCategory/addassetCategory");
		assetCategoryBean.setActive(true);
		modelAndView.addObject("assetCategoryList",
				AssetCategoryBean.prepareListBean(assetCategoryService.getListAssetCategory()));
		modelAndView.addObject("assetCategoryBean", assetCategoryBean);
		return modelAndView;

	}
	
	
