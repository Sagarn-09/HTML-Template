	@RequestMapping(value = "/saveAssetCategory", method = RequestMethod.POST)
	public ModelAndView saveAssetCategory(@ModelAttribute("command") @Validated AssetCategoryBean assetCategoryBean,
			BindingResult result, HttpServletRequest request) {
		ModelAndView modelAndView = null;
		if (result.hasErrors()) {
			modelAndView = new ModelAndView("pages/assetCategory/addassetCategory");
			return modelAndView;
		} else {
			LoginBean loginUser = (LoginBean) request.getSession().getAttribute("LOGGEDIN_USER");
			modelAndView = new ModelAndView("pages/assetCategory/displayassetCategory");
			assetCategoryBean.setCreatedOn(new java.util.Date());
			assetCategoryBean.setModifyOn(new java.util.Date());
			assetCategoryBean.setCreatedBy(loginUser.getLoginId());
			assetCategoryBean.setModifyBy(loginUser.getLoginId());
						
			if(assetCategoryBean.getAssetCategoryId()!=null && assetCategoryBean.getAssetCategory()!=null &&  assetCategoryBean.getAssetCategory().getAssetCategoryId()!=null && assetCategoryBean.getAssetCategory().getAssetCategoryId().equals( assetCategoryBean.getAssetCategoryId()) )
			{
				ObjectError objectError = new ObjectError("message", "Parenet & Chield shold not same");
				result.addError(objectError);
			}
			
			assetCategoryService.addAssetCategory(AssetCategoryBean.prepareModel(assetCategoryBean));
			modelAndView.addObject("assetCategoryList",
					AssetCategoryBean.prepareListBean(assetCategoryService.getListAssetCategory()));
			modelAndView.addObject("assetCategoryBean", assetCategoryBean);
			return modelAndView;
		}

	}

	@RequestMapping(value = "/displayAssetCategory", method = RequestMethod.GET)
	public ModelAndView displayAssetCategory(@ModelAttribute("command") AssetCategoryBean assetCategoryBean,
			BindingResult result, HttpServletRequest request) {
		ModelAndView modelAndView = null;
		if (result.hasErrors()) {
			modelAndView = new ModelAndView("pages/assetCategory/displayassetCategory");
			return modelAndView;
		} else {
			modelAndView = new ModelAndView("pages/assetCategory/displayassetCategory");
			modelAndView.addObject("assetCategoryList",
					AssetCategoryBean.prepareListBean(assetCategoryService.getListAssetCategoryOnly()));
			modelAndView.addObject("assetCategoryBean", assetCategoryBean);
			return modelAndView;
		}

	}

	@RequestMapping(value = "/editAssetCategory", method = RequestMethod.GET)
	public ModelAndView editAssetCategory(@ModelAttribute("command") AssetCategoryBean assetCategoryBean,
			BindingResult result, HttpServletRequest request) {
		ModelAndView modelAndView = null;
		if (result.hasErrors()) {
			modelAndView = new ModelAndView("pages/assetCategory/addassetCategory");
			return modelAndView;
		} else {

			modelAndView = new ModelAndView("pages/assetCategory/addassetCategory");

			modelAndView.addObject("assetCategoryBean", AssetCategoryBean
					.prepareBean(assetCategoryService.getAssetCategory(assetCategoryBean.getAssetCategoryId())));

			return modelAndView;
		}

	}
}
