package com.ecartes.service;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Propagation;
import org.springframework.transaction.annotation.Transactional;

import com.ecartes.bean.AssetCategoryBean;
import com.ecartes.dao.AssetCategoryDAO;
import com.ecartes.model.AssetCategoryModel;

@Service("assetCategoryService")
@Transactional(propagation = Propagation.SUPPORTS, readOnly = true)
public class AssetCategoryServiceImpl implements AssetCategoryService {
	@Autowired
	private AssetCategoryDAO assetCategoryDAO;

	@Transactional(propagation = Propagation.REQUIRED, readOnly = false)
	@Override
	public void addAssetCategory(AssetCategoryModel assetCategory) {
		assetCategoryDAO.addAssetCategory(assetCategory);
	}

	@Override
	public List<AssetCategoryModel> getListAssetCategory() {
		return assetCategoryDAO.getListAssetCategory();
	}

	@Override
	public AssetCategoryModel getAssetCategory(Integer assetCategoryId) {
		return assetCategoryDAO.getAssetCategory(assetCategoryId);
	}
	
	@Override
	public List<AssetCategoryModel> getListAssetCategoryOnly(){
		return assetCategoryDAO.getListAssetCategoryOnly();
	}

	@Override
	public void deleteAssetCategory(Integer assetCategoryId) {
		assetCategoryDAO.deleteAssetCategory(assetCategoryId);
	}

	@Override
	public AssetCategoryModel getAssetCategoryByName(AssetCategoryBean assetCategoryBean) {
		return assetCategoryDAO.getAssetCategoryByName(assetCategoryBean);
	}

	public List<AssetCategoryModel> getListAssetParentCategory() {
		return assetCategoryDAO.getListAssetParentCategory();
	}
}
