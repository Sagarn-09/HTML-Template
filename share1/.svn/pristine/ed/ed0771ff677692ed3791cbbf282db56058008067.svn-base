	@SuppressWarnings("deprecation")
	public static String getCellValueAsString(XSSFCell cell) throws ParseException {

		String strCellValue = null;

		if (cell != null) {
			switch (cell.getCellType()) {
			case XSSFCell.CELL_TYPE_STRING:
				strCellValue = cell.toString();
				break;
			case XSSFCell.CELL_TYPE_NUMERIC:
				if (DateUtil.isCellDateFormatted(cell)) {
					SimpleDateFormat dateFormat = new SimpleDateFormat("dd/MM/yyyy");
					strCellValue = dateFormat.format(cell.getDateCellValue());
				} else {
					Double value = cell.getNumericCellValue();
					Long longValue = value.longValue();
					strCellValue = new String(longValue.toString());
				}
				break;
			case XSSFCell.CELL_TYPE_BOOLEAN:
				strCellValue = new String(new Boolean(cell.getBooleanCellValue()).toString());
				break;
			case XSSFCell.CELL_TYPE_BLANK:
				strCellValue = "";
				break;

			case XSSFCell.CELL_TYPE_FORMULA:
				strCellValue = "";
				break;

			}
		}
		if (strCellValue != null)
			strCellValue = strCellValue.trim();
		return strCellValue;
	}

	public static String writeXLAllMaster(List<RawMaterialInwardBean> list, String path, String reportName) {
		try {
			if (list != null) {
				SimpleDateFormat sdf = new SimpleDateFormat("ddMMyyyy_hhmmss");

				String excelFileName = path + sdf.format(new Date()) + ".xls";// name of excel file
				String excelFileNameReturn = sdf.format(new Date()) + ".xls";// name of excel file

				String sheetName = reportName;// name of sheet

				@SuppressWarnings("resource")
				HSSFWorkbook wb = new HSSFWorkbook();
				HSSFSheet sheet = wb.createSheet(sheetName);
				CellStyle cellStyle = wb.createCellStyle();
				CreationHelper createHelper = wb.getCreationHelper();
				cellStyle.setDataFormat(createHelper.createDataFormat().getFormat("yyyy-mm-dd hh:mm:ss"));
				// iterating r number of rows
				int count = 1;
				for (int r = 0; list != null && r < list.size(); r++) {
					if (r == 0) {

						HSSFRow row = sheet.createRow(r);

						HSSFCell cell = row.createCell(0);
						cell.setCellType(CellType.STRING);
						cell.setCellValue("Serial No");

						cell = row.createCell(1);
						cell.setCellType(CellType.STRING);
						cell.setCellValue("Asset Tag to be Encoded");

						cell = row.createCell(2);
						cell.setCellType(CellType.STRING);
						cell.setCellValue("Last Scan Building & Floor");

						cell = row.createCell(3);
						cell.setCellType(CellType.STRING);
						cell.setCellValue("Last Scan Space Name");

						cell = row.createCell(4);
						cell.setCellType(CellType.STRING);
						cell.setCellValue("Scan Building & Floor");

						cell = row.createCell(5);
						cell.setCellType(CellType.STRING);
						cell.setCellValue("Scan Space Name");

						cell = row.createCell(6);
						cell.setCellType(CellType.STRING);
						cell.setCellValue("Trade");

						cell = row.createCell(7);
						cell.setCellType(CellType.STRING);
						cell.setCellValue("Sub Type");

						cell = row.createCell(8);
						cell.setCellType(CellType.STRING);
						cell.setCellValue("Asset UID");

						cell = row.createCell(9);
						cell.setCellType(CellType.STRING);
						cell.setCellValue("Type of Tags");

						cell = row.createCell(10);
						cell.setCellType(CellType.STRING);
						cell.setCellValue("Verified on Site");

						cell = row.createCell(11);
						cell.setCellType(CellType.STRING);
						cell.setCellValue("Modify By");

						cell = row.createCell(12);
						cell.setCellType(CellType.STRING);
						cell.setCellValue("Modify Date");

						cell = row.createCell(13);
						cell.setCellType(CellType.STRING);
						cell.setCellValue("Status");

					}
					SimpleDateFormat dateFormat = new SimpleDateFormat("dd-MMM-yyyy");

					HSSFRow row = sheet.createRow(count++);
					HSSFCell cell = row.createCell(0);
					cell.setCellType(CellType.STRING);
					if (list.get(r) != null) {
						cell.setCellValue(r + 1);
					}

					cell = row.createCell(1);
					cell.setCellType(CellType.STRING);
					if (list.get(r).getAssetTagToBeEncoded() != null) {
						cell.setCellValue(list.get(r).getAssetUID());
					} else {
						cell.setCellValue("");
					}

					cell = row.createCell(2);
					cell.setCellType(CellType.STRING);
					if (list.get(r).getBinLocation() != null
							&& list.get(r).getBinLocation().getItemLocationName() != null
							&& list.get(r).getBinLocation().getItemLocationParent() != null
							&& list.get(r).getBinLocation().getItemLocationParent().getItemLocationName() != null) {
						cell.setCellValue(list.get(r).getBinLocation().getItemLocationName()
								+ list.get(r).getBinLocation().getItemLocationParent().getItemLocationName());
					} else {
						cell.setCellValue("");
					}

					cell = row.createCell(3);
					cell.setCellType(CellType.STRING);
					if (list.get(r).getSpaceFloorName() != null) {
						cell.setCellValue(list.get(r).getSpaceFloorName());
					} else {
						cell.setCellValue("");
					}

					cell = row.createCell(4);
					cell.setCellType(CellType.STRING);
					if (list.get(r).getScanLocation() != null
							&& list.get(r).getScanLocation().getItemLocationParent() != null
							&& list.get(r).getScanLocation().getItemLocationParent().getItemLocationName() != null
							&& list.get(r).getScanLocation().getItemLocationName() != null) {
						cell.setCellValue(list.get(r).getScanLocation().getItemLocationParent().getItemLocationName()
								+ list.get(r).getScanLocation().getItemLocationName());
					} else {
						cell.setCellValue("");
					}

					cell = row.createCell(5);
					cell.setCellType(CellType.STRING);
					if (list.get(r).getScanSpaceFloorName() != null) {
						cell.setCellValue(list.get(r).getScanSpaceFloorName());
					} else {
						cell.setCellValue("");
					}

					cell = row.createCell(6);
					cell.setCellType(CellType.STRING);
					if (list.get(r).getTrade() != null) {
						cell.setCellValue(list.get(r).getTrade());
					} else {
						cell.setCellValue("");
					}

					cell = row.createCell(7);
					cell.setCellType(CellType.STRING);
					if (list.get(r).getAssetCategory() != null
							&& list.get(r).getAssetCategory().getAssetCategoryName() != null) {
						cell.setCellValue(list.get(r).getAssetCategory().getAssetCategoryName());
					} else {
						cell.setCellValue("");
					}

					cell = row.createCell(8);
					cell.setCellType(CellType.STRING);
					if (list.get(r).getAssetUID() != null) {
						cell.setCellValue(list.get(r).getAssetUID());
					} else {
						cell.setCellValue("");
					}

					cell = row.createCell(9);
					cell.setCellType(CellType.STRING);
					if (list.get(r).getTypeOfTags() != null) {
						cell.setCellValue(list.get(r).getTypeOfTags());
					} else {
						cell.setCellValue("");
					}

					cell = row.createCell(10);
					cell.setCellType(CellType.STRING);
					if (list.get(r).getVerifiedOnSite() != null) {
						cell.setCellValue(list.get(r).getVerifiedOnSite());
					} else {
						cell.setCellValue("");
					}

					cell = row.createCell(11);
					cell.setCellType(CellType.STRING);
					if (list.get(r).getUserName() != null) {
						cell.setCellValue(list.get(r).getUserName());
					} else {
						cell.setCellValue("");
					}

					cell = row.createCell(12);
					cell.setCellType(CellType.STRING);
					if (list.get(r).getModifyOn() != null) {
						cell.setCellValue(dateFormat.format(list.get(r).getModifyOn()));
					} else {
						cell.setCellValue("");
					}

					cell = row.createCell(13);
					cell.setCellType(CellType.STRING);
					if (list.get(r).getActive() != null) {
						cell.setCellValue(list.get(r).getActive());
					} else {
						cell.setCellValue("");
					}

				}

				FileOutputStream fileOut = new FileOutputStream(excelFileName);

				wb.write(fileOut);
				fileOut.flush();
				fileOut.close();
				return excelFileNameReturn;
			}
		} catch (Exception e) {

			e.printStackTrace();
		}
		return null;
	}

	public static String writeXLAllMasterInventory(List<ProcessTrackingFinalBean> list, String path,
