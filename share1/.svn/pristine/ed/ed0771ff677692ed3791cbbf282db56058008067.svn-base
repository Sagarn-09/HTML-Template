public class ReadWriteExcelFile {

	public static List<RawMaterialInwardModel> readXLSFileMaterialFile(String Path) throws IOException, ParseException {
		List<RawMaterialInwardModel> list = new ArrayList<RawMaterialInwardModel>();
		System.out.println("readXLSFileJobCardFile");
		InputStream ExcelFileToRead = new FileInputStream(Path);
		@SuppressWarnings("resource")
		XSSFWorkbook wb = new XSSFWorkbook(ExcelFileToRead);
		CellStyle cellStyle = wb.createCellStyle();
		CreationHelper createHelper = wb.getCreationHelper();
		cellStyle.setDataFormat(createHelper.createDataFormat().getFormat("YYYY-MM-DD HH:MM:SS"));

		XSSFSheet sheet = wb.getSheetAt(0);
		XSSFRow row;
		Iterator<?> rows = sheet.rowIterator();
		int count = 0;
		int tempcount = 0;
		while (rows.hasNext()) {
			row = (XSSFRow) rows.next();
			tempcount++;
			if (count > 0) {
				int colNum = row.getLastCellNum();
				RawMaterialInwardModel rawMaterialInwardModel = new RawMaterialInwardModel();

				AssetCategoryModel assetCategoryModel = new AssetCategoryModel();
				AssetCategoryModel assetCategoryParent = new AssetCategoryModel();

				if (1 <= colNum)
					rawMaterialInwardModel.setAssetTagToBeEncoded(getCellValueAsString(row.getCell(1)));
				if (2 <= colNum)
					rawMaterialInwardModel.setTagID(getCellValueAsString(row.getCell(2)));
				if (3 <= colNum)
					rawMaterialInwardModel.setTrade(getCellValueAsString(row.getCell(3)));

				if (4 <= colNum) {
					assetCategoryParent.setAssetCategoryName(getCellValueAsString(row.getCell(4)));
				}
				if (assetCategoryParent.getAssetCategoryName() == null
						|| assetCategoryParent.getAssetCategoryName().trim().length() <= 0)
					assetCategoryParent.setAssetCategoryName("Other");
				if (5 <= colNum) {
					assetCategoryModel.setAssetCategoryName(getCellValueAsString(row.getCell(5)));
					assetCategoryModel.setAssetCategory(assetCategoryParent);
					rawMaterialInwardModel.setAssetCategory(assetCategoryModel);
				}
				if (6 <= colNum)
					rawMaterialInwardModel.setTypeOfTags(getCellValueAsString(row.getCell(6)));
				// if (7 <= colNum)
				// rawMaterialInwardModel.setAssetUID(getCellValueAsString(row.getCell(7)));
				if (8 <= colNum)
					rawMaterialInwardModel.setAssetUID(getCellValueAsString(row.getCell(8)));

				list.add(rawMaterialInwardModel);

			}
			if (tempcount <= 50)
				break;
			count++;
		}
		return list;
	}

	public static String getFormatedTIFRCode(String input) {
		if (input != null && input.length() > 0) {
			String output = input.replaceAll("\\s+", "").replaceAll("TCIS", "TCIS ");
			return output.toUpperCase();
		} else {
			return input;
		}
	}

	public static HashMap<String, RawMaterialInwardModel> parentList = new HashMap<String, RawMaterialInwardModel>();
	public static HashMap<String, List<RawMaterialInwardModel>> childList = new HashMap<String, List<RawMaterialInwardModel>>();

	public static void getRecordsByParentChild(List<RawMaterialInwardModel> list) {

		if (list != null && list.size() > 0) {
			for (int i = 0; i < list.size(); i++) {
				list.get(i).setAssetUID(getFormatedTIFRCode(list.get(i).getAssetUID()));

				if (list.get(i).getAssetUID() != null && !list.get(i).getAssetUID().contains("ACCESSORIES")) {
					if (!parentList.containsKey(list.get(i).getAssetUID()))
						parentList.put(list.get(i).getAssetUID(), list.get(i));
				}

			}

			if (ReadWriteExcelFile.parentList != null && ReadWriteExcelFile.parentList.size() > 0) {

				for (String key : ReadWriteExcelFile.parentList.keySet()) {
					String data[] = key.split(" ");
					for (int i = 0; i < list.size(); i++) {
						System.out.println("data" + data[0]);
						if (list.get(i).getAssetUID() != null && list.get(i).getAssetUID().contains(data[0])) {
							if (list.get(i).getAssetUID().contains("ACCESSORIES")) {
								if (childList.containsKey(key)) {
									childList.get(key).add(list.get(i));
									System.out.println("Create old child list add" + list.get(i).getAssetUID());
								} else {
									List<RawMaterialInwardModel> listChildHM = new ArrayList<RawMaterialInwardModel>();
									listChildHM.add(list.get(i));
									childList.put(key, listChildHM);
									System.out.println("Create new child list" + list.get(i).getAssetUID());
								}
							}
						}

					}
				}

			}

		}
	}
	
	 public static List<RawMaterialInwardModel> readXLSFileMaterialFileTIFR(String path)
	            throws IOException, ParseException {
	        List<RawMaterialInwardModel> list = new ArrayList<>();
	        System.out.println("Reading XLS File");

	        try (InputStream excelFileToRead = new FileInputStream(path);
	             XSSFWorkbook wb = new XSSFWorkbook(excelFileToRead)) {

	            XSSFSheet sheet = wb.getSheetAt(0);
	            if (sheet == null) {
	                throw new IOException("Sheet not found in the Excel file");
	            }

	            // Validate headers
	            XSSFRow headerRow = sheet.getRow(0);
	            String[] expectedHeaders = {
	            		"No","SrNo", "Asset Name", "Description", "Types of Tags",
	                "Category Name", "Sub Category Name", "Building Name", "Floor Name",
	                "Room Name", "AMC Due Date", "EPC Tag ID"
	            };

	            if (!isHeaderValid(headerRow, expectedHeaders)) {
	                throw new IOException("Invalid file format: Headers do not match expected format.");
	            }

	            // Process rows
	            int count = 0;
	            for (Iterator<?> rows = sheet.rowIterator(); rows.hasNext(); count++) {
	                XSSFRow row = (XSSFRow) rows.next();

	                // Skip the header row
	                if (count == 0) continue;

	                RawMaterialInwardModel rawMaterialInwardModel = new RawMaterialInwardModel();
	                AssetCategoryModel assetCategoryModel = new AssetCategoryModel();
	                AssetCategoryModel assetCategoryParent = new AssetCategoryModel();
	                ItemLocationModel binLocationModel = new ItemLocationModel();
	                ItemLocationModel binLocationParentModel = new ItemLocationModel();

	                int colNum = row.getLastCellNum();
	                if (1 <= colNum) {
	                    rawMaterialInwardModel.setSrNo(getCellValueAsString(row.getCell(1)));
	                }
	                if (2 <= colNum) {
	                    rawMaterialInwardModel.setAssetName(getCellValueAsString(row.getCell(2)));
	                }
	                if (3 <= colNum) {
	                    rawMaterialInwardModel.setDescription(getCellValueAsString(row.getCell(3)));
	                }
	                if (4 <= colNum) {
	                    rawMaterialInwardModel.setTypeOfTags(getCellValueAsString(row.getCell(4)));
	                }
	                if (5 <= colNum) {
	                    assetCategoryParent.setAssetCategoryName(getCellValueAsString(row.getCell(5)));
	                }
	                if (assetCategoryParent.getAssetCategoryName() == null
	                        || assetCategoryParent.getAssetCategoryName().trim().isEmpty()) {
	                    assetCategoryParent.setAssetCategoryName("Other");
	                }
	                if (6 <= colNum) {
	                    assetCategoryModel.setAssetCategoryName(getCellValueAsString(row.getCell(6)));
	                    assetCategoryModel.setAssetCategory(assetCategoryParent);
	                }
	                if ((assetCategoryModel.getAssetCategoryName() == null
	                        || assetCategoryModel.getAssetCategoryName().trim().isEmpty()) && assetCategoryParent != null) {
	                    rawMaterialInwardModel.setAssetCategory(assetCategoryParent);
	                } else {
	                    rawMaterialInwardModel.setAssetCategory(assetCategoryModel);
	                }

	                if (7 <= colNum) {
	                    String parentLocationName = getCellValueAsString(row.getCell(7));
	                    if (parentLocationName == null || parentLocationName.trim().isEmpty()) {
	                        parentLocationName = "Other"; // Default parent location
	                    }
	                    binLocationParentModel.setItemLocationName(parentLocationName);
	                }

	                if (8 <= colNum) {
	                    String childLocationName = getCellValueAsString(row.getCell(8));
	                    if (childLocationName != null && !childLocationName.trim().isEmpty()) {
	                        binLocationModel.setItemLocationName(childLocationName);
	                        binLocationModel.setFloorName(childLocationName);
	                        binLocationModel.setItemLocationParent(binLocationParentModel);
	                        rawMaterialInwardModel.setBinLocation(binLocationModel);
	                    } else {
	                        rawMaterialInwardModel.setBinLocation(binLocationParentModel);
	                    }
	                }

	                if (9 <= colNum) {
	                    rawMaterialInwardModel.setSpaceFloorName(getCellValueAsString(row.getCell(9)));
	                }

	                if (10 <= colNum) {
	                    String amcDueDateStr = getCellValueAsString(row.getCell(10));
	                    try {
	                        SimpleDateFormat dateFormat = new SimpleDateFormat("yyyy-MMM-dd");
	                        Date amcDueDate = dateFormat.parse(amcDueDateStr);
	                        rawMaterialInwardModel.setAmcDueDate(amcDueDate);
	                    } catch (ParseException e) {
	                        System.err.println("Invalid date format for AMC Due Date: " + amcDueDateStr);
	                        e.printStackTrace();
	                    }
	                }
	                if (11 <= colNum) {
	                    rawMaterialInwardModel.setTagID(getCellValueAsString(row.getCell(11)));
	                }

	                list.add(rawMaterialInwardModel);
	            }
	        }
	        return list;
	    }

	    // Utility method to validate headers
	    private static boolean isHeaderValid(XSSFRow row, String[] expectedHeaders) {
	        if (row == null || expectedHeaders == null) {
	            return false;
	        }

	        for (int i = 0; i < expectedHeaders.length; i++) {
	            XSSFCell cell = row.getCell(i);
	            String header = cell != null ? cell.getStringCellValue().trim() : null;
	            if (header == null || !header.equalsIgnoreCase(expectedHeaders[i])) {
	                System.err.println("Header mismatch at column " + (i + 1) + ": Expected '" + expectedHeaders[i] + "' but found '" + header + "'");
	                return false;
	            }
	        }
	        return true;
	    }

