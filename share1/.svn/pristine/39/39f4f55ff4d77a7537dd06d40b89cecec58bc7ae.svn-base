	public static ProcessTrackingFinalModel prepareModel(ProcessTrackingFinalBean bean) {

		ProcessTrackingFinalModel model = new ProcessTrackingFinalModel();
		model.setTrackingInventoryId(bean.getTrackingInventoryId());
		model.setStatus(bean.getStatus());
		model.setCreatedBy(bean.getCreatedBy());
		model.setCreatedOn(bean.getCreatedOn());
		model.setModifyOn(bean.getModifyOn());
		model.setActive(bean.getActive());
		model.setDeviceSerialNo(bean.getDeviceSerialNo());
		model.setItemEpcId(bean.getItemEpcId());
		model.setAssetTagToBeEncoded(bean.getAssetTagToBeEncoded());
		
		if (bean.getCreatedBy() != null) {
			LoginModel login = new LoginModel();
			login.setLoginId(bean.getCreatedBy());
			model.setModifyBy(login);
		} else if (bean.getModifyBy() != null) {
			LoginModel login = new LoginModel();
			login.setLoginId(bean.getModifyBy());
			model.setModifyBy(login);
		}
		if (bean.getTrackingSessionBean() != null) {
			model.setTrackingSession(TrackingSessionBean.prepareModel(bean.getTrackingSessionBean()));
		}
		if (bean.getCreatedOnUtc() != null)
			model.setCreatedOn(Common.getDateFromUtcFormat(bean.getCreatedOnUtc()));
		if (bean.getModifyOnUtc() != null)
			model.setModifyOn(Common.getDateFromUtcFormat(bean.getModifyOnUtc()));

		if (bean.getRawMaterialInward() != null && bean.getRawMaterialInward().getRawMaterialInwardID() > 0) {
			model.setRawMaterialInward(RawMaterialInwardBean.prepareModel(bean.getRawMaterialInward()));
			
			 
		}
		
		model.setOperationStatus(bean.getOperationStatus());
		model.setItemLocationId(bean.getItemLocationId());
		return model;
	}

	public static ProcessTrackingFinalBean prepareBean(ProcessTrackingFinalModel model) {

		ProcessTrackingFinalBean bean = new ProcessTrackingFinalBean();
		bean.setTrackingInventoryId(model.getTrackingInventoryId());
		bean.setStatus(model.getStatus());
		bean.setCreatedBy(model.getCreatedBy());
		bean.setCreatedOn(model.getCreatedOn());
		if (model.getModifyBy() != null) {
			bean.setModifyBy(model.getModifyBy().getLoginId());
			bean.setUserName(model.getModifyBy().getUserName());
		}
		bean.setModifyOn(model.getModifyOn());
		bean.setActive(model.getActive());
		bean.setDeviceSerialNo(model.getDeviceSerialNo());
		bean.setItemEpcId(model.getItemEpcId());
		bean.setAssetTagToBeEncoded(model.getAssetTagToBeEncoded());
		if (model.getCreatedOn() != null)
			bean.setCreatedOnUtc(Common.getUtcFormat(model.getCreatedOn()));
		if (model.getModifyOn() != null)
			bean.setModifyOnUtc(Common.getUtcFormat(model.getModifyOn()));
		if (model.getTrackingSession() != null) {
			bean.setTrackingSessionBean(TrackingSessionBean.prepareBean(model.getTrackingSession()));
		}

		if (model.getRawMaterialInward() != null) {
			bean.setRawMaterialInward(RawMaterialInwardBean.prepareBean(model.getRawMaterialInward()));
		}
		bean.setOperationStatus(model.getOperationStatus());
		bean.setItemLocationId(model.getItemLocationId());
		return bean;
	}

	public static List<ProcessTrackingFinalBean> prepareListBean(List<ProcessTrackingFinalModel> listModel) {
		List<ProcessTrackingFinalBean> beans = null;

		if (listModel != null && !listModel.isEmpty()) {
			beans = new ArrayList<ProcessTrackingFinalBean>();
			for (ProcessTrackingFinalModel model : listModel) {
				beans.add(prepareBean(model));
			}
		}
		return beans;
	}

	public static List<ProcessTrackingFinalModel> prepareListModel(List<ProcessTrackingFinalBean> beans) {
		List<ProcessTrackingFinalModel> listModel = null;
		if (beans != null && !beans.isEmpty()) {
			listModel = new ArrayList<ProcessTrackingFinalModel>();
			for (ProcessTrackingFinalBean bean : beans) {
				listModel.add(prepareModel(bean));
			}
		}
		return listModel;
	}
