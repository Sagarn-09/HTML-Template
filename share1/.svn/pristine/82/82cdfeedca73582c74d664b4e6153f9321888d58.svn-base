function loginForm() {
	return true;
}

function checkPassword() {
	if (myform.password.value == "") {
		alert("Please enter password!");
		myform.password.focus();
		return false;
	} else if (myform.password.value != "") {
		if (myform.password.value.length < 8) {
			alert("password must contains atleast 8 or more characters");
			myform.password.focus();
			return false;
		} else if (myform.password.value == myform.userLoginId.value) {
			alert("Password must be different from Username!");
			myform.password.focus();
			return false;
		}
		re = /[0-9]/;
		if (!re.test(myform.password.value)) {
			alert("password must contain at least 8 or more character among them  one number (0-9) and  one lowercase letter (a-z) and  one uppercase letter (A-Z) !");
			myform.password.focus();
			return false;
		}
		re = /[a-z]/;
		if (!re.test(myform.password.value)) {
			alert("password must contain at least 8 or more character among them  one number (0-9) and  one lowercase letter (a-z) and  one uppercase letter (A-Z) !");
			myform.password.focus();
			return false;
		}
		re = /[A-Z]/;
		if (!re.test(myform.password.value)) {
			alert("password must contain at least 8 or more character among them  one number (0-9) and  one lowercase letter (a-z) and  one uppercase letter (A-Z) !");
			myform.password.focus();
			return false;
		}

		return true;
	} else {
		return true;
	}
}

function addUserForm() {
	re = /^\w+([\.-]?\w+)*@\w+([\.-]?\w+)*(\.\w{2,3})+$/;

	if (myform.userName.value == "") {
		alert("please enter user name");
		myform.userName.focus();
		return false;

	} else if (myform.mobileNo.value == "0" || myform.mobileNo.value == "") {
		alert("Please enter Mobile no !");
		myform.mobileNo.focus();
		return false;

	} else if (myform.mobileNo.value.length !== 10) {
		alert("Mobile Number should have exactly 10 digits.");
		myform.mobileNo.focus();
		return false;

	} else if (!re.test(myform.userLoginId.value)) {
		alert("Email must contain only letters, numbers and underscores! with @,.");
		myform.userLoginId.focus();
		return false;

	} else if (!checkPassword()) {
		return false;

	} else if (myform.roleId.value == "0") {
		alert("Please Select  Role type !");
		myform.roleId.focus();
		return false;
	} else {

		if (confirm("Are you sure?") == true) {
			return true;
		}
	}

}
function isNumberKey(evt) {
	var charCode = (evt.which) ? evt.which : event.keyCode
	if (charCode > 31 && (charCode < 48 || charCode > 57))
		return false;
	return true;
}

