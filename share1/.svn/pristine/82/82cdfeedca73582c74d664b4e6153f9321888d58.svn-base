function addCategoryForm() {

	if (myform.assetCategoryId.value > 0 && myform.assetCategoryParentId.value > 0 && myform.assetCategoryId.value == myform.assetCategoryParentId.value) {
		alert("Parent Category and child category not same");
		return false;
	} else
		if (myform.assetCategoryName.value == "") {
			alert("Please enter Asset Category Name");
			myform.assetCategoryName.focus();
			return false;

		} else if (myform.assetCategoryName.value.length > 40) {
			alert("Asset Category Name should not exceed 40 characters.");
			return false;

		} else if (myform.description.value.length > 90) {
			alert("Description should not exceed 90 characters.");
			return false;

		} else {
			if (confirm("Please confirm, Do you want save it!")) {
				return true;
			}
		}
}



function addAssetForm() {

	if (myform.assetUID.value == "") {
		alert("Please enter Asset UID");
		myform.assetUID.focus();
		return false;

	} else if (myform.assetUID.value.trim().length > 12) {
		alert("Asset UID should not exceed 12 characters.");
		return false;

	} else if (myform.typeOfTags.value == "") {
		alert("Please enter Type of Tags");
		myform.typeOfTags.focus();
		return false;

	} else if (myform.typeOfTags.value.length > 30) {
		alert("Type of Tags should not exceed 30 characters.");
		return false;

	} else if (myform.tagID.value.length > 24) {
		alert("tag ID should not exceed 24 characters.");
		return false;

	} else if (myform.itemLocationId.value == "0") {
		alert("Please select Building Name");
		myform.itemLocationId.focus();
		return false;

	} else if (myform.spaceFloorName.value == "0") {
		alert("Please select Space Floor Name");
		myform.spaceFloorName.focus();
		return false;

	} else if (myform.assetCategoryId.value == "0") {
		alert("Please select Sub-Type");
		myform.assetCategoryId.focus();
		return false;
	} else if (myform.vendorName.value == "") {
		alert("Please enter Vendor Name");
		myform.vendorName.focus();
		return false;

	} else if (myform.poNo.value == "") {
		alert("Please enter Po Number");
		myform.poNo.focus();
		return false;
	} else if (myform.billNo.value == "") {
		alert("Please enter Bill Number");
		myform.billNo.focus();
		return false;

	} else {
		if (confirm("Please confirm, Do you want save it!")) {
			return true;
		}

	}
}

function addTrackingForm() {

	if (myform.trackingSessionName.value == '') {
		alert("Please enter session name.");
		myform.trackingSessionName.focus();
		return false;

	} else if (myform.trackingSessionName.value.length > 30) {
		alert("Tracking Session Name should not exceed 30 characters.");
		return false;

	} else if (myform.sessionType.value == "0") {
		alert("Please select Session Type");
		myform.sessionType.focus();
		return false;

	} else if (myform.startDate.value == '') {
		alert("Please select start date.");
		return false;

	} else {
		if (confirm("Please confirm, Do you want save it!")) {
			return true;
		}
	}

}
