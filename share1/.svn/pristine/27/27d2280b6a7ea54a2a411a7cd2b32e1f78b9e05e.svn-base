package com.ecartes.bean;

import java.util.ArrayList;
import java.util.List;

public class MaterailBeanList {
	public List<RawMaterialInwardBean> materailBeanList = new ArrayList<RawMaterialInwardBean>();

	public List<RawMaterialInwardBean> getMaterailBeanList() {
		return materailBeanList;
	}

	public void setMaterailBeanList(List<RawMaterialInwardBean> materailBeanList) {
		this.materailBeanList = materailBeanList;
	}

	public List<AssetCategoryBean> assetCategoryBeanList = new ArrayList<AssetCategoryBean>();

	public List<ItemLocationBean> locationBeanList = new ArrayList<ItemLocationBean>();

	public List<ItemLocationSpaceBean> locationSpaceBeanList = new ArrayList<ItemLocationSpaceBean>();

	public List<AssetCategoryBean> getAssetCategoryBeanList() {
		return assetCategoryBeanList;
	}

	public void setAssetCategoryBeanList(List<AssetCategoryBean> assetCategoryBeanList) {
		this.assetCategoryBeanList = assetCategoryBeanList;
	}

	public List<ItemLocationBean> getLocationBeanList() {
		return locationBeanList;
	}

	public void setLocationBeanList(List<ItemLocationBean> locationBeanList) {
		this.locationBeanList = locationBeanList;
	}

	public List<ItemLocationSpaceBean> getLocationSpaceBeanList() {
		return locationSpaceBeanList;
	}

	public void setLocationSpaceBeanList(List<ItemLocationSpaceBean> locationSpaceBeanList) {
		this.locationSpaceBeanList = locationSpaceBeanList;
	}

}
