package com.ecartes.service;

import java.util.List;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Propagation;
import org.springframework.transaction.annotation.Transactional;
import com.ecartes.model.ItemLocationSpaceModel;
import com.ecartes.bean.ItemLocationSpaceBean;
import com.ecartes.dao.ItemLocationSpaceDAO;

@Service("itemLocationSpaceService")
@Transactional(propagation = Propagation.SUPPORTS, readOnly = true)
public class ItemLocationSpaceServiceImpl implements ItemLocationSpaceService {
	@Autowired
	private ItemLocationSpaceDAO itemLocationSpaceDao;

	@Transactional(propagation = Propagation.REQUIRED, readOnly = false)
	public void addItemLocationSpace(ItemLocationSpaceModel itemLocationSpace) {
		itemLocationSpaceDao.addItemLocationSpace(itemLocationSpace);
	}

	@Override
	public List<ItemLocationSpaceModel> getListItemLocationSpace() {

		return itemLocationSpaceDao.getListItemLocationSpace();
	}

	@Override
	public ItemLocationSpaceModel getItemLocationSpace(Integer itemLocationSpaceId) {
		return itemLocationSpaceDao.getItemLocationSpace(itemLocationSpaceId);
	}

	@Override
	public void deleteItemLocationSpace(Integer itemLocationSpaceId) {
		itemLocationSpaceDao.deleteItemLocationSpace(itemLocationSpaceId);
	}
	
	@Override
	public ItemLocationSpaceModel getItemLocationSpaceName(String itemLocationSpaceName, Integer floorId) {
		return itemLocationSpaceDao.getItemLocationSpaceName(itemLocationSpaceName,floorId);
	}
	
	@Override
	public List<ItemLocationSpaceModel> getListItemLocationSpace(String itemLocationId){
		return itemLocationSpaceDao.getListItemLocationSpace(itemLocationId);
	}

	@Override
	public List<ItemLocationSpaceModel> getListSpaceLocationByFilter(ItemLocationSpaceBean itemLocationSpaceBean){
		return itemLocationSpaceDao.getListSpaceLocationByFilter(itemLocationSpaceBean);
	}
}
