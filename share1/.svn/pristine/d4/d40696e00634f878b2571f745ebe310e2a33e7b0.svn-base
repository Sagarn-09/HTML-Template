<%@ page language="java" contentType="text/html; charset=ISO-8859-1"
	pageEncoding="ISO-8859-1"%>
<%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>
<%@taglib uri="http://www.springframework.org/tags/form" prefix="form"%>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt"%>

<%@ page import="org.owasp.encoder.Encode"%>
<%@taglib prefix="e"
	uri="https://www.owasp.org/index.php/OWASP_Java_Encoder_Project"%>
<!DOCTYPE html>
<html lang="en">

<head>
<meta charset="utf-8">
<meta name="viewport"
	content="width=device-width, initial-scale=1.0, user-scalable=0">
<meta name="description"
	content="Ecartes provides comprehensive RFID solutions for efficient asset tracking and management.">
<meta name="keywords"
	content="RFID, tracking, inventory, technology, system, sensors, tags, readers, data, security">
<meta name="author" content="Ecartes - RFID Asset Tracking">
<meta name="robots" content="noindex, nofollow">
<title>Mapping Role and Menu Operation</title>

<link rel="shortcut icon" type="image/x-icon"
	href="<%=request.getContextPath()%>/resource/assets/img/favicon.png">

<link rel="stylesheet"
	href="<%=request.getContextPath()%>/resource/assets/css/bootstrap.min.css">

<link rel="stylesheet"
	href="<%=request.getContextPath()%>/resource/assets/css/animate.css">

<link rel="stylesheet"
	href="<%=request.getContextPath()%>/resource/assets/plugins/select2/css/select2.min.css">

<link rel="stylesheet"
	href="<%=request.getContextPath()%>/resource/assets/css/dataTables.bootstrap4.min.css">

<link rel="stylesheet"
	href="<%=request.getContextPath()%>/resource/assets/plugins/fontawesome/css/fontawesome.min.css">
<link rel="stylesheet"
	href="<%=request.getContextPath()%>/resource/assets/plugins/fontawesome/css/all.min.css">

<link rel="stylesheet"
	href="<%=request.getContextPath()%>/resource/assets/css/style.css">

</head>

<body onload="body_onload();">
	<div id="global-loader">
		<div class="whirly-loader"></div>
	</div>

	<div class="main-wrapper">

		<div class="header">

			<div class="header-left active">
				<a href="${pageContext.request.contextPath}/homePage.do"
					class="logo"> <img
					src="<%=request.getContextPath()%>/resource/assets/img/logo.png"
					alt="">
				</a> <a href="${pageContext.request.contextPath}/homePage.do"
					class="logo-small"> <img
					src="<%=request.getContextPath()%>/resource/assets/img/logo-small.png"
					alt="">
				</a> <a id="toggle_btn" href="javascript:void(0);"> </a>
			</div>

			<a id="mobile_btn" class="mobile_btn" href="#sidebar"> <span
				class="bar-icon"> <span></span> <span></span> <span></span>
			</span>
			</a>

			<ul class="nav user-menu">

				<li class="nav-item dropdown has-arrow main-drop"><a
					href="javascript:void(0);" class="dropdown-toggle nav-link userset"
					data-bs-toggle="dropdown"> <span class="user-img"><img
							src="<%=request.getContextPath()%>/resource/assets/img/profiles/avator1.jpg"
							alt=""> <span class="status online"></span></span>
				</a>
					<div class="dropdown-menu menu-drop-user">
						<div class="profilename">
							<div class="profileset">
								<span class="user-img"><img
									src="<%=request.getContextPath()%>/resource/assets/img/profiles/avator1.jpg"
									alt=""> <span class="status online"></span></span>
								<div class="profilesets">
									<h6>${sessionScope.LOGGEDIN_USER.userName}</h6>
								</div>
							</div>
							<hr class="m-0">
							<a class="dropdown-item"
								href="${pageContext.request.contextPath}/editLogin.do?loginId=${sessionScope.LOGGEDIN_USER.loginId}">
								<i class="me-2" data-feather="user"></i> My Profile
							</a>
							<hr class="m-0">
							<a class="dropdown-item logout pb-0"
								href="${pageContext.request.contextPath}/logout.do"><img
								src="<%=request.getContextPath()%>/resource/assets/img/icons/log-out.svg"
								class="me-2" alt="img">Logout</a>
						</div>
					</div></li>
			</ul>
		</div>

		<div class="sidebar" id="sidebar">
			<div class="sidebar-inner slimscroll">
				<div id="sidebar-menu" class="sidebar-menu">
					<ul>
						<li><a href="${pageContext.request.contextPath}/homePage.do"><img
								src="<%=request.getContextPath()%>/resource/assets/img/icons/dashboard.svg"
								alt="img"><span>Dashboard</span> </a></li>

						<li class="submenu"><a href="javascript:void(0);"><img
								src="<%=request.getContextPath()%>/resource/assets/img/icons/users1.svg"
								alt="img"><span> Users Management</span> <span
								class="menu-arrow"></span></a>
							<ul>
								<c:if
									test="${sessionScope.menuMasteUser.containsKey('User') && sessionScope.menuMasteUser['User'].insertRecord=='true'}">
									<li><a
										href="${pageContext.request.contextPath}/addLogin.do"
										>New User </a></li>
								</c:if>
								<c:if
									test="${sessionScope.menuMasteUser.containsKey('User') && sessionScope.menuMasteUser['User'].displayRecord=='true'}">
									<li><a
										href="${pageContext.request.contextPath}/displayLogin.do">Users
											List</a></li>
								</c:if>
							</ul></li>
						<li class="submenu"><a href="javascript:void(0);"><img
								src="<%=request.getContextPath()%>/resource/assets/img/icons/role-user.svg"
								alt="img"><span> Role Access</span> <span
								class="menu-arrow"></span></a>
							<ul>
								<c:if
									test="${sessionScope.menuMasteUser.containsKey('Role Type') && sessionScope.menuMasteUser['Role Type'].insertRecord=='true'}">
									<li><a
										href="${pageContext.request.contextPath}/addRoleType.do">Add
											Role</a></li>
								</c:if>
								<c:if
									test="${sessionScope.menuMasteUser.containsKey('Role Type') && sessionScope.menuMasteUser['Role Type'].displayRecord=='true'}">
									<li><a
										href="${pageContext.request.contextPath}/displayRoleType.do">Role
											List</a></li>
								</c:if>
								<c:if
									test="${sessionScope.menuMasteUser.containsKey('Role Assign Type') && sessionScope.menuMasteUser['Role Assign Type'].insertRecord=='true'}">
									<li><a
										href="${pageContext.request.contextPath}/addRoleMenu.do" class="active">Role
											Menu Access</a></li>
								</c:if>
							</ul></li>
						<li class="submenu"><a href="javascript:void(0);"><img
								src="<%=request.getContextPath()%>/resource/assets/img/icons/location.svg"
								alt="img"><span> Location</span> <span class="menu-arrow"></span></a>
							<ul>
								<c:if
									test="${sessionScope.menuMasteUser.containsKey('Item Location') && sessionScope.menuMasteUser['Item Location'].insertRecord=='true'}">
									<li><a
										href="${pageContext.request.contextPath}/addItemLocationType.do">Add
											Building</a></li>
								</c:if>	
								<c:if
									test="${sessionScope.menuMasteUser.containsKey('Item Location') && sessionScope.menuMasteUser['Item Location'].displayRecord=='true'}">
									<li><a
										href="${pageContext.request.contextPath}/displayItemLocationType.do">Building
											List</a></li>
								</c:if>							
								<c:if
									test="${sessionScope.menuMasteUser.containsKey('Item Location') && sessionScope.menuMasteUser['Item Location'].insertRecord=='true'}">
									<li><a
										href="${pageContext.request.contextPath}/addItemLocation.do">Add
											Floor</a></li>
								</c:if>
								<c:if
									test="${sessionScope.menuMasteUser.containsKey('Item Location') && sessionScope.menuMasteUser['Item Location'].displayRecord=='true'}">
									<li><a
										href="${pageContext.request.contextPath}/displayItemLocation.do">Floor
											List</a></li>
								</c:if>
								<c:if
									test="${sessionScope.menuMasteUser.containsKey('Item Location') && sessionScope.menuMasteUser['Item Location'].insertRecord=='true'}">
									<li><a
										href="${pageContext.request.contextPath}/addItemLocationSpace.do">Add
											Space </a></li>
								</c:if>
								<c:if
									test="${sessionScope.menuMasteUser.containsKey('Item Location') && sessionScope.menuMasteUser['Item Location'].displayRecord=='true'}">
									<li><a
										href="${pageContext.request.contextPath}/displayItemLocationSpace.do">Space
											List</a></li>
								</c:if>
							</ul></li>
						<li class="submenu"><a href="javascript:void(0);"><img
								src="<%=request.getContextPath()%>/resource/assets/img/icons/category.svg"
								alt="img"><span> Category</span> <span class="menu-arrow"></span></a>
							<ul>
								<c:if
									test="${sessionScope.menuMasteUser.containsKey('Asset Category') && sessionScope.menuMasteUser['Asset Category'].insertRecord=='true'}">
									<li><a
										href="${pageContext.request.contextPath}/addAssetCategory.do">Add
											Category</a></li>
								</c:if>
								<c:if
									test="${sessionScope.menuMasteUser.containsKey('Asset Category') && sessionScope.menuMasteUser['Asset Category'].displayRecord=='true'}">
									<li><a
										href="${pageContext.request.contextPath}/displayAssetCategory.do">Category
											List</a></li>
								</c:if>
							</ul></li>
						<li class="submenu"><a href="javascript:void(0);"><img
								src="<%=request.getContextPath()%>/resource/assets/img/icons/material.svg"
								alt="img"><span> Asset</span> <span class="menu-arrow"></span></a>
							<ul>

								<c:if
									test="${sessionScope.menuMasteUser.containsKey('Raw Material') && sessionScope.menuMasteUser['Raw Material'].insertRecord=='true'}">
									<li><a
										href="${pageContext.request.contextPath}/addRawMaterialInward.do">Add
											Asset</a></li>
								</c:if>
								<c:if
									test="${sessionScope.menuMasteUser.containsKey('Raw Material') && sessionScope.menuMasteUser['Raw Material'].displayRecord=='true'}">
									<li><a
										href="${pageContext.request.contextPath}/displayRawMaterialInward.do">Asset
											List</a></li>
								</c:if>
								<c:if
									test="${sessionScope.menuMasteUser.containsKey('Raw Material') && sessionScope.menuMasteUser['Raw Material'].insertRecord=='true'}">
									<li><a
										href="${pageContext.request.contextPath}/uploadMaterial.do">Asset
											Excel Upload</a></li>
								</c:if>
							</ul></li>
						<li class="submenu"><a href="javascript:void(0);"><img
								src="<%=request.getContextPath()%>/resource/assets/img/icons/inventory.svg"
								alt="img"><span> Inventory Session</span> <span
								class="menu-arrow"></span></a>
							<ul>
								<c:if
									test="${sessionScope.menuMasteUser.containsKey('Tracking Session') && sessionScope.menuMasteUser['Tracking Session'].insertRecord=='true'}">
									<li><a
										href="${pageContext.request.contextPath}/addTrackingSession.do">Add
											Tracking Session</a></li>
								</c:if>
								<c:if
									test="${sessionScope.menuMasteUser.containsKey('Tracking Session') && sessionScope.menuMasteUser['Tracking Session'].displayRecord=='true'}">
									<li><a
										href="${pageContext.request.contextPath}/displayTrackingSession.do">Tracking
											Session List</a></li>
								</c:if>
							</ul></li>
						<li class="submenu"><a href="javascript:void(0);"><img
								src="<%=request.getContextPath()%>/resource/assets/img/icons/report.svg"
								alt="img"><span> Report </span> <span class="menu-arrow"></span></a>
							<ul>
								<c:if
									test="${sessionScope.menuMasteUser.containsKey('Display Inventory') && sessionScope.menuMasteUser['Display Inventory'].displayRecord=='true'}">
									<li><a
										href="${pageContext.request.contextPath}/display_inventory.do">Asset
											Found Inventory</a></li>
									<li><a
										href="${pageContext.request.contextPath}/display_not_inventory.do">Asset
											Not Found Inventory</a></li>
								</c:if>
								<c:if
									test="${sessionScope.menuMasteUser.containsKey('History') && sessionScope.menuMasteUser['History'].displayRecord=='true'}">
									<li><a
										href="${pageContext.request.contextPath}/trackingByAssetID.do">Asset
											Scan History</a></li>
								</c:if>
								<c:if
									test="${sessionScope.menuMasteUser.containsKey('Report') && sessionScope.menuMasteUser['Report'].displayRecord=='true'}">

									<li><a
										href="${pageContext.request.contextPath}/displayMaterialAllMaterial.do">Asset
											Master</a></li>
									<li><a
										href="${pageContext.request.contextPath}/displayMaterialAllTagMaterial.do">Tagged
											Asset</a></li>
									<li><a
										href="${pageContext.request.contextPath}/displayMaterialAllNotTagMaterial.do">UnTagged
											Asset</a></li>
								</c:if>
							</ul></li>

						<li><a href="${pageContext.request.contextPath}/logout.do"><img
								src="<%=request.getContextPath()%>/resource/assets/img/icons/log-out.svg"
								alt="img"><span>Logout</span> </a></li>
					</ul>
				</div>
			</div>
		</div>


		<form:form id='myform' method='POST'
			action='<%=Encode.forHtmlAttribute(((String) request.getContextPath()) + "/saveRoleMenu.do")%>'
			role='form' class="form-horizontal">

			<div class="page-wrapper">
				<div class="content">
					<div class="page-header">
						<div class="page-title">
							<h4>Mapping Role and Menu Operation</h4>
						</div>
					</div>

					<div class="card">
						<div class="card-body">
							<div class="row">
								<div class="error">
									<font color='red'> <form:errors path='*' />
									</font>
									<c:if test="${not empty successMessage}">
										<font color='red'>${successMessage } </font>
									</c:if>
								</div>
							</div>
							<div class="table-top">

								<div class="col-lg-3 col-sm-6 col-12">
									<div class="form-group">
										<label>Select Role</label>
										<form:select id='roleId' path="roleId"
											value="${roleMenuBean.roleId}" class="select"
											onchange="getListByRole()">

											<option value="0">Select Role</option>
											<c:forEach items="${menuRoles}" var="menuRole">

												<c:choose>
													<c:when
														test="${menuRole.roleSequece>=sessionScope.LOGGEDIN_USER.userRole.roleSequece}">
														<option value="${menuRole.roleId}"
															${menuRole.roleId == roleMenuBean.roleId ? 'selected' : ''}>${menuRole.roleName}</option>
													</c:when>
													<c:otherwise>
													</c:otherwise>
												</c:choose>

											</c:forEach>
										</form:select>
									</div>
								</div>
								<div class="wordset">
									<div class="col-lg-12">

										<button type='submit'
											onclick='JavaScript:return addRoleMenuForm();'
											class="btn btn-submit me-2">Submit</button>

										<a href="${pageContext.request.contextPath}/homePage.do"
											class="btn btn-cancel">Cancel</a>
									</div>
								</div>
							</div>

						</div>

						<div class="table-responsive">
							<table class="table table-bordered mb-0">
								<thead>
									<tr>
										<th>Sr.No.</th>
										<th>Menu Type</th>
										<th>Display<a
											href="javascript:toggleDisplay(${menuTypes.size()});">All
										</a></th>
										<th>Insert <a
											href="javascript:toggleInsert(${menuTypes.size()});">All
										</a></th>
										<th>Modify<a
											href="javascript:toggleModify(${menuTypes.size()});">All
										</a></th>
										<th>Disable<a
											href="javascript:toggleDisable(${menuTypes.size()});">All
										</a></th>
										<th>Active<a
											href="javascript:toggleActive(${menuTypes.size()});">All
										</a></th>

									</tr>
								</thead>
								<tbody>
									<c:set var="count" value="0" scope="page" />
									<c:forEach items="${menuTypes}" var="menu" varStatus="loop">

										<tr>
											<td>${loop.index+1}</td>
											<td>${e:forHtml(menu.menuName)}</td>

											<td><label class="checkboxs"> <form:checkbox
														path="insertList[${count}].displayRecord" /> <span
													class="checkmarks"></span>
											</label></td>
											<td><label class="checkboxs"> <form:checkbox
														path="insertList[${count}].insertRecord" /> <span
													class="checkmarks"></span>
											</label></td>
											<td><label class="checkboxs"> <form:checkbox
														path="insertList[${count}].updateRecord" /> <span
													class="checkmarks"></span>
											</label></td>
											<td><label class="checkboxs"> <form:checkbox
														path="insertList[${count}].disableRecord" /> <span
													class="checkmarks"></span>
											</label></td>
											<td><label class="checkboxs"> <form:checkbox
														path="insertList[${count}].active" checked='true' /> <span
													class="checkmarks"></span>
											</label></td>

										</tr>
										<form:input path="insertList[${count}].menuID"
											value="${e:forHtml(menu.menuID)}" type='hidden' />

										<c:set var="count" value="${count+1}" scope="page" />
									</c:forEach>

								</tbody>
							</table>
							<form:input id="modeRequest" path="modeRequest"
								value="${e:forHtml(roleMenuBean.modeRequest)}" type='hidden' />
						</div>
					</div>
				</div>
		</form:form>
	</div>

	<input type="hidden" name="${_csrf.parameterName}"
		value="${_csrf.token}" />

	<script type="text/javascript" charset="utf-8">
		function getListByRole() {

			myform.modeRequest.value = "getRollIdList";
			myform.action = '${pageContext.request.contextPath}/addRoleMenu.do';
			myform.submit();
		}

		function toggleDisplay(count) {

			for (var i = 0; i < count; i++) {
				var tem = 'insertList' + i + '.displayRecord1';
				var cb = document.getElementById(tem);
				cb.click();
			}
		}
		function toggleInsert(count) {

			for (var i = 0; i < count; i++) {
				var tem = 'insertList' + i + '.insertRecord1';
				var cb = document.getElementById(tem);
				cb.click();
			}
		}
		function toggleModify(count) {

			for (var i = 0; i < count; i++) {
				var tem = 'insertList' + i + '.updateRecord1';
				var cb = document.getElementById(tem);
				cb.click();
			}
		}
		function toggleDisable(count) {

			for (var i = 0; i < count; i++) {
				var tem = 'insertList' + i + '.disableRecord1';
				var cb = document.getElementById(tem);
				cb.click();
			}
		}
		function toggleActive(count) {

			for (var i = 0; i < count; i++) {
				var tem = 'insertList' + i + '.active1';
				var cb = document.getElementById(tem);
				cb.click();
			}
		}

		function body_onload() {

			var i = 0;
			<c:forEach items="${menuTypes}" var="menu">

			var tem = 'insertList' + i + '.disableRecord1';
			var cb = document.getElementById(tem);
			var cbd = '${menu.disableRecord}';
			if (cbd == 'true' && !cb.checked) {
				cb.click();
			} else if (cb.checked && cbd == 'false') {
				cb.click();
			}

			tem = 'insertList' + i + '.insertRecord1';
			cb = document.getElementById(tem);
			cbd = '${menu.insertRecord}';
			if (cbd == 'true' && !cb.checked) {
				cb.click();
			} else if (cb.checked && cbd == 'false') {
				cb.click();
			}

			tem = 'insertList' + i + '.updateRecord1';
			cb = document.getElementById(tem);
			cbd = '${menu.updateRecord}';
			if (cbd == 'true' && !cb.checked) {
				cb.click();
			} else if (cb.checked && cbd == 'false') {
				cb.click();
			}

			tem = 'insertList' + i + '.displayRecord1';
			cb = document.getElementById(tem);
			cbd = '${menu.displayRecord}';
			if (cbd == 'true' && !cb.checked) {
				cb.click();
			} else if (cb.checked && cbd == 'false') {
				cb.click();
			}

			i++;
			</c:forEach>
		};
	</script>

	<script type="text/javascript"
		src="<%=request.getContextPath()%>/resource/assets/js/validation.min.js"></script>

	<script
		src="<%=request.getContextPath()%>/resource/assets/js/jquery-3.6.0.min.js"></script>

	<script
		src="<%=request.getContextPath()%>/resource/assets/js/feather.min.js"></script>

	<script
		src="<%=request.getContextPath()%>/resource/assets/js/jquery.slimscroll.min.js"></script>

	<script
		src="<%=request.getContextPath()%>/resource/assets/js/jquery.dataTables.min.js"></script>

	<script
		src="<%=request.getContextPath()%>/resource/assets/js/dataTables.bootstrap4.min.js"></script>

	<script
		src="<%=request.getContextPath()%>/resource/assets/js/bootstrap.bundle.min.js"></script>

	<script
		src="<%=request.getContextPath()%>/resource/assets/plugins/select2/js/select2.min.js"></script>

	<script
		src="<%=request.getContextPath()%>/resource/assets/js/moment.min.js"></script>

	<script
		src="<%=request.getContextPath()%>/resource/assets/plugins/sweetalert/sweetalert2.all.min.js"></script>

	<script
		src="<%=request.getContextPath()%>/resource/assets/plugins/sweetalert/sweetalerts.min.js"></script>

	<script
		src="<%=request.getContextPath()%>/resource/assets/js/script.js"></script>

</body>

</html>