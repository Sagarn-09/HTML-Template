public static RoleMenuModel prepareModel(RoleMenuBean bean)
{
RoleMenuModel model=new RoleMenuModel();
model.setMenuID(bean.getMenuID());
model.setMenuName(bean.getMenuName());

if(bean.getMenuParent()!=null && bean.getMenuParent().getMenuID()>0 )
{		
	
	model.setMenuParent(prepareModel(bean.getMenuParent()));
}

model.setRoleId(bean.getRoleId());
model.setActive(bean.getActive());
model.setInsertRecord(bean.getInsertRecord());
model.setUpdateRecord(bean.getUpdateRecord());
model.setDisableRecord(bean.getDisableRecord());
model.setDisplayRecord(bean.getDisplayRecord());
model.setCreatedBy(bean.getCreatedBy());
model.setCreatedOn(bean.getCreatedOn());
model.setModifyBy(bean.getModifyBy());
model.setModifyOn(bean.getModifyOn());
if(bean.getCreatedOnUtc()!=null)
	model.setCreatedOn(Common.getDateFromUtcFormat(bean.getCreatedOnUtc()));
if(bean.getModifyOnUtc()!=null)
	model.setModifyOn(Common.getDateFromUtcFormat(bean.getModifyOnUtc()));
return model;
}


public static RoleMenuBean prepareBean(RoleMenuModel model)
{
RoleMenuBean bean=new RoleMenuBean();
bean.setMenuID(model.getMenuID());
bean.setMenuName(model.getMenuName());

if(model.getMenuParent()!=null && model.getMenuParent().getMenuID()>0)
{	
	
	bean.setMenuParent(prepareBean(model.getMenuParent()));
}
bean.setRoleId(model.getRoleId());
bean.setActive(model.getActive());
bean.setInsertRecord(model.getInsertRecord());
bean.setUpdateRecord(model.getUpdateRecord());
bean.setDisableRecord(model.getDisableRecord());
bean.setDisplayRecord(model.getDisplayRecord());
bean.setCreatedBy(model.getCreatedBy());
bean.setCreatedOn(model.getCreatedOn());
bean.setModifyBy(model.getModifyBy());
bean.setModifyOn(model.getModifyOn());

if(model.getCreatedOn()!=null)
	bean.setCreatedOnUtc(Common.getUtcFormat(model.getCreatedOn()));
if(model.getModifyOn()!=null)
	bean.setModifyOnUtc(Common.getUtcFormat(model.getModifyOn()));
return bean;
}

public static List<RoleMenuBean> prepareListBean(List<RoleMenuModel> listModel)
{
List<RoleMenuBean> beans=null;
if(listModel!=null && !listModel.isEmpty())
{
beans=new ArrayList<RoleMenuBean>();
for(RoleMenuModel model : listModel)
{
	beans.add(prepareBean(model));
}
}
return beans;
}
public static List<RoleMenuModel> prepareListModel(List<RoleMenuBean> beans)
{
List<RoleMenuModel> listModel=null;
if(beans!=null && !beans.isEmpty())
{
listModel=new ArrayList<RoleMenuModel>();
for(RoleMenuBean bean : beans)
{
listModel.add(prepareModel(bean));
}
}
return listModel;
}
