							<ul>
								<c:if
									test="${sessionScope.menuMasteUser.containsKey('User') && sessionScope.menuMasteUser['User'].insertRecord=='true'}">
									<li><a
										href="${pageContext.request.contextPath}/addLogin.do">New
											User </a></li>
								</c:if>
								<c:if
