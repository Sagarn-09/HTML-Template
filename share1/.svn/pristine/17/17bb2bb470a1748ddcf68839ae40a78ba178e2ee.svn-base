		</div>

		<form:form id='myform' method='POST'
			action='<%=Encode.forHtmlAttribute(((String) request.getContextPath())
						+ "/saveRawMaterialInward.do?mm=Asset&ms=Master&ss=DisplayBookDetails")%>'
			role='form' class="form-horizontal" enctype="multipart/form-data">

			<div class="page-wrapper">
				<div class="content">
					<div class="page-header">
						<div class="page-title">
							<h4>Add Asset</h4>
							<div id="selectedItemIdContainer"></div>
						</div>
						<div class="page-btn">
							<c:if
								test="${sessionScope.menuMasteUser.containsKey('Raw Material') && sessionScope.menuMasteUser['Raw Material'].displayRecord=='true'}">
								<a
									href="<%=Encode
							.forHtmlAttribute(((String) request.getContextPath()) + "/displayRawMaterialInward.do")%>"
									class="btn btn-added"><img
									src="<%=request.getContextPath()%>/resource/assets/img/icons/plus.svg"
									alt="img" class="me-1">Asset List</a>
							</c:if>
						</div>
					</div>
					<div class="card">
						<div class="card-body">
							<div class="row">
								<div class="error">
									<font color='red'> <form:errors path='*' />
									</font>
									<c:if test="${not empty successMessage}">
										<font color='red'>${successMessage } </font>
									</c:if>
								</div>
							</div>
							<div class="row">
								<div class="col-lg-3 col-sm-6 col-12">
									<div class="form-group">
										<label>Asset UID</label>
										<form:input id='assetUID' name='assetUID' path='assetUID' type='text'
											value='${rawMaterialInwardBean.assetUID}' autocomplete="off"
											placeholder="Enter Asset UID" />
									</div>
								</div>
								<div class="col-lg-3 col-sm-6 col-12">
									<div class="form-group">
										<label>Asset tag to be encoded</label>
										<form:input path='assetTagToBeEncoded' type='text'
											value='${rawMaterialInwardBean.assetTagToBeEncoded}'
											autocomplete="off"
											placeholder="Enter Asset tag to be encoded" />
									</div>
								</div>
								<div class="col-lg-3 col-sm-6 col-12">
									<div class="form-group">
										<label>Type of Tags</label>
										<form:input path='typeOfTags' type='text'
											value='${rawMaterialInwardBean.typeOfTags}'
											autocomplete="off" placeholder="Enter Type of Tags" />
									</div>
								</div>
								<div class="col-lg-3 col-sm-6 col-12">
									<div class="form-group">
										<label>Trade</label>
										<form:input path='trade' type='text'
											value='${rawMaterialInwardBean.trade}' autocomplete="off"
											placeholder="Trade" />
									</div>
								</div>
								<div class="col-lg-3 col-sm-6 col-12">
									<div class="form-group">
										<label>Tag ID</label>
										<form:input id='tagID' path='tagID' type='text'
											value='${rawMaterialInwardBean.tagID}' autocomplete="off"
											placeholder="Enter Tag ID" />
											<button type='button' style="margin-top: 15px;"
												class="btn btn-rounded btn-info" onclick='readTag();'>Read
												Tag</button>
											
									</div>
								</div>

								<div class="col-lg-3 col-sm-6 col-12">
									<div class="form-group">

										<label>Building Name</label>
										<form:select id="itemLocationId"
										path='parentLocationId'
										value='${rawMaterialInwardBean.parentLocationId}' 
											class="select" onchange="showSelectedItemFloor(this)">
											<option value="0">Select Building</option>
											<c:forEach items="${buildingLocationList}" var="binLocation">
												<option value="${binLocation.itemLocationId}"
													${binLocation.itemLocationId == rawMaterialInwardBean.parentLocationId ? 'selected' : ''}>
													${binLocation.itemLocationName}</option>
											</c:forEach>
										</form:select>
									</div>
								</div>

								<div class="col-lg-3 col-sm-6 col-12">
									<div class="form-group">
										<label>Floor Name</label>									
										<div id='floorNameid'>	</div>
									
									</div>
								</div>

								<div class="col-lg-3 col-sm-6 col-12">
									<div class="form-group">
										<label>Space Name</label>									
										<div id='spaceNameid'></div>
									
									</div>
								</div>

								<div class="col-lg-3 col-sm-6 col-12">
									<div class="form-group">
										<label>Sub Type</label>
										<form:select id='assetCategoryId'
											path="assetCategory.assetCategoryId"
											value="${rawMaterialInwardBean.assetCategory.assetCategoryId}"
											class="select">
											<option value="0">Select Sub-Type</option>
											<c:forEach items="${assetCategoryList}" var="assetCategory">
												<option value="${assetCategory.assetCategoryId}"
													${assetCategory.assetCategoryId == rawMaterialInwardBean.assetCategory.assetCategoryId ? 'selected' : ''}>${assetCategory.assetCategoryName}</option>
											</c:forEach>
										</form:select>
									</div>
								</div>

								<div class="col-lg-3 col-sm-6 col-12">
									<div class="form-group">
										<label> Verified on Site</label>
										<form:select path="verifiedOnSite" class="select"
											value="${rawMaterialInwardBean.verifiedOnSite}">
											<option value="true"
												${true == rawMaterialInwardBean.verifiedOnSite ? 'selected' : ''}>Yes</option>
											<option value="false"
												${false == rawMaterialInwardBean.verifiedOnSite ? 'selected' : ''}>No</option>
										</form:select>
									</div>
								</div>

								<div class="col-lg-3 col-sm-6 col-12">
									<div class="form-group">
										<label> Status</label>
										<form:select path="active" class="select"
											value="${rawMaterialInwardBean.active}">
											<option value="true"
												${true == rawMaterialInwardBean.active ? 'selected' : ''}>Active</option>
											<option value="false"
												${false == rawMaterialInwardBean.active ? 'selected' : ''}>Disable</option>
										</form:select>
									</div>
								</div>

								<div class="col-lg-12">
								
									<form:input id="itemLocationIdFloor"
										path='binLocation.itemLocationId'
										value='${rawMaterialInwardBean.binLocation.itemLocationId}' type='hidden' />
										
									<form:input id="itemLocationIdSpace"
										path='spaceFloorName'
										value='${rawMaterialInwardBean.spaceFloorName}' type='hidden' /> 

									<form:input id="rawMaterialInwardID" path='rawMaterialInwardID'
										value='${rawMaterialInwardBean.rawMaterialInwardID}'
										type='hidden' />

									<button type='submit' class="btn btn-submit me-2"
										onclick='JavaScript:return addAssetForm();'>Submit</button>

									<a href="${pageContext.request.contextPath}/homePage.do"
										class="btn btn-cancel">Cancel</a>
								</div>
							</div>
						</div>
					</div>

				</div>
			</div>
		</form:form>
	</div>
	<input type="hidden" name="${_csrf.parameterName}"
		value="${_csrf.token}" />

	<script type="text/javascript"
		src="<%=request.getContextPath()%>/resource/assets/js/validation.min.js"></script>

	<script
		src="<%=request.getContextPath()%>/resource/assets/js/jquery-3.6.0.min.js"></script>

	<script
		src="<%=request.getContextPath()%>/resource/assets/js/feather.min.js"></script>

	<script
		src="<%=request.getContextPath()%>/resource/assets/js/jquery.slimscroll.min.js"></script>

	<script
		src="<%=request.getContextPath()%>/resource/assets/js/jquery.dataTables.min.js"></script>
	<script
		src="<%=request.getContextPath()%>/resource/assets/js/dataTables.bootstrap4.min.js"></script>

	<script
		src="<%=request.getContextPath()%>/resource/assets/js/bootstrap.bundle.min.js"></script>

	<script
		src="<%=request.getContextPath()%>/resource/assets/plugins/select2/js/select2.min.js"></script>

	<script
		src="<%=request.getContextPath()%>/resource/assets/plugins/sweetalert/sweetalert2.all.min.js"></script>
	<script
		src="<%=request.getContextPath()%>/resource/assets/plugins/sweetalert/sweetalerts.min.js"></script>

	<script
		src="<%=request.getContextPath()%>/resource/assets/js/script.js"></script>
</body>

</html>