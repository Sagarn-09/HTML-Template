	<script
		src="<%=request.getContextPath()%>/resource/assets/js/jquery.slimscroll.min.js"></script>
	<script
		src="<%=request.getContextPath()%>/resource/assets/js/jquery.dataTables.min.js"></script>
	<script
		src="<%=request.getContextPath()%>/resource/assets/js/dataTables.bootstrap4.min.js"></script>
	<script
		src="<%=request.getContextPath()%>/resource/assets/js/bootstrap.bundle.min.js"></script>
	<script
		src="<%=request.getContextPath()%>/resource/assets/js/moment.min.js"></script>
	<script
		src="<%=request.getContextPath()%>/resource/assets/js/bootstrap-datetimepicker.min.js"></script>
	<script
		src="<%=request.getContextPath()%>/resource/assets/plugins/select2/js/select2.min.js"></script>
	<script
		src="<%=request.getContextPath()%>/resource/assets/js/moment.min.js"></script>
	<script
		src="<%=request.getContextPath()%>/resource/assets/js/bootstrap-datetimepicker.min.js"></script>
	<script
		src="<%=request.getContextPath()%>/resource/assets/plugins/sweetalert/sweetalert2.all.min.js"></script>
	<script
		src="<%=request.getContextPath()%>/resource/assets/plugins/sweetalert/sweetalerts.min.js"></script>
	<script
		src="<%=request.getContextPath()%>/resource/assets/js/script.js"></script>
</body>

</html>