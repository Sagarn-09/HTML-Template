									<li><a
										href="${pageContext.request.contextPath}/displayMaterialAllMaterial.do">Asset
											Master</a></li>
									<li><a
										href="${pageContext.request.contextPath}/displayMaterialAllTagMaterial.do">Tagged
											Asset</a></li>
									<li><a
										href="${pageContext.request.contextPath}/displayMaterialAllNotTagMaterial.do">UnTagged
											Asset</a></li>
									<li><a
										href="${pageContext.request.contextPath}/upcomingAmcDueDate.do" class="active">UpComing
											AMC Due Date</a></li>

									<li><a
										href="${pageContext.request.contextPath}/amcDueDateExpired.do">
											AMC Due Date Expired</a></li>

