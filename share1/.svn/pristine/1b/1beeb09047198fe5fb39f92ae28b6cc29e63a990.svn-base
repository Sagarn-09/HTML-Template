				</div>
			</div>
		</div>

		<form:form id='myform' method='POST'
			action='<%=Encode.forHtmlAttribute(((String) request.getContextPath()) + "/upcomingAmcDueDate.do")%>'
			role='form' class="form-horizontal">

			<div class="page-wrapper">
				<div class="content">

					<div class="page-header">
						<div class="page-title">
							<h4>Asset Lists</h4>
						</div>
						<%-- <div class="page-btn">
							<c:if
								test="${sessionScope.menuMasteUser.containsKey('Raw Material') && sessionScope.menuMasteUser['Raw Material'].insertRecord=='true'}">
								<a
									href="<%=Encode.forHtmlAttribute(((String) request.getContextPath()) + "/addRawMaterialInward.do")%>"
									class="btn btn-added"><img
									src="<%=request.getContextPath()%>/resource/assets/img/icons/plus.svg"
									alt="img" class="me-1">Add New Asset</a>
							</c:if>
						</div> --%>
					</div>

					<div class="card">
						<div class="card-body">
							<div class="table-top">
								<div class="search-set">
									<div class="search-path">
										<a class="btn btn-filter" id="filter_search"> <img
											src="<%=request.getContextPath()%>/resource/assets/img/icons/filter.svg"
											alt="img"> <span><img
												src="<%=request.getContextPath()%>/resource/assets/img/icons/closes.svg"
												alt="img"></span>
										</a>
									</div>
									<div class="search-input">
										<a class="btn btn-searchset"><img
											src="<%=request.getContextPath()%>/resource/assets/img/icons/search-white.svg"
											alt="img"></a>
									</div>
								</div>
							</div>

							<div class="card" id="filter_inputs">
								<div class="card-body pb-0">

									<div class="row">
										<div class="col-lg-2 col-sm-6 col-12">
											<div class="form-group">
												<form:select id='operation' path="operation"
													value='${rawMaterialInwardBean.operation}' class="select">
													<option value="0">Select Type</option>
													<option value="tagID"
														${'tagID' == rawMaterialInwardBean.operation ? 'selected' : ''}>
														TAG ID</option>
													<option value="assetUID"
														${'assetUID' == rawMaterialInwardBean.operation ? 'selected' : ''}>Asset
														UID</option>
												</form:select>
											</div>
										</div>
										<div class="col-lg-2 col-sm-6 col-12">
											<div class="form-group">
												<form:input id='callingPage' path='callingPage' type="text"
													autocomplete="off" placeholder="Enter Filled Value"
													value='${rawMaterialInwardBean.callingPage}' />
											</div>
										</div>

										<div class="col-lg-2 col-sm-6 col-12">
									<div class="form-group">
										<%-- <label>Tag ID</label>
										<form:input id='tagID' path='tagID' type='text'
											value='${rawMaterialInwardBean.tagID}' autocomplete="off"
											placeholder="Enter Tag ID" /> --%>
											<button type='button' 
												class="btn btn-rounded btn-info" onclick='readTag();'>Read
												Tag</button>
											
									</div>
								</div>

										<div class="col-lg-1 col-sm-6 col-12 ms-auto">
											<div class="form-group">
												<button class="btn btn-filters ms-auto" type="submit"
													onclick='JavaScript:return validateForm();'>
													<img
														src="<%=request.getContextPath()%>/resource/assets/img/icons/search-whites.svg"
														alt="img">
												</button>
											</div>
										</div>



									</div>





								</div>
							</div>

							<div class="row">
								<div class="error">
									<font color='red'> <form:errors path='*' />
									</font>
									<c:if test="${not empty successMessage}">
										<font color='red'>${successMessage } </font>
									</c:if>
								</div>
							</div>

							<div class="table-responsive">
								<table class="table  datanew">
									<thead>
										<tr>
											<th>Sr. No</th>
											<th>Asset UID</th>
											<th>Building</th>
											<th>Floor</th>
											<th>Space</th>
											<th>Scan Building</th>
											<th>Scan Floor</th>
											<th>Scan Space</th>
											<th>Sub Type</th>
											<th>Type of Tags</th>
											<th>Asset Name</th>
											<th>Description</th>
											<th>Verified on site</th>
											<th>Modify By</th>
											<th>Modify Date</th>
											<th>Status</th>
											<th>Action</th>
										</tr>
									</thead>
									<tbody>

										<c:forEach items="${rawMaterialInwardList}" var="item"
											varStatus="loop">

											<c:set var="rawMaterialInwardID"
												value="${item.rawMaterialInwardID}" />
											<c:set var="materialCodeNo" value="${item.assetUID}" />

											<c:url var="editCUrl"
												value='<%=Encode.forHtmlAttribute("/editRawMaterialInward.do?rawMaterialInwardID="
							+ pageContext.getAttribute("rawMaterialInwardID"))%>' />

											<c:url var="eyeCUrl"
												value='<%=Encode.forHtmlAttribute("/eyerawMaterialInward.do?rawMaterialInwardID="
							+ pageContext.getAttribute("rawMaterialInwardID"))%>' />

											<tr>
												<td>${loop.index+1}</td>
												<td>${e:forHtml(item.assetUID)}</td>
												<td>${e:forHtml(item.binLocation.itemLocationParent.itemLocationName)}</td>
												<td>${e:forHtml(item.binLocation.itemLocationName)}</td>
												<td>${e:forHtml(item.spaceFloorName)}</td>
												<td>${e:forHtml(item.scanLocation.itemLocationParent.itemLocationName)}</td>
												<td>${e:forHtml(item.scanLocation.itemLocationName)}</td>
												<td>${e:forHtml(item.scanSpaceFloorName)}</td>
												<td>${e:forHtml(item.assetCategory.assetCategoryName)}</td>
												<td>${e:forHtml(item.typeOfTags)}</td>
												<td>${e:forHtml(item.assetName)}</td>
												<td>${e:forHtml(item.description)}</td>
												<td>${item.verifiedOnSite == 'true' ? 'Yes' : 'No'}</td>
												<td>${e:forHtml(item.userName)}</td>
												<td><fmt:formatDate pattern="dd-MMM-YYYY"
														value="${item.modifyOn}" var="myDate" /> ${myDate}</td>
												<td>${item.active == 'true' ? 'Active' : 'Inactive'}</td>
												<c:choose>
													<c:when
														test="${sessionScope.menuMasteUser.containsKey('Raw Material') && sessionScope.menuMasteUser['Raw Material'].updateRecord=='true'}">
														<td><a class="me-3" href="${editCUrl}"> <img
																src="<%=request.getContextPath()%>/resource/assets/img/icons/edit.svg"
																alt="img">
														</a> <a class="me-3" href="${eyeCUrl}"> <img
																src="<%=request.getContextPath()%>/resource/assets/img/icons/eye.svg"
																alt="img"></a></td>
													</c:when>
													<c:otherwise>
														<td><a class="me-3" href="${eyeCUrl}"> <img
																src="<%=request.getContextPath()%>/resource/assets/img/icons/eye.svg"
																alt="img"></a></td>
													</c:otherwise>
												</c:choose>
											</tr>
										</c:forEach>
									</tbody>
								</table>

								<table cellpadding="10" cellspacing="10" width="100%"
									style="margin: 10px">
									<tr>
										<td width="20%" align="justify"></td>
										<td width="40%" align="justify"><c:set var="i"
												value="${rawMaterialInwardBean.rawMaterialInwardID}" /> <c:set
												var="i" value="${i-100}" /> <c:if test="${i>0}">
												<c:url var="paginationCUrl"
													value='<%=Encode.forHtmlAttribute(
							"/displayRawMaterialInward.do?rawMaterialInwardID=" + pageContext.getAttribute("i"))%>' />

												<button type="submit"
													class="btn btn-block btn-outline-secondary"
													onclick='JavaScript:return validateForm2();'>Previous
													100</button>
											</c:if></td>
										<td width="40%" align="justify"><form:input
												path='rawMaterialInwardID'
												value='${rawMaterialInwardBean.rawMaterialInwardID}'
												type='hidden' /> <c:set var="i"
												value="${rawMaterialInwardBean.rawMaterialInwardID}" /> <c:set
												var="i" value="${i+100}" /> <c:if test="${  i<countRecord}">
												<c:url var="paginationCUrl"
													value='<%=Encode.forHtmlAttribute(
							"/displayRawMaterialInward.do?rawMaterialInwardID=" + pageContext.getAttribute("i"))%>' />

												<button type="submit"
													class="btn btn-block btn-outline-secondary"
													onclick='JavaScript:return validateForm1();'>Next
													100</button>
											</c:if></td>


									</tr>
								</table>
							</div>

						</div>
					</div>

				</div>
			</div>
		</form:form>

	</div>

	<script type="text/javascript">
		function validateForm1() {

			myform.rawMaterialInwardID.value = (parseInt(myform.rawMaterialInwardID.value) + 100);
			return true;
		}

		function validateForm2() {

			myform.rawMaterialInwardID.value = (parseInt(myform.rawMaterialInwardID.value) - 100);
			return true;
		}
	</script>

	<input type="hidden" name="${_csrf.parameterName}"
		value="${_csrf.token}" />
