//			return list.get(list.size() - 1);
//		return null;
	
	@Override
	public ItemLocationSpaceModel getItemLocationSpaceName(String itemLocationSpaceName, Integer itemLocationId ) {
		Criteria criteria = sessionFactory.getCurrentSession().createCriteria(ItemLocationSpaceModel.class, "details");
		criteria.createAlias("details.itemLocationFloor", "itemLocationFloor");
		criteria.add(Restrictions.eq("itemLocationFloor.itemLocationId",	itemLocationId));
		criteria.add(Restrictions.eq("itemLocationSpaceName", itemLocationSpaceName)).list();
	
		List<ItemLocationSpaceModel> list=(List<ItemLocationSpaceModel>)	criteria.list();
		if (list != null && list.size() > 0)
			return list.get(list.size() - 1);
		return null;
	
	}

	@Override
	public List<ItemLocationSpaceModel> getListSpaceLocationByFilter(ItemLocationSpaceBean itemLocationSpaceBean) {

		Criteria criteria = sessionFactory.getCurrentSession().createCriteria(ItemLocationSpaceModel.class, "details");

		if (itemLocationSpaceBean != null && itemLocationSpaceBean.getItemLocationMain() != null
				&& itemLocationSpaceBean.getItemLocationMain().getItemLocationId() != null
				&& itemLocationSpaceBean.getItemLocationMain().getItemLocationId() > 0) {
			criteria.createAlias("details.itemLocationFloor", "itemLocationFloor");

			criteria.add(Restrictions.eq("itemLocationFloor.itemLocationParent.itemLocationId",	itemLocationSpaceBean.getItemLocationMain().getItemLocationId()));
		}
		if (itemLocationSpaceBean != null && itemLocationSpaceBean.getItemLocationFloor() != null
				&& itemLocationSpaceBean.getItemLocationFloor().getItemLocationId() != null
				&& itemLocationSpaceBean.getItemLocationFloor().getItemLocationId() > 0) {

			criteria.add(Restrictions.eq("itemLocationFloor.itemLocationId", itemLocationSpaceBean.getItemLocationFloor().getItemLocationId()));

		}

		return criteria.list();
	}
	


}
