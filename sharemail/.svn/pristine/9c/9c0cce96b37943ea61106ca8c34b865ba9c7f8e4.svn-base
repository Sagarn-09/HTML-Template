package com.ecartes.service;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Propagation;
import org.springframework.transaction.annotation.Transactional;

import com.ecartes.dao.RoleMenuDAO;
import com.ecartes.model.RoleMenuModel;

@Service("roleMenuService")
@Transactional(propagation = Propagation.SUPPORTS, readOnly = true)
public class RoleMenuServiceImpl implements RoleMenuService {
	@Autowired
	private RoleMenuDAO roleMenuDao;

	@Transactional(propagation = Propagation.REQUIRED, readOnly = false)
	public void addRoleMenu(RoleMenuModel roleMenu) {
		roleMenuDao.addRoleMenu(roleMenu);
	}

	@Override
	public List<RoleMenuModel> getListRoleMenu() {

		return roleMenuDao.getListRoleMenu();
	}

	@Override
	public RoleMenuModel getRoleMenu(Integer menuID) {
		return roleMenuDao.getRoleMenu(menuID);
	}

	@Override
	public void deleteRoleMenu(Integer menuID) {
		roleMenuDao.deleteRoleMenu(menuID);
	}

	@Override
	public List<RoleMenuModel> getListRoleMenuType(int menuParentID) {

		return roleMenuDao.getListRoleMenuType(menuParentID);
	}

	@Override
	public void deleteRoleMenuByRoleID(Integer roleID) {

		roleMenuDao.deleteRoleMenuByRoleID(roleID);
	}

	@Override
	public List<RoleMenuModel> getMenuByUserRole(int roleID) {

		return roleMenuDao.getMenuByUserRole(roleID);

	}

}
