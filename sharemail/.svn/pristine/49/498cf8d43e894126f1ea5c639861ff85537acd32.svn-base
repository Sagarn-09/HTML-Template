package com.ecartes.model;
import java.io.Serializable;
import java.util.Date;
import javax.persistence.Column;
import javax.persistence.Entity;
import javax.persistence.GeneratedValue;
import javax.persistence.GenerationType;
import javax.persistence.Id;
import javax.persistence.Table;

@Entity
@Table(name="TrackingSession")
public class TrackingSessionModel implements Serializable
{
private static final long serialVersionUID = -723583058586873479L;
@Id
@GeneratedValue(strategy=GenerationType.AUTO)
@Column(name = "trackingSessionId")
private Integer trackingSessionId=null;
public Integer getTrackingSessionId()
{
 return trackingSessionId;
}
public void  setTrackingSessionId(Integer trackingSessionId)
{
 this.trackingSessionId=trackingSessionId;
}
@Column(name = "trackingSessionName")
private String  trackingSessionName=null;
public String getTrackingSessionName()
{
 return trackingSessionName;
}
public void  setTrackingSessionName(String trackingSessionName)
{
 this.trackingSessionName=trackingSessionName;
}
//@Column(name = "startDate", updatable=true)
//private Date  startDate=null;
@Column(name = "startDate", nullable = true, updatable=true)	
private Date	startDate=null;
public Date getStartDate()
{
 return startDate;
}
public void  setStartDate(Date startDate)
{
 this.startDate=startDate;
}
//@Column(name = "endDate", updatable=true)
//private Date  endDate=null;
@Column(name = "endDate", nullable = true, updatable=true)	
private Date	endDate=null;
public Date getEndDate()
{
 return endDate;
}
public void  setEndDate(Date endDate)
{
 this.endDate=endDate;
}

@Column(name = "sessionType")
private String sessionType=null;

public String getSessionType() {
	return sessionType;
}
public void setSessionType(String sessionType) {
	this.sessionType = sessionType;
}

@Column(name = "createdBy")
private Integer createdBy=0;
public Integer getCreatedBy()
{
 return createdBy;
}
public void  setCreatedBy(Integer createdBy)
{
 this.createdBy=createdBy;
}
//@Column(name = "createdOn", updatable=true)
//private Date  createdOn=null;

@Column(name = "createdOn", nullable = true, updatable=true)	
private Date	createdOn=null;

public Date getCreatedOn()
{
 return createdOn;
}
public void  setCreatedOn(Date createdOn)
{
 this.createdOn=createdOn;
}
@Column(name = "modifyBy")
private Integer modifyBy=0;
public Integer getModifyBy()
{
 return modifyBy;
}
public void  setModifyBy(Integer modifyBy)
{
 this.modifyBy=modifyBy;
}
//@Column(name = "modifyOn", updatable=true)
//private Date  modifyOn=null;
@Column(name = "modifyOn", nullable = true, updatable=true)	
private Date	modifyOn=null;

public Date getModifyOn()
{
 return modifyOn;
}
public void  setModifyOn(Date modifyOn)
{
 this.modifyOn=modifyOn;
}
@Column(name = "active")
private Boolean  active=false;
public Boolean getActive()
{
 return active;
}
public void  setActive(Boolean active)
{
 this.active=active;
}

}
