package com.ecartes.service;
import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Propagation;
import org.springframework.transaction.annotation.Transactional;

import com.ecartes.dao.TrackingSessionDAO;
import com.ecartes.model.TrackingSessionModel;
@Service("trackingSessionService")
@Transactional(propagation = Propagation.SUPPORTS, readOnly = true)
public class TrackingSessionServiceImpl implements TrackingSessionService 
{
@Autowired
private TrackingSessionDAO trackingSessionDao;
@Transactional(propagation = Propagation.REQUIRED, readOnly = false)
public void addTrackingSession(TrackingSessionModel trackingSession)
{
trackingSessionDao.addTrackingSession(trackingSession);
}
@Override
public List<TrackingSessionModel> getListTrackingSession()
{

return trackingSessionDao.getListTrackingSession();
}

@Override
public TrackingSessionModel  getTrackingSession(Integer trackingSessionId)
{
return trackingSessionDao.getTrackingSession( trackingSessionId);
}

@Override
public void deleteTrackingSession(Integer trackingSessionId)
{
trackingSessionDao.deleteTrackingSession( trackingSessionId);
}
@Override
public TrackingSessionModel getTrackingSessionCurrent() {
	return trackingSessionDao.getTrackingSessionCurrent();
}
@Override
public List<TrackingSessionModel> getCurrentSession(String sessionType) {
	return trackingSessionDao.getCurrentSession(sessionType);
}
public List<TrackingSessionModel>  getTrackingSessionAllActive()
{
	return trackingSessionDao.getTrackingSessionAllActive();
}
}

