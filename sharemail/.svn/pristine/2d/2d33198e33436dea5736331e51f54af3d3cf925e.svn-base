package com.ecartes.validator;
import java.util.regex.Pattern;

import org.springframework.stereotype.Component;
import org.springframework.validation.Errors;
import org.springframework.validation.ValidationUtils;
import org.springframework.validation.Validator;

import com.ecartes.bean.RoleTypeBean;
@Component
public class RoleTypeValidator implements Validator{
	
	   @Override
	   public boolean supports(Class<?> clazz) {
	      return RoleTypeBean.class.equals(clazz);
	   }
	   
	   @Override
	   public void validate(Object obj, Errors err) {

	     ValidationUtils.rejectIfEmpty(err, "roleName", "rolemenu.roleName.empty");
	     ValidationUtils.rejectIfEmpty(err, "roleSequece", "rolemenu.roleName.empty");
	      
	      if(!err.hasErrors())
	      {
	    	  RoleTypeBean roleTypeBean = (RoleTypeBean) obj;
	
	    	  Pattern pattern = Pattern.compile("[a-zA-Z0-9 [-_////&(),.]]*",
	    	            Pattern.CASE_INSENSITIVE);
		      if (!(pattern.matcher(roleTypeBean.getRoleName() ).matches())) {
		    	  err.rejectValue("roleName", "rolemenu.filed.length");
		      }
		   
		      if(roleTypeBean.getRoleName()!=null && roleTypeBean.getRoleName().length()>=30)
			  	{
			    	err.rejectValue("roleName", "rolemenu.filed.length");
			  	}
		      
	      }
	      
	   }

}
