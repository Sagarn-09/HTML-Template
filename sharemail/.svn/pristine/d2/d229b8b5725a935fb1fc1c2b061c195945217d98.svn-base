package com.ecartes.validator;

import org.springframework.stereotype.Component;
import org.springframework.validation.Errors;
import org.springframework.validation.ValidationUtils;
import org.springframework.validation.Validator;

import com.ecartes.bean.TrackingSessionBean;

@Component
public class TrackingSessionValidator implements Validator {

	@Override
	public boolean supports(Class<?> clazz) {
		return TrackingSessionBean.class.equals(clazz);
	}

	@Override
	public void validate(Object obj, Errors err) {

		ValidationUtils.rejectIfEmpty(err, "trackingSessionName", "trackingSession.trackingSessionName.empty");
		ValidationUtils.rejectIfEmpty(err, "sessionType", "trackingSessionName.sessionType.empty");

		if (!err.hasErrors()) {
			TrackingSessionBean trackingSessionBean = (TrackingSessionBean) obj;

			if (trackingSessionBean.getTrackingSessionName() != null
					&& trackingSessionBean.getTrackingSessionName().length() >= 40) {
				err.rejectValue("trackingSessionName", "trackingSessionName.filed.length");
			}
					
		}

	}

}
