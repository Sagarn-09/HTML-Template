							&& list.get(i).getRawMaterialInward().getAssetCategory().getAssetCategoryName() != null) {
						String data7 = list.get(i).getRawMaterialInward().getAssetCategory().getAssetCategoryName();
						table.addCell(new Phrase(data7, text_font));
					} else {
						table.addCell(new Phrase(data, text_font));
					}

					if (list.get(i).getRawMaterialInward() != null
							&& list.get(i).getRawMaterialInward().getAssetUID() != null) {
						String data8 = list.get(i).getRawMaterialInward().getAssetUID();
						table.addCell(new Phrase(data8.toString(), text_font));
					} else {
						table.addCell(new Phrase(data, text_font));
					}

					if (list.get(i).getRawMaterialInward() != null
							&& list.get(i).getRawMaterialInward().getTypeOfTags() != null) {
						String data9 = list.get(i).getRawMaterialInward().getTypeOfTags();
						table.addCell(new Phrase(data9.toString(), text_font));
					} else {
						table.addCell(new Phrase(data, text_font));
					}

				}
			}
			document.add(table);
			document.close();
			writer.close();

		} catch (Exception e) {
			e.printStackTrace();
		}
		return excelFileNameReturn;
	}

