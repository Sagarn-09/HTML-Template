<%@ page language="java" contentType="text/html; charset=ISO-8859-1"
	pageEncoding="ISO-8859-1"%>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>
<%@ taglib uri="http://www.springframework.org/tags/form" prefix="form"%>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt"%>
<%@ page import="org.owasp.encoder.Encode"%>

<!DOCTYPE html>
<html lang="en">

<head>
<meta charset="utf-8">
<meta name="viewport"
	content="width=device-width, initial-scale=1.0, user-scalable=0">
<meta name="description"
	content="Ecartes provides comprehensive RFID solutions for efficient asset tracking and management.">
<meta name="keywords"
	content="RFID, tracking, inventory, technology, system, sensors, tags, readers, data, security">
<meta name="author" content="Ecartes - RFID Asset Tracking">
<meta name="robots" content="noindex, nofollow">
<title>Login</title>

<link rel="shortcut icon" type="image/x-icon"
	href="<%=request.getContextPath()%>/resource/assets/img/favicon.png">

<style>
.container { -
	-bs-gutter-x: 1.5rem; -
	-bs-gutter-y: 0;
	width: 90%;
	padding-right: calc(var(- -bs-gutter-x)* .5);
	padding-left: calc(var(- -bs-gutter-x)* .5);
	margin: auto
}

@media ( min-width :576px) {
	.container {
		max-width: 190px
	}
}

@media ( min-width :768px) {
	.container {
		max-width: 260px
	}
}

@media ( min-width :992px) {
	.container {
		max-width: 330px
	}
}

@media ( min-width :1200px) {
	.container {
		max-width: 400px
	}
}

@media ( min-width :1400px) {
	.container {
		max-width: 460px
	}
}

.login-userheading {
	margin: 0 0 10px
}

.row { -
	-bs-gutter-x: 0.5rem; -
	-bs-gutter-y: 0;
	display: flex;
	flex-wrap: wrap;
	margin-top: calc(-1 * var(- -bs-gutter-y));
	margin-right: calc(-.5 * var(- -bs-gutter-x));
	margin-left: calc(-.5 * var(- -bs-gutter-x))
}

.form-login {
	margin-bottom: 15px
}

input {
	width: 95%;
	height: 35px;
	border: 1px solid rgba(145, 158, 171, .32);
	padding: 0 12px 0 12px;
	border-radius: 5px;
	position: relative;
	top: 4px
}

.btn {
	width: 50%;
	font-weight: 700;
	font-size: 16px;
	color: #ff9f43;
	background: #fff;
	border: 1px solid #ff9f43;
	border-radius: 6px;
	padding: 12px 15px;
	text-align: center
}

.btn-login {
	width: 50%;
	font-weight: 700;
	background: #ff9f43;
	border-color: #ff9f43;
	padding: 12px;
	-webkit-transition: all .5s ease;
	-ms-transition: all .5s ease;
	transition: all .5s ease;
	margin-top: 15px;
	color: #fff
}

.btn:hover {
	background: #ff9f43;
	color: #fff
}

.btn:hover span {
	border: 3px solid #fff;
	border-right-color: #fff
}

.btn-login:hover {
	box-shadow: 0 50px #fff inset !important;
	color: #ff9f43
}

.my-6 {
	margin-top: 6rem;
	margin-bottom: 6rem;
}

.my-1 {
	margin-top: 1rem;
	margin-bottom: 1rem;
}

.mt-4 {
	margin-top: 4rem;
}
</style>

</head>

<body>

	<div class="container my-6">

		<form:form method='POST'
			action='<%=Encode.forHtmlAttribute(((String) request.getContextPath()) + "/login.do")%>'
			role='form'>

			<div class="login-userheading">
					<img
					src="<%=request.getContextPath()%>/resource/assets/img/nims-logo.png"
					alt="NIMS Logo"
					style="display: block; margin: 0 auto; max-width: 120px;">

				<h2>Sign In</h2>
				<h4>Please login to your account</h4>
			</div>

			<div class="row my-1">
				<div class="error">
					<font color='red'> <form:errors path='*' />
					</font>
					<c:if test="${not empty successMessage}">
						<font color='red'>${successMessage } </font>
					</c:if>
				</div>
			</div>
			<div>
				<label>Email</label>
			</div>
			<div class="form-login">
				<form:input autocomplete="off" path='userLoginId' type='Email'
					placeholder='Enter Email' />
			</div>
			<div>
				<label>Password</label>
			</div>
			<div class="form-login">
				<form:input type="password" id="password" path='password'
					class="pass-input" placeholder="Enter Password" autocomplete="off" />
			</div>

			<form:input type="hidden" path="mode" value="User Login" />

			<div class="form-login">
				<button class="btn btn-login" type='submit'
					onclick='JavaScript:return loginForm();'>Sign In</button>
			</div>

			<hr class="mt-4">
			<h3>Powered By</h3>
			<h4>Ecartes Technology Pvt Ltd.</h4>

		</form:form>
	</div>

	<input type="hidden" name="${_csrf.parameterName}"
		value="${_csrf.token}" />

	<script type="text/javascript"
		src="<%=request.getContextPath()%>/resource/assets/js/validation.min.js"></script>

</body>

</html>