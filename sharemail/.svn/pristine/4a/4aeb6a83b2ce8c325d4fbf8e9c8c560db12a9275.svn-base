package com.ecartes.validator;

import java.util.regex.Pattern;

import org.springframework.stereotype.Component;
import org.springframework.validation.Errors;
import org.springframework.validation.ValidationUtils;
import org.springframework.validation.Validator;

import com.ecartes.bean.AssetCategoryBean;

@Component
public class AssetCategoryValidator implements Validator {

	@Override
	public boolean supports(Class<?> clazz) {
		return AssetCategoryBean.class.equals(clazz);
	}

	@Override
	public void validate(Object obj, Errors err) {

		ValidationUtils.rejectIfEmpty(err, "assetCategoryName", "assetCategory.assetCategoryName.empty");
//		ValidationUtils.rejectIfEmpty(err, "description", "assetCategory.description.empty");

		if (!err.hasErrors()) {
			AssetCategoryBean assetCategoryBean = (AssetCategoryBean) obj;

			Pattern pattern = Pattern.compile("[a-zA-Z0-9 [-_////&(),.]]*", Pattern.CASE_INSENSITIVE);
			if (!(pattern.matcher(assetCategoryBean.getAssetCategoryName()).matches())) {
				err.rejectValue("assetCategoryName", "assetCategoryName.filed.length");
			}

			if (assetCategoryBean.getAssetCategoryName() != null
					&& assetCategoryBean.getAssetCategoryName().length() >= 40) {
				err.rejectValue("assetCategoryName", "assetCategoryName.filed.length");
			}
			
//			if (assetCategoryBean.getDescription() != null
//					&& assetCategoryBean.getDescription().length() >= 90) {
//				err.rejectValue("description", "description.filed.length");
//			}

		}

	}

}
