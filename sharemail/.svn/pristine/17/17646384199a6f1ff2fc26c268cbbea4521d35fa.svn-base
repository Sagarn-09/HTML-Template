package com.ecartes.aop;

import java.io.File;
import java.io.IOException;
import java.io.PrintWriter;
import java.io.StringWriter;
import java.util.logging.FileHandler;
import java.util.logging.Logger;
import java.util.logging.SimpleFormatter;
import org.aspectj.lang.JoinPoint;
import org.aspectj.lang.annotation.AfterThrowing;
import org.aspectj.lang.annotation.Aspect;
import org.springframework.aop.ThrowsAdvice;


 
@Aspect
public class CatchThrowException implements ThrowsAdvice{
 private String logFolderPath=null;
    public String getLogFolderPath() {
	return logFolderPath;
}


public void setLogFolderPath(String logFolderPath) {	
	this.logFolderPath = logFolderPath;
}


	@AfterThrowing(
    //pointcut="execution(* com.echallan.aop.MyBusinessService.testThrowException(..))",
     pointcut="execution(* com.ecartes.*.*.*(..))"  ,		
    throwing="excep")
    public void afterThrowing(JoinPoint joinPoint, Throwable excep) throws Throwable {
        
        excep.printStackTrace();
        
        StringWriter errors = new StringWriter();
        excep.printStackTrace(new PrintWriter(errors));
        logFile (errors.toString());
        
    }
    
    
    public void logFile(String message)
    {

    	
        Logger logger = Logger.getLogger("MyLog");  
        FileHandler fh;  

        try {  

        	File f=new File(logFolderPath);
        	if(!f.isDirectory())
        	{
        		f.mkdir();
        	}
            // This block configure the logger with handler and formatter  
            fh = new FileHandler(logFolderPath+"/LogFile.txt",true);  
            logger.addHandler(fh);
            SimpleFormatter formatter = new SimpleFormatter();  
            fh.setFormatter(formatter); 
            logger.info("-------------------Start----------------------");
            logger.info(message);
            logger.info("-------------------END----------------------");
            
            
        } catch (SecurityException e) {  
            e.printStackTrace();  
        } catch (IOException e) {  
            e.printStackTrace();  
        }  

        
    }
}

