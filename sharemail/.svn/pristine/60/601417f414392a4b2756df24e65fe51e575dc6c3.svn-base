	public static RawMaterialInwardModel prepareModel(RawMaterialInwardBean bean) {
		RawMaterialInwardModel model = new RawMaterialInwardModel();
		model.setRawMaterialInwardID(bean.getRawMaterialInwardID());
		model.setAssetTagToBeEncoded(bean.getAssetTagToBeEncoded());
		model.setSrNo(bean.getSrNo());
	model.setAssetUID(bean.getAssetUID());
		model.setTrade(bean.getTrade());
		model.setScanSpaceFloorName(bean.getScanSpaceFloorName());
		model.setTypeOfTags(bean.getTypeOfTags());

		if (bean.getSpaceFloorName() != null)
			model.setSpaceFloorName(bean.getSpaceFloorName());

		if (bean.getBinLocation() != null)
			model.setBinLocation(ItemLocationBean.prepareModel(bean.getBinLocation()));

		if (bean.getScanLocation() != null)
			model.setScanLocation(ItemLocationBean.prepareModel(bean.getScanLocation()));
		model.setTagID(bean.getTagID());
		model.setActive(bean.getActive());
		model.setVerifiedOnSite(bean.getVerifiedOnSite());
		model.setCreatedBy(bean.getCreatedBy());
		model.setCreatedOn(bean.getCreatedOn());
		model.setAssetName(bean.getAssetName());
		model.setDescription(bean.getDescription());
		model.setAmcDueDate(bean.getAmcDueDate());
		if (bean.getModifyBy() != null && bean.getModifyBy() > 0) {
			LoginModel loginModel = new LoginModel();
			loginModel.setLoginId(bean.getModifyBy());
			model.setModifyBy(loginModel);
		}
		model.setModifyOn(bean.getModifyOn());
		if (bean.getAssetCategory() != null)
			model.setAssetCategory(AssetCategoryBean.prepareModel(bean.getAssetCategory()));
		model.setParentLocationId(bean.getParentLocationId());
		return model;
	}

	public static RawMaterialInwardModelHistory prepareModelHistory(RawMaterialInwardBean bean) {
		RawMaterialInwardModelHistory model = new RawMaterialInwardModelHistory();

		if (bean.getBinLocation() != null)
			model.setBinLocation(ItemLocationBean.prepareModel(bean.getBinLocation()));

		if (bean.getScanLocation() != null)
			model.setScanLocation(ItemLocationBean.prepareModel(bean.getScanLocation()));
		model.setTagID(bean.getTagID());

		model.setActive(bean.getActive());
		model.setCreatedBy(bean.getCreatedBy());
		model.setCreatedOn(bean.getCreatedOn());
		if (bean.getModifyBy() != null && bean.getModifyBy() > 0) {
			LoginModel loginModel = new LoginModel();
			loginModel.setLoginId(bean.getModifyBy());
			model.setModifyBy(loginModel);
		}
		model.setModifyOn(bean.getModifyOn());
		if (bean.getAssetCategory() != null)
			model.setAssetCategory(AssetCategoryBean.prepareModel(bean.getAssetCategory()));
	
		return model;
	}

	public static RawMaterialInwardBean prepareBean(RawMaterialInwardModel model) {
		RawMaterialInwardBean bean = new RawMaterialInwardBean();
		if (model == null)
			return null;
		bean.setRawMaterialInwardID(model.getRawMaterialInwardID());

		bean.setAssetUID(model.getAssetUID());
		bean.setSrNo(model.getSrNo());
		bean.setAssetTagToBeEncoded(model.getAssetTagToBeEncoded());
		bean.setTrade(model.getTrade());
		bean.setScanSpaceFloorName(model.getScanSpaceFloorName());
		bean.setTypeOfTags(model.getTypeOfTags());
		

		if (model.getSpaceFloorName() != null)
			bean.setSpaceFloorName(model.getSpaceFloorName());

		if (model.getBinLocation() != null)
			bean.setBinLocation(ItemLocationBean.prepareBean(model.getBinLocation()));

		if (model.getScanLocation() != null)
			bean.setScanLocation(ItemLocationBean.prepareBean(model.getScanLocation()));

		bean.setTagID(model.getTagID());
		bean.setActive(model.getActive());
		bean.setVerifiedOnSite(model.getVerifiedOnSite());
		bean.setCreatedBy(model.getCreatedBy());
		bean.setCreatedOn(model.getCreatedOn());
		bean.setAssetName(model.getAssetName());
		bean.setDescription(model.getDescription());
		bean.setAmcDueDate(model.getAmcDueDate());
		if (model.getModifyBy() != null && model.getModifyBy().getLoginId() != null) {
			bean.setModifyBy(model.getModifyBy().getLoginId());
			bean.setUserName(model.getModifyBy().getUserName());
		}
		bean.setModifyOn(model.getModifyOn());
		if (model.getAssetCategory() != null)
			bean.setAssetCategory(AssetCategoryBean.prepareBean(model.getAssetCategory()));
		bean.setParentLocationId(model.getParentLocationId());

		return bean;
	}

	public static List<RawMaterialInwardBean> prepareListBean(List<RawMaterialInwardModel> listModel) {
		List<RawMaterialInwardBean> beans = null;
		if (listModel != null && !listModel.isEmpty()) {
			beans = new ArrayList<RawMaterialInwardBean>();
			for (RawMaterialInwardModel model : listModel) {
				beans.add(prepareBean(model));
			}
		}
		return beans;
	}

	public static List<RawMaterialInwardModel> prepareListModel(List<RawMaterialInwardBean> beans) {
		List<RawMaterialInwardModel> listModel = null;
		if (beans != null && !beans.isEmpty()) {
			listModel = new ArrayList<RawMaterialInwardModel>();
			for (RawMaterialInwardBean bean : beans) {
				listModel.add(prepareModel(bean));
			}
		}
		return listModel;
	}
}
