package com.ecartes.dao;

import java.util.List;

import org.hibernate.Criteria;
import org.hibernate.Session;
import org.hibernate.SessionFactory;
import org.hibernate.criterion.Restrictions;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Repository;

import com.ecartes.model.RoleMenuModel;

@Repository("roleMenuDAO")
public class RoleMenuDAOImpl implements RoleMenuDAO {
	@Autowired
	private SessionFactory sessionFactory;

	@Override
	public void addRoleMenu(RoleMenuModel roleMenu) {
		sessionFactory.getCurrentSession().saveOrUpdate(roleMenu);
	}

	@Override
	public List<RoleMenuModel> getListRoleMenu() {
		return (List<RoleMenuModel>) sessionFactory.getCurrentSession().createCriteria(RoleMenuModel.class).list();
	}

	@Override
	public RoleMenuModel getRoleMenu(Integer menuID) {
		return (RoleMenuModel) sessionFactory.getCurrentSession().get(RoleMenuModel.class, menuID);
	}

	@Override
	public void deleteRoleMenu(Integer menuID) {
		sessionFactory.getCurrentSession().createQuery("DELETE FROM RoleMenuModel WHERE menuID=" + menuID)
				.executeUpdate();
	}

	@Override
	public List<RoleMenuModel> getListRoleMenuType(int menuParentID) {

		Session session = sessionFactory.getCurrentSession();
		Criteria criteria = session.createCriteria(RoleMenuModel.class);
		criteria.add(Restrictions.isNull("menuParent.menuID"));
		return (List<RoleMenuModel>) criteria.list();

	}

	@Override
	public void deleteRoleMenuByRoleID(Integer roleId) {

		sessionFactory.getCurrentSession()
				.createQuery("DELETE FROM RoleMenuModel WHERE menuParentID>0 and roleId=" + roleId).executeUpdate();
	}

	@Override
	public List<RoleMenuModel> getMenuByUserRole(int roleID) {

		Session session = sessionFactory.getCurrentSession();
		Criteria criteria = session.createCriteria(RoleMenuModel.class);

		criteria.add(Restrictions.isNotNull("menuParent.menuID"));
		criteria.add(Restrictions.eq("roleId", roleID));

		return (List<RoleMenuModel>) criteria.list();
	}

}
