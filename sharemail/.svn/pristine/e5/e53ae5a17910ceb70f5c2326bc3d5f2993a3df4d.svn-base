	@Override
	public List<RawMaterialInwardModel> getListRawMaterialInwardByFilterAllTagHistory(
			RawMaterialInwardBean rawMaterialInwardBean) {

		SQLQuery qry;

		StringBuffer sb = new StringBuffer();
		sb.append(" select * from RawMaterialInwardHistory where  materialCodeNo=? ");

		qry = sessionFactory.getCurrentSession().createSQLQuery(sb.toString());
		int parameteIndex = 0;
		qry.setParameter(parameteIndex++, rawMaterialInwardBean.getAssetUID());

		qry.addEntity(RawMaterialInwardModel.class);

		List<RawMaterialInwardModel> list = (List<RawMaterialInwardModel>) qry.list();

		return list;

	}

	@Override
	public int getListMaterial(String type) {

		StringBuffer sb = new StringBuffer();
		if (type != null && type.equalsIgnoreCase("TotalAsset"))
			sb.append(" select count(*) from RawMaterialInward");
		else if (type != null && type.equalsIgnoreCase("TotalAssetReg"))
			sb.append("select count(*) from RawMaterialInward where len(tagID)>10 and active=1");
		else if (type != null && type.equalsIgnoreCase("TotalAssetNotReg"))
			sb.append("select count(*) from RawMaterialInward where tagID is null or len(tagID)<=0");
		else if (type != null && type.equalsIgnoreCase("TotalAssetInvetoryFound"))
			sb.append(
					"select count(rawMaterialInwardID) from ProcessTrackingFinal where trackingSessionId in(select top 1 trackingSessionId  from TrackingSession where active=1)");
		else if (type != null && type.equalsIgnoreCase("TotalAssetInvetoryNotFound"))
			sb.append(
					"select count(*) from RawMaterialInward where rawMaterialInwardID not in(select rawMaterialInwardID from ProcessTrackingFinal where trackingSessionId in(select top 1 trackingSessionId  from TrackingSession where active=1)) and tagID is not null");

		Session session = sessionFactory.getCurrentSession();
		SQLQuery query = session.createSQLQuery(sb.toString());

		Integer count = (Integer) query.uniqueResult();

		return count;

	}

	@Override
	public int getListMaterial(String type, Integer locationId) {

		StringBuffer sb = new StringBuffer();
		if (type != null && type.equalsIgnoreCase("TotalAsset"))
			sb.append("select count(*) from RawMaterialInward where parentLocationId =" + locationId);
		else if (type != null && type.equalsIgnoreCase("TotalAssetReg"))
			sb.append("select count(*) from RawMaterialInward where len(tagID)>10 and active=1 and parentLocationId ="
					+ locationId);
		else if (type != null && type.equalsIgnoreCase("TotalAssetNotReg"))
			sb.append(
					"select count(*) from RawMaterialInward where tagID is null or len(tagID)<=0 and parentLocationId ="
							+ locationId);

		else if (type != null && type.equalsIgnoreCase("TotalAssetInvetoryFound"))
			sb.append(
					"select count(PTF.rawMaterialInwardID) from ProcessTrackingFinal PTF left outer join RawMaterialInward RMI on PTF.itemEpcId=rmi.tagID  where  RMI.parentLocationId="
							+ locationId
							+ " and trackingSessionId in(select top 1 trackingSessionId  from TrackingSession where active=1)");
		else if (type != null && type.equalsIgnoreCase("TotalAssetInvetoryNotFound"))
			sb.append("select count(*) from RawMaterialInward t1 where t1.parentLocationId= " + locationId
					+ " and rawMaterialInwardID not in(select PTF.rawMaterialInwardID from ProcessTrackingFinal PTF left outer join RawMaterialInward RMI on PTF.itemEpcId=rmi.tagID  where  RMI.parentLocationId="
					+ locationId
					+ " and trackingSessionId in(select top 1 trackingSessionId  from TrackingSession where active=1)) and tagID is not null ");

		Session session = sessionFactory.getCurrentSession();
		SQLQuery query = session.createSQLQuery(sb.toString());

		Integer count = (Integer) query.uniqueResult();

		return count;

	}
}
