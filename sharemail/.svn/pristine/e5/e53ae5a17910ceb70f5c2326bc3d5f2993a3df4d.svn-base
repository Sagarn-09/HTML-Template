	public void postData(BulkProcessHH bulkProcessHH) {
		try {
			Query query = null;

			String list[] = bulkProcessHH.getTagList().split(",");
			List<String> tagList = new ArrayList<String>();
			int count = 0;
			StringBuffer sb = null;
			for (int i = 0; list != null && i < list.length; i++) {
				if (count < 10) {
					if (sb == null) {
						sb = new StringBuffer();
						sb.append(list[i]);
					} else {
						sb.append("," + list[i]);
					}
					count++;
				}
				if (count == 10) {
					System.out.println("add in list" + sb.toString());
					tagList.add(sb.toString());
					sb = null;
					count = 0;
				}
			}
			if (count > 0 && count < 10) {
				tagList.add(sb.toString());
				sb = null;
			}
			for (int i = 0; tagList != null && i < tagList.size(); i++) {
				Session session = sessionFactory.getCurrentSession();
				StringBuffer sb1 = new StringBuffer();
				sb1.append(" {call dbo.spTrackingProcess (?,?,?,?,?,?,?,?,?,?,?,? ) } ");
				query = session.createSQLQuery(sb1.toString());
				query.setString(0, bulkProcessHH.getProcessName());
				query.setInteger(1, bulkProcessHH.getCreatedBy());

				query.setTimestamp(2, new Date(bulkProcessHH.getProcessTimeLog()));
				query.setBoolean(3, bulkProcessHH.getActive());
				query.setString(4, bulkProcessHH.getDeviceSerialNo());
				query.setString(5, tagList.get(i));
				query.setString(6, bulkProcessHH.getOperationStatus());
				query.setString(7, bulkProcessHH.getRemark());
				query.setString(8, bulkProcessHH.getStoreName());
				query.setString(9, bulkProcessHH.getIoStatus());
				query.setString(10, bulkProcessHH.getToStore());
				query.setInteger(11, bulkProcessHH.getScanLocationID());
				query.executeUpdate();
				Thread.sleep(300);
			}
		} catch (Exception e) {

			e.printStackTrace();
		}

	}

	@Override
	public List<ProcessTrackingFinalModel> getListProcessTrackingFinal(
			ProcessTrackingFinalBean processTrackingFinalBean) {

		Criteria criteria = sessionFactory.getCurrentSession().createCriteria(ProcessTrackingFinalModel.class,
				"details");
		criteria.createAlias("details.rawMaterialInward", "rawMaterialInward");

		boolean success = false;

		Date maxDate = null;
		if (processTrackingFinalBean.getToDate() != null)
			maxDate = Common.getEndDate(processTrackingFinalBean.getToDate());
		if (processTrackingFinalBean.getActive()) {
			criteria.add(Restrictions.eq("active", processTrackingFinalBean.getActive()));
			success = true;
		}
		if (processTrackingFinalBean.getFromDate() != null && maxDate != null) {
			criteria.add(Restrictions.between("createdOn", processTrackingFinalBean.getFromDate(), maxDate));
			success = true;
		}
		if (processTrackingFinalBean.getOperation() != null && processTrackingFinalBean.getOperation().length() > 1) {

			criteria.add(Restrictions.eq("status", processTrackingFinalBean.getOperation()));
			success = true;
		}

		if (processTrackingFinalBean.getCallingPage() != null
				&& processTrackingFinalBean.getCallingPage().length() > 1) {

			criteria.add(Restrictions.eq("operationStatus", processTrackingFinalBean.getCallingPage()));

			success = true;
		}

		if (processTrackingFinalBean.getTrackingSessionBean() != null
				&& processTrackingFinalBean.getTrackingSessionBean().getTrackingSessionId() != null
				&& processTrackingFinalBean.getTrackingSessionBean().getTrackingSessionId() > 0) {
			success = true;
			criteria.add(Restrictions.eq("trackingSession.trackingSessionId",
					processTrackingFinalBean.getTrackingSessionBean().getTrackingSessionId()));

			if (processTrackingFinalBean.getCallingPage() == null
					|| processTrackingFinalBean.getCallingPage().length() < 1) {

				criteria.add(Restrictions.ne("operationStatus", "Inventory"));

				success = true;
			}
		}

		if (processTrackingFinalBean != null && processTrackingFinalBean.getItemLocationId() != null

				&& processTrackingFinalBean.getItemLocationId() > 0) {
			criteria.createAlias("rawMaterialInward.scanLocation", "scanLocation");
			criteria.add(Restrictions.or(
					Restrictions.eq("scanLocation.itemLocationId", processTrackingFinalBean.getItemLocationId()),
					Restrictions.eq("rawMaterialInward.parentLocationId",
							processTrackingFinalBean.getItemLocationId())));
		}

		if (processTrackingFinalBean != null && processTrackingFinalBean.getScanFloorName() != null
				&& processTrackingFinalBean.getScanFloorName() > 0) {
			criteria.add(Restrictions.eq("scanLocation.itemLocationId", processTrackingFinalBean.getScanFloorName()));
		}

		if (processTrackingFinalBean != null && processTrackingFinalBean.getScanSpaceName() != null
				&& processTrackingFinalBean.getScanSpaceName().length() > 0) {

			criteria.add(Restrictions.eq("rawMaterialInward.scanSpaceFloorName",
					processTrackingFinalBean.getScanSpaceName()));
		}

		if (success)
			return (List<ProcessTrackingFinalModel>) criteria.list();

		return null;
	}

	@Override
	public List<ProcessTrackingFinalModel> getListTrackingByAssetID(ProcessTrackingFinalBean processTrackingFinalBean) {

		Criteria criteria = sessionFactory.getCurrentSession().createCriteria(ProcessTrackingFinalModel.class,
				"details");
		criteria.createAlias("details.rawMaterialInward", "rawMaterialInward");
		boolean success = false;

		Date maxDate = null;
		if (processTrackingFinalBean.getToDate() != null)
			maxDate = Common.getEndDate(processTrackingFinalBean.getToDate());
		if (processTrackingFinalBean.getActive()) {
			criteria.add(Restrictions.eq("active", processTrackingFinalBean.getActive()));
			success = true;

		}
		if (processTrackingFinalBean.getFromDate() != null && maxDate != null) {
			criteria.add(Restrictions.between("createdOn", processTrackingFinalBean.getFromDate(), maxDate));
			success = true;
		}

		if (processTrackingFinalBean.getCallingPage() != null
				&& processTrackingFinalBean.getCallingPage().length() > 1) {

			criteria.add(Restrictions.eq("rawMaterialInward.assetUID", processTrackingFinalBean.getCallingPage()));

			success = true;
		}

		if (success)
			return (List<ProcessTrackingFinalModel>) criteria.list();

		return null;
	}

	@Override
	public List<RawMaterialInwardModel> getListInventoryNotFound(int trackingSessionId) {

		SQLQuery qry;

		StringBuffer sb = new StringBuffer();
		sb.append(
				" select * from RawMaterialInward where active=1 and rawMaterialInwardID not in(select distinct rawMaterialInwardID from ProcessTrackingFinal where trackingSessionId =?) ");

		qry = sessionFactory.getCurrentSession().createSQLQuery(sb.toString());
		int parameteIndex = 0;
		qry.setParameter(parameteIndex++, trackingSessionId);

		qry.addEntity(RawMaterialInwardModel.class);

		List<RawMaterialInwardModel> list = (List<RawMaterialInwardModel>) qry.list();

		return list;

	}

	@Override
	public Long getCount(RawMaterialInwardBean rawMaterialInwardBean) {
		Criteria criteria = sessionFactory.getCurrentSession().createCriteria(RawMaterialInwardModel.class);
		Date maxDate = null;
		if (rawMaterialInwardBean != null && rawMaterialInwardBean.getToDate() != null)
			maxDate = Common.getEndDate(rawMaterialInwardBean.getToDate());
		if (rawMaterialInwardBean != null && rawMaterialInwardBean.getFromDate() != null && maxDate != null) {
			criteria.add(Restrictions.between("modifyOn", rawMaterialInwardBean.getFromDate(), maxDate));
		}
		if (rawMaterialInwardBean.getMessage() != null && rawMaterialInwardBean.getMessage().equalsIgnoreCase("0"))
			criteria.add(Restrictions.eq("active", false));
		else if (rawMaterialInwardBean.getMessage() != null && rawMaterialInwardBean.getMessage().equalsIgnoreCase("1"))
			criteria.add(Restrictions.eq("active", true));
		if (rawMaterialInwardBean != null && rawMaterialInwardBean.getOperation() != null
				&& rawMaterialInwardBean.getOperation().length() > 1 && rawMaterialInwardBean.getCallingPage() != null
				&& rawMaterialInwardBean.getCallingPage().length() > 0) {

			criteria.add(Restrictions.like(rawMaterialInwardBean.getOperation(),
					rawMaterialInwardBean.getCallingPage().replaceAll("'", "''"), MatchMode.ANYWHERE));
		}
		criteria.setProjection(Projections.rowCount());
		Long count = (Long) criteria.uniqueResult();

		return count;
	}
	
	@Override
	public List<RawMaterialInwardModel> getListMaterialSeriveExpired(RawMaterialInwardBean rawMaterialInwardBean)
	{
		Criteria criteria =sessionFactory.getCurrentSession().createCriteria(RawMaterialInwardModel.class); 

		criteria.add(Restrictions.le("amcDueDate", new Date()));
		
		criteria.add(Restrictions.eq("active",true));
		
		if(rawMaterialInwardBean!=null && rawMaterialInwardBean.getOperation()!=null && rawMaterialInwardBean.getOperation().length()>1 &&  rawMaterialInwardBean.getCallingPage()!=null &&  rawMaterialInwardBean.getCallingPage().length()>0)
		{
			
			criteria.add(Restrictions.like(rawMaterialInwardBean.getOperation(), rawMaterialInwardBean.getCallingPage().replaceAll("'", "''"),MatchMode.ANYWHERE));	
		}
	 return criteria.list();
	}
	
	@Override
	public List<RawMaterialInwardModel> getListMaterialSeriveUpcoming(RawMaterialInwardBean rawMaterialInwardBean)
	{
		Criteria criteria =sessionFactory.getCurrentSession().createCriteria(RawMaterialInwardModel.class); 
		Date maxDate=null;
		if(rawMaterialInwardBean!=null && rawMaterialInwardBean.getToDate()!=null)
		maxDate=Common.getEndDate(rawMaterialInwardBean.getToDate());
			Calendar calendar = Calendar.getInstance();
			calendar.add(Calendar.MONTH, 1);       
	        Date newDate = calendar.getTime();
			criteria.add(Restrictions.le("amcDueDate", newDate));
			criteria.add(Restrictions.gt("amcDueDate", new Date()));
		
		criteria.add(Restrictions.eq("active",true));
		
		if(rawMaterialInwardBean!=null && rawMaterialInwardBean.getOperation()!=null && rawMaterialInwardBean.getOperation().length()>1 &&  rawMaterialInwardBean.getCallingPage()!=null &&  rawMaterialInwardBean.getCallingPage().length()>0)
		{
			
			criteria.add(Restrictions.like(rawMaterialInwardBean.getOperation(), rawMaterialInwardBean.getCallingPage().replaceAll("'", "''"),MatchMode.ANYWHERE));	
		}
	 return criteria.list();
	}

	@Override
	public List<RawMaterialInwardModel> getListRawMaterialInwardByFilter(RawMaterialInwardBean rawMaterialInwardBean) {

		Criteria criteria = sessionFactory.getCurrentSession().createCriteria(RawMaterialInwardModel.class, "details");

		Date maxDate = null;
		if (rawMaterialInwardBean != null && rawMaterialInwardBean.getToDate() != null)
			maxDate = Common.getEndDate(rawMaterialInwardBean.getToDate());

		if (rawMaterialInwardBean != null && rawMaterialInwardBean.getFromDate() != null && maxDate != null) {

			criteria.add(Restrictions.between("modifyOn", rawMaterialInwardBean.getFromDate(), maxDate));
		}

		if (rawMaterialInwardBean.getMessage() != null && rawMaterialInwardBean.getMessage().equalsIgnoreCase("0"))
			criteria.add(Restrictions.eq("active", false));
		else if (rawMaterialInwardBean.getMessage() != null && rawMaterialInwardBean.getMessage().equalsIgnoreCase("1"))
			criteria.add(Restrictions.eq("active", true));

		if (rawMaterialInwardBean != null && rawMaterialInwardBean.getOperation() != null
				&& rawMaterialInwardBean.getOperation().length() > 1 && rawMaterialInwardBean.getCallingPage() != null
				&& rawMaterialInwardBean.getCallingPage().length() > 0) {
			criteria.add(Restrictions.like(rawMaterialInwardBean.getOperation(),
					rawMaterialInwardBean.getCallingPage().replaceAll("'", "''"), MatchMode.ANYWHERE));
		}

		if (rawMaterialInwardBean != null && rawMaterialInwardBean.getAssetCategory() != null
				&& rawMaterialInwardBean.getAssetCategory().getAssetCategoryId() != null
				&& rawMaterialInwardBean.getAssetCategory().getAssetCategoryId() > 0) {
			criteria.createAlias("details.assetCategory", "assetCategory");
			criteria.add(Restrictions.or(
					Restrictions.eq("assetCategory.assetCategoryId",
							rawMaterialInwardBean.getAssetCategory().getAssetCategoryId()),
					Restrictions.eq("assetCategory.assetCategory.assetCategoryId",
							rawMaterialInwardBean.getAssetCategory().getAssetCategoryId())));
		}

		if (rawMaterialInwardBean != null && rawMaterialInwardBean.getBinLocation() != null
				&& rawMaterialInwardBean.getBinLocation().getItemLocationId() != null
				&& rawMaterialInwardBean.getBinLocation().getItemLocationId() > 0) {
			criteria.createAlias("details.scanLocation", "scanLocation");
			criteria.add(Restrictions.or(
					Restrictions.eq("scanLocation.itemLocationParent.itemLocationId",
							rawMaterialInwardBean.getBinLocation().getItemLocationId()),
					Restrictions.eq("parentLocationId", rawMaterialInwardBean.getParentLocationId())));
		}

		if (rawMaterialInwardBean != null && rawMaterialInwardBean.getScanLocation() != null
				&& rawMaterialInwardBean.getScanLocation().getItemLocationId() != null
				&& rawMaterialInwardBean.getScanLocation().getItemLocationId() > 0) {
			criteria.add(Restrictions.eq("scanLocation.itemLocationId",
					rawMaterialInwardBean.getScanLocation().getItemLocationId()));
		}

		if (rawMaterialInwardBean != null && rawMaterialInwardBean.getScanSpaceFloorName() != null
				&& rawMaterialInwardBean.getScanSpaceFloorName().length() > 0) {
			criteria.add(Restrictions.eq("scanSpaceFloorName", rawMaterialInwardBean.getScanSpaceFloorName()));
		}

		criteria.setFirstResult(rawMaterialInwardBean.getRawMaterialInwardID() - 1);
		criteria.setMaxResults(100);
		return criteria.list();
	}

