	@Override
	public void addRawMaterialInward(RawMaterialInwardModel rawMaterialInward) {
		sessionFactory.getCurrentSession().saveOrUpdate(rawMaterialInward);
	}

	public void updateMaterial(RawMaterialInwardModel rawMaterialInward) {

		Query q = sessionFactory.getCurrentSession().createQuery(
				"update RawMaterialInwardModel set assetCategory.assetCategoryId=:assetCategoryId, modifyOn=:modifyOn,assetTagToBeEncoded=:assetTagToBeEncoded,trade=:trade,typeOfTags=:typeOfTags where rawMaterialInwardID=:rawMaterialInwardID");

		if (rawMaterialInward.getAssetCategory() != null) {
			q.setParameter("assetCategoryId", rawMaterialInward.getAssetCategory().getAssetCategoryId());
		} else
			q.setParameter("assetCategoryId", null);

		q.setParameter("modifyOn", new Date());
		q.setParameter("assetTagToBeEncoded", rawMaterialInward.getAssetTagToBeEncoded());
		q.setParameter("trade", rawMaterialInward.getTrade());
		q.setParameter("typeOfTags", rawMaterialInward.getTypeOfTags());
		q.setParameter("rawMaterialInwardID", rawMaterialInward.getRawMaterialInwardID());

		int status = q.executeUpdate();
		System.out.println(
				"update status" + status + ", RawMaterialInwardID=" + rawMaterialInward.getRawMaterialInwardID());

	}

