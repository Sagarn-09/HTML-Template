package com.ecartes.service;
import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Propagation;
import org.springframework.transaction.annotation.Transactional;

import com.ecartes.dao.RoleTypeDAO;
import com.ecartes.model.RoleTypeModel;
@Service("roleTypeService")
@Transactional(propagation = Propagation.SUPPORTS, readOnly = true)
public class RoleTypeServiceImpl implements RoleTypeService 
{
@Autowired
private RoleTypeDAO roleTypeDao;
@Transactional(propagation = Propagation.REQUIRED, readOnly = false)
public void addRoleType(RoleTypeModel roleType)
{
roleTypeDao.addRoleType(roleType);
}
@Override
public List<RoleTypeModel> getListRoleType()
{

return roleTypeDao.getListRoleType();
}

@Override
public RoleTypeModel  getRoleType(Integer roleId)
{
return roleTypeDao.getRoleType( roleId);
}

@Override
public void deleteRoleType(Integer roleId)
{
roleTypeDao.deleteRoleType( roleId);
}

}

