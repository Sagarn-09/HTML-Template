	SimpleDateFormat dateFormat = new SimpleDateFormat("dd-MM-yyyy");

	@Autowired
	RawMaterialInwardService rawMaterialInwardService;

	@Autowired
	AssetCategoryService assetCategoryService;

	@Autowired
	ItemLocationService itemLocationService;

	@Autowired
	ItemLocationSpaceService itemLocationSpaceService;

	@Autowired
	RawMaterialValidator rawMaterialValidator;

	@ModelAttribute
	public void addingCommonObject(Model model, HttpServletRequest request) {
		model.addAttribute("assetCategoryList",
				AssetCategoryBean.prepareListBean(assetCategoryService.getListAssetCategoryOnly()));

		model.addAttribute("binLocationList",
				ItemLocationBean.prepareListBean(itemLocationService.getListItemLocationAll()));

		model.addAttribute("binLocationSpaceList",
				ItemLocationSpaceBean.prepareListBean(itemLocationSpaceService.getListItemLocationSpace()));

		model.addAttribute("buildingLocationList",
				ItemLocationBean.prepareListBean(itemLocationService.getListItemLocationParent()));

	}

	@InitBinder
	public void InitBinder(WebDataBinder binder) {

		binder.addValidators(rawMaterialValidator);
		binder.registerCustomEditor(Date.class, "fromDate", new CustomDateEditor(dateFormat, true));
		binder.registerCustomEditor(Date.class, "toDate", new CustomDateEditor(dateFormat, true));
		binder.registerCustomEditor(Date.class, "poDate", new CustomDateEditor(dateFormat, true));
		binder.registerCustomEditor(Date.class, "expiryDate", new CustomDateEditor(dateFormat, true));

	}

	@RequestMapping(value = "/addRawMaterialInward", method = RequestMethod.GET)
	public ModelAndView addRawMaterialInward(@ModelAttribute("command") RawMaterialInwardBean rawMaterialInwardBean,
			BindingResult result, HttpServletRequest request) {
		ModelAndView modelAndView = new ModelAndView("pages/rawMaterialInward/addrawMaterialInward");
		rawMaterialInwardBean.setActive(true);
		modelAndView.addObject("rawMaterialInwardBean", rawMaterialInwardBean);
		return modelAndView;

	}

	@RequestMapping(value = "/saveRawMaterialInward", method = RequestMethod.POST)
	public ModelAndView saveItemLocation(
			@ModelAttribute("command") @Validated RawMaterialInwardBean rawMaterialInwardBean, BindingResult result,
			HttpServletRequest request) {
		ModelAndView modelAndView = null;

		if (result.hasErrors()) {
			modelAndView = new ModelAndView("pages/rawMaterialInward/addrawMaterialInward");
			return modelAndView;
		} else {

			try {

				LoginBean loginUser = (LoginBean) request.getSession().getAttribute("LOGGEDIN_USER");
				modelAndView = new ModelAndView("pages/rawMaterialInward/displayrawMaterialInward");
				rawMaterialInwardBean.setCreatedOn(new java.util.Date());
				rawMaterialInwardBean.setModifyOn(new java.util.Date());
				rawMaterialInwardBean.setCreatedBy(loginUser.getLoginId());
				rawMaterialInwardBean.setModifyBy(loginUser.getLoginId());

				// rawMaterialInwardBean.setParentLocationId(rawMaterialInwardBean.getBinLocation().getItemLocationId());

				RawMaterialInwardModel model = RawMaterialInwardBean.prepareModel(rawMaterialInwardBean);

				RawMaterialInwardModel rawMaterial = null;
				if ((rawMaterialInwardBean.getRawMaterialInwardID() == null
						|| rawMaterialInwardBean.getRawMaterialInwardID() <= 0)
						&& (rawMaterialInwardBean.getAssetAccessories() == null
								|| rawMaterialInwardBean.getAssetAccessories().getRawMaterialInwardID() == null
								|| rawMaterialInwardBean.getAssetAccessories().getRawMaterialInwardID() <= 0)) {
					rawMaterial = rawMaterialInwardService.getRawMaterialInwardByMaterialCode(model.getAssetUID());
					if (rawMaterial != null) {
						modelAndView = new ModelAndView("pages/rawMaterialInward/addrawMaterialInward");
						modelAndView.addObject("rawMaterialInwardBean", rawMaterialInwardBean);
						ObjectError objectError = new ObjectError("message", "Material code No already exit!");
						result.addError(objectError);
						return modelAndView;
					}
				}

				if (rawMaterial == null && rawMaterialInwardBean.getTagID() != null
						&& rawMaterialInwardBean.getTagID().length() > 0) {
					rawMaterial = rawMaterialInwardService.getRawMaterialInward(model.getTagID());
					if (rawMaterial != null && !rawMaterial.getAssetUID().equalsIgnoreCase(model.getAssetUID())) {
						if (rawMaterial.getRawMaterialInwardID() > 0
								&& (model.getRawMaterialInwardID() == null || model.getRawMaterialInwardID() <= 0)) {
							modelAndView = new ModelAndView("pages/rawMaterialInward/addrawMaterialInward");
							modelAndView.addObject("rawMaterialInwardBean", rawMaterialInwardBean);
							ObjectError objectError = new ObjectError("message",
									"Tag ID already registered with material code no " + rawMaterial.getAssetUID());
							result.addError(objectError);
							return modelAndView;
						} else if (rawMaterial.getRawMaterialInwardID() > 0 && model.getRawMaterialInwardID() != null
								&& !rawMaterial.getRawMaterialInwardID().equals(model.getRawMaterialInwardID())) {
							modelAndView = new ModelAndView("pages/rawMaterialInward/addrawMaterialInward");
							modelAndView.addObject("rawMaterialInwardBean", rawMaterialInwardBean);
							ObjectError objectError = new ObjectError("message",
									"Tag ID already registered with material code no " + rawMaterial.getAssetUID());
							result.addError(objectError);
							return modelAndView;
						} else {

							rawMaterial = null;
						}

					} else {
						rawMaterial = null;
					}
				}

				if (rawMaterial == null) {
					RawMaterialInwardBean bean = null;
					if (rawMaterialInwardBean != null && rawMaterialInwardBean.getRawMaterialInwardID() != null
							&& rawMaterialInwardBean.getRawMaterialInwardID() > 0) {
						bean = RawMaterialInwardBean.prepareBean(rawMaterialInwardService
								.getRawMaterialInward(rawMaterialInwardBean.getRawMaterialInwardID()));
					}

					if ((rawMaterialInwardBean != null && rawMaterialInwardBean.getRawMaterialInwardID() == null
							&& rawMaterialInwardBean.getTagID().length() > 0)
							|| (bean != null && (bean.getActive() == null || !bean.getActive())
									&& (bean.getTagID() == null || bean.getTagID().length() <= 0))) {

						rawMaterialInwardService.addRawMaterialInward(model);
						RawMaterialInwardModelHistory modelHistory = RawMaterialInwardBean
								.prepareModelHistory(RawMaterialInwardBean.prepareBean(model));
						rawMaterialInwardService.addRawMaterialInwardHistory(modelHistory);
					} else {
						rawMaterialInwardService.addRawMaterialInward(model);
						RawMaterialInwardModelHistory modelHistory = RawMaterialInwardBean
								.prepareModelHistory(RawMaterialInwardBean.prepareBean(model));
						rawMaterialInwardService.addRawMaterialInwardHistory(modelHistory);
					}
				}

				List<RawMaterialInwardBean> list = new ArrayList<RawMaterialInwardBean>();
				list.add(RawMaterialInwardBean.prepareBean(model));
				modelAndView.addObject("rawMaterialInwardList", list);
				modelAndView.addObject("rawMaterialInwardBean", rawMaterialInwardBean);
			} catch (Exception e) {
				e.printStackTrace();
			}
			return modelAndView;

		}
	}

	@RequestMapping(value = "/displayRawMaterialInward", method = { RequestMethod.GET, RequestMethod.POST })
	public ModelAndView displayRawMaterialInward(@ModelAttribute("command") RawMaterialInwardBean rawMaterialInwardBean,
			BindingResult result, HttpServletRequest request) {
		ModelAndView modelAndView = null;
		if (result.hasErrors()) {
			modelAndView = new ModelAndView("pages/rawMaterialInward/displayrawMaterialInward");
			return modelAndView;
		} else {

			List<RawMaterialInwardBean> list = null;
			modelAndView = new ModelAndView("pages/rawMaterialInward/displayrawMaterialInward");

			if (rawMaterialInwardBean.getRawMaterialInwardID() == null
					|| rawMaterialInwardBean.getRawMaterialInwardID() <= 0) {
				rawMaterialInwardBean.setRawMaterialInwardID(1); // set id for get next 100 record from that id
			}

			Long countRecord = rawMaterialInwardService.getCount(rawMaterialInwardBean);
			if (request.getMethod().equalsIgnoreCase("POST")) {

				list = RawMaterialInwardBean.prepareListBean(
						rawMaterialInwardService.getListRawMaterialInwardByFilter(rawMaterialInwardBean));
			}

			modelAndView.addObject("countRecord", countRecord);
			modelAndView.addObject("rawMaterialInwardList", list);

			rawMaterialInwardBean.setAssetCategory(null);
			rawMaterialInwardBean.setBinLocation(null);
			rawMaterialInwardBean.setSpaceFloorName(null);

			modelAndView.addObject("rawMaterialInwardBean", rawMaterialInwardBean);

			return modelAndView;
		}

	}

