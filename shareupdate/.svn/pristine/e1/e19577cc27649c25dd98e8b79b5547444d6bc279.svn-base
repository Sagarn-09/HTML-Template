	@RequestMapping(value = "/uploadMaterial", method = { RequestMethod.GET, RequestMethod.POST })
	public ModelAndView uploadServicePersonnelExcel(
			@ModelAttribute("command") RawMaterialInwardBean rawMaterialInwardBean, BindingResult result,
			HttpServletRequest request) throws ParseException {

		List<RawMaterialInwardModel> listUploadAsset = new ArrayList<RawMaterialInwardModel>();
		String path = Common.UploadExcelFiles;
		File f = new File(path);
		if (!f.isDirectory()) {
			f.mkdirs();
		}
		ModelAndView modelAndView = null;
		if (result.hasErrors()) {
			modelAndView = new ModelAndView("pages/rawMaterialInward/uploadFile");
			return modelAndView;
		} else {

			Integer totalDuplicateRecords = 0;
			String epcExcelDownload = "";
			LoginBean loginUser = (LoginBean) request.getSession().getAttribute("LOGGEDIN_USER");
			modelAndView = new ModelAndView("pages/rawMaterialInward/uploadFile");

			if (rawMaterialInwardBean.getMaterialExcelPath() != null)

				if (request.getMethod().equalsIgnoreCase("POST") && rawMaterialInwardBean.getMaterialExcelPath() != null
						&& rawMaterialInwardBean.getMaterialExcelPath().getOriginalFilename().length() > 0) {

					SimpleDateFormat sdf = new SimpleDateFormat("ddMMyyyy_hhmmss");
					String filename = sdf.format(new Date()) + "_"
							+ rawMaterialInwardBean.getMaterialExcelPath().getOriginalFilename();

					String extension = FilenameUtils.getExtension(filename);

					if (extension.equalsIgnoreCase("xlsx")) {
						byte[] bytes = rawMaterialInwardBean.getMaterialExcelPath().getBytes();
						upload(bytes, new File(path + File.separator + filename));

						try {
							ReadWriteExcelFile.parentList.clear();
							ReadWriteExcelFile.childList.clear();
							List<RawMaterialInwardModel> list = ReadWriteExcelFile
									.readXLSFileMaterialFileTIFR(path + File.separator + filename);
							// ReadWriteExcelFile.getRecordsByParentChild(list);

							if (list != null && list.size() > 0) {

								for (RawMaterialInwardModel key : list) {
									RawMaterialInwardBean rawMaterialInwar = RawMaterialInwardBean.prepareBean(key);
									Thread.sleep(60);
									if (loginUser != null) {
										rawMaterialInwar.setCreatedBy(loginUser.getLoginId());
										rawMaterialInwar.setModifyBy(loginUser.getLoginId());
									}
									rawMaterialInwar.setCreatedOn(new Date());
									rawMaterialInwar.setModifyOn(new Date());
									rawMaterialInwar.setActive(true);

//									rawMaterialInwar.setOperation("assetUID");
//									rawMaterialInwar.setCallingPage(rawMaterialInwar.getAssetUID());
									rawMaterialInwar.setOperation("srNo");
                   					rawMaterialInwar.setCallingPage(rawMaterialInwar.getSrNo());
									AssetCategoryModel assetCategoryParentModel = null;
									if (key.getAssetCategory() != null
											&& key.getAssetCategory().getAssetCategory() != null) {
										assetCategoryParentModel = assetCategoryService
												.getAssetCategoryByName(AssetCategoryBean
														.prepareBean(key.getAssetCategory().getAssetCategory()));
										if (assetCategoryParentModel == null
												|| assetCategoryParentModel.getAssetCategoryId() == null) {
											assetCategoryParentModel = key.getAssetCategory().getAssetCategory();
											assetCategoryService.addAssetCategory(assetCategoryParentModel);
										}
									}
									key.getAssetCategory().setAssetCategory(assetCategoryParentModel);
									rawMaterialInwar.setAssetCategory(AssetCategoryBean.prepareBean(key.getAssetCategory().getAssetCategory()));
									
									AssetCategoryModel assetCategoryModel = assetCategoryService
											.getAssetCategoryByName(AssetCategoryBean.prepareBean(key.getAssetCategory()));
									
									if (assetCategoryModel != null && assetCategoryModel.getAssetCategoryId() != null) {
										assetCategoryModel.setAssetCategory(assetCategoryParentModel);
										rawMaterialInwar.setAssetCategory(AssetCategoryBean.prepareBean(assetCategoryModel));
									} else {
										assetCategoryModel = key.getAssetCategory();
										//assetCategoryModel.setAssetCategory(assetCategoryParentModel);
										assetCategoryService.addAssetCategory(assetCategoryModel);
										rawMaterialInwar.setAssetCategory(AssetCategoryBean.prepareBean(assetCategoryModel));
										
									}
									key.setAssetCategory(
											AssetCategoryBean.prepareModel(rawMaterialInwar.getAssetCategory()));

									Thread.sleep(60);

									ItemLocationModel locationParentModel = null;
									if (key.getBinLocation() != null
											&& key.getBinLocation().getItemLocationParent() != null) {
										locationParentModel = itemLocationService.getLocationByName(ItemLocationBean
												.prepareBean(key.getBinLocation().getItemLocationParent()));
										if (locationParentModel == null
												|| locationParentModel.getItemLocationId() == null) {
											locationParentModel = key.getBinLocation().getItemLocationParent();
											itemLocationService.addItemLocation(locationParentModel);
											
										}
										
										
									}
									key.getBinLocation().setItemLocationParent(locationParentModel);
									ItemLocationModel locationModel = itemLocationService
											.getLocationByName(ItemLocationBean.prepareBean(key.getBinLocation()));

									if (locationModel != null && locationModel.getItemLocationId() != null) {
										locationModel.setItemLocationParent(locationParentModel);
										key.getBinLocation().setItemLocationParent(locationParentModel);
									} else {
										locationModel = key.getBinLocation();
										//locationModel.setItemLocationParent(locationParentModel);
										
										itemLocationService.addItemLocation(locationModel);
										//key.getBinLocation().setItemLocationParent(locationParentModel);
									}
									key.setBinLocation(locationModel);
									key.setScanLocation(locationModel);
									
									
									
									ItemLocationSpaceModel itemLocationSpace = null;

									// Check if the raw material column data exists in the ItemLocationSpace table
									if (key.getSpaceFloorName() != null) {
									    itemLocationSpace = itemLocationSpaceService
									            .getItemLocationSpaceName(key.getSpaceFloorName(),locationModel.getItemLocationId());

									    // If not found, create a new entry
									    if (itemLocationSpace == null) {
									        itemLocationSpace = new ItemLocationSpaceModel();
									        itemLocationSpace.setItemLocationSpaceName(key.getSpaceFloorName());
									        itemLocationSpace.setItemLocationFloor(locationModel);
									        // Save the new entry
									        itemLocationSpaceService.addItemLocationSpace(itemLocationSpace);
									    }
									}
									
									
									
									rawMaterialInwar.setBinLocation(ItemLocationBean.prepareBean(key.getBinLocation()));
									rawMaterialInwar.setScanLocation(rawMaterialInwar.getBinLocation());
									List<RawMaterialInwardModel> modelList = rawMaterialInwardService
											.getListRawMaterialInward(rawMaterialInwar);
									if (modelList != null && modelList.size() > 0) {
										rawMaterialInwar.setCreatedOn(modelList.get(0).getCreatedOn());
										rawMaterialInwar.setCreatedBy(modelList.get(0).getCreatedBy());
										rawMaterialInwar
												.setRawMaterialInwardID(modelList.get(0).getRawMaterialInwardID());
										rawMaterialInwar.setActive(true);

										RawMaterialInwardModel modelAsset = RawMaterialInwardBean
												.prepareModel(rawMaterialInwar);
										modelAsset.setScanLocation(modelList.get(0).getScanLocation());
										modelAsset.setBinLocation(modelList.get(0).getBinLocation());
										modelAsset.setSpaceFloorName(modelList.get(0).getSpaceFloorName());
										// rawMaterialInwardService.addRawMaterialInward(modelAsset);
										rawMaterialInwardService.updateMaterial(modelAsset);
										key.setActive(false);
										totalDuplicateRecords++;
										listUploadAsset.add(key);
									} else {
										
//										System.out.println("rawMaterialInwar.getAssetCategory().getAssetCategoryId()"+rawMaterialInwar.getAssetCategory().getAssetCategoryId() +" name"+rawMaterialInwar.getAssetCategory().getAssetCategoryName() );
//										System.out.println("rawMaterialInwar.getAssetCategory().getAssetCategory().getAssetCategoryId()"+rawMaterialInwar.getAssetCategory().getAssetCategory().getAssetCategoryId() +" name"+rawMaterialInwar.getAssetCategory().getAssetCategory().getAssetCategoryName() );
//										
//										
//										System.out.println("rawMaterialInwar.getBinLocation().getItemLocationId()"+rawMaterialInwar.getBinLocation().getItemLocationId() +" name"+rawMaterialInwar.getBinLocation().getItemLocationName() );
//										System.out.println("rawMaterialInwar.getBinLocation().getItemLocationParent().getItemLocationId()"+rawMaterialInwar.getBinLocation().getItemLocationParent().getItemLocationId() +" name"+rawMaterialInwar.getBinLocation().getItemLocationParent().getItemLocationName() );
//										
//										
//										System.out.println("rawMaterialInwar.getScanLocation().getItemLocationId()"+rawMaterialInwar.getScanLocation().getItemLocationId() +" name"+rawMaterialInwar.getScanLocation().getItemLocationName() );
//										System.out.println("rawMaterialInwar.getScanLocation().getItemLocationParent().getItemLocationId()"+rawMaterialInwar.getScanLocation().getItemLocationParent().getItemLocationId() +" name"+rawMaterialInwar.getScanLocation().getItemLocationParent().getItemLocationName() );
										
										RawMaterialInwardModel modelAsset = RawMaterialInwardBean
												.prepareModel(rawMaterialInwar);
										
										System.out.println("modelAsset.getModifyBy().getLoginId()"+modelAsset.getModifyBy().getLoginId() +" name"+modelAsset.getModifyBy().getUserName());
										
										
										rawMaterialInwardService.addRawMaterialInward(modelAsset);
										listUploadAsset.add(modelAsset);

									}
								}

							} else {
								System.out.println("No record found in  file ");
								ObjectError objectError = new ObjectError("message", "No record found in  file ");
								result.addError(objectError);
							}

						} catch (IOException e) {
							ObjectError objectError = new ObjectError("message", "Error" + e.getMessage());
							result.addError(objectError);
							e.printStackTrace();
						} catch (Exception e) {
							e.printStackTrace();
						}
					} else {
						System.out.println("file extention error end ");
						ObjectError objectError = new ObjectError("message",
								"Please upload the file with extension xlsx.");
						result.addError(objectError);
					}

				}
			System.out.println("Process end ");
			modelAndView.addObject("jobCardList", RawMaterialInwardBean.prepareListBean(listUploadAsset));
			modelAndView.addObject("totalDuplicateRecords", totalDuplicateRecords);
			modelAndView.addObject("rawMaterialInwardBean", rawMaterialInwardBean);
			modelAndView.addObject("epcExcelDownload", epcExcelDownload);

			return modelAndView;
		}
	}

	public void upload(byte[] bytes, File file) {
		try {
			BufferedOutputStream stream = new BufferedOutputStream(new FileOutputStream(file));
			stream.write(bytes);
			stream.flush();
			stream.close();
			System.out.println("upload file");
		} catch (Exception e) {
			e.printStackTrace();
		}

	}
	
	
	
	
