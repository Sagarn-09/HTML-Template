	@RequestMapping(value = "/displayMaterialAllMaterial", method = { RequestMethod.GET, RequestMethod.POST })
	public ModelAndView displayMaterialAllMaterial(
			@ModelAttribute("command") RawMaterialInwardBean rawMaterialInwardBean, BindingResult result,
			HttpServletRequest request) throws DocumentException {
		ModelAndView modelAndView = null;
		if (result.hasErrors()) {
			modelAndView = new ModelAndView("pages/rawMaterialInward/report_all_asset");
			return modelAndView;
		} else {
			String epcExcelDownload = null;
			String epcPDFDownload = null;
			List<RawMaterialInwardBean> list = null;
			modelAndView = new ModelAndView("pages/rawMaterialInward/report_all_asset");
			if (request.getMethod().equalsIgnoreCase("POST")) {

				list = RawMaterialInwardBean.prepareListBean(
						rawMaterialInwardService.getListRawMaterialInwardByFilterAll(rawMaterialInwardBean));

				epcExcelDownload = ReadWriteExcelFile.writeXLAllMaster(list, Common.DownloadExcelFiles,
						"All Material Report");

				PdfFile file = new PdfFile();

				epcPDFDownload = file.pdfData(list, Common.DownloadExcelFiles, "All Asset Master List");
			}
			modelAndView.addObject("rawMaterialInwardList", list);

			modelAndView.addObject("epcExcelDownload", epcExcelDownload);
			modelAndView.addObject("epcPDFDownload", epcPDFDownload);

			rawMaterialInwardBean.setAssetCategory(null);
			rawMaterialInwardBean.setBinLocation(null);
			rawMaterialInwardBean.setSpaceFloorName(null);

			modelAndView.addObject("rawMaterialInwardBean", rawMaterialInwardBean);
			return modelAndView;
		}
	}

