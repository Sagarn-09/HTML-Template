package com.ecartes.dao;

import java.util.List;

import org.hibernate.SQLQuery;
import org.hibernate.Session;
import org.hibernate.SessionFactory;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Repository;

import com.ecartes.model.TempLogModel;

@Repository("tempLogDAO")
public class TempLogDAOImpl implements TempLogDAO {
	@Autowired
	private SessionFactory sessionFactory;

	@Override
	public void addTempLog(TempLogModel tempLog) {
		sessionFactory.getCurrentSession().saveOrUpdate(tempLog);
	}

	@Override
	public List<TempLogModel> getListTempLog() {
		StringBuffer sb = new StringBuffer();
		sb.append(
				"select top 30 * from templog where convert(varchar,logTime,103)=convert(varchar,getDate(),103) order  by logTime desc");
		Session session = sessionFactory.getCurrentSession();
		SQLQuery query = session.createSQLQuery(sb.toString());

		query.addEntity(TempLogModel.class);
		return (List<TempLogModel>) query.list();
	}

	@Override
	public TempLogModel getTempLog(Integer logId) {
		return (TempLogModel) sessionFactory.getCurrentSession().get(TempLogModel.class, logId);
	}

	@Override
	public void deleteTempLog(Integer logId) {
		sessionFactory.getCurrentSession().createQuery("DELETE FROM templog WHERE logId=" + logId).executeUpdate();
	}
}
