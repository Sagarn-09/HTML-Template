
package com.ecartes.service;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Propagation;
import org.springframework.transaction.annotation.Transactional;

import com.ecartes.bean.ItemLocationBean;
import com.ecartes.dao.ItemLocationDAO;
import com.ecartes.model.ItemLocationModel;

@Service("itemLocationService")
@Transactional(propagation = Propagation.SUPPORTS, readOnly = true)
public class ItemLocationServiceImpl implements ItemLocationService {
	@Autowired
	private ItemLocationDAO itemLocationDao;

	@Transactional(propagation = Propagation.REQUIRED, readOnly = false)
	public void addItemLocation(ItemLocationModel itemLocation) {
		itemLocationDao.addItemLocation(itemLocation);
	}

	@Override
	public List<ItemLocationModel> getListItemLocationAll() {
		return itemLocationDao.getListItemLocationAll();
	}

	@Override
	public ItemLocationModel getItemLocation(Integer itemLocationId) {
		return itemLocationDao.getItemLocation(itemLocationId);
	}

	@Override
	public void deleteItemLocation(Integer itemLocationId) {
		itemLocationDao.deleteItemLocation(itemLocationId);
	}

	@Override
	public List<ItemLocationModel> getListItemLocation(Integer itemParentLocationId) {
		return itemLocationDao.getListItemLocation(itemParentLocationId);
	}

	@Override
	public List<ItemLocationModel> getListItemLocationParent() {
		return itemLocationDao.getListItemLocationParent();
	}

	@Override
	public ItemLocationModel getLocationByName(ItemLocationBean itemLocationBean) {
		return itemLocationDao.getLocationByName(itemLocationBean);
	}

	@Override
	public List<ItemLocationModel> getListItemLocationParent(int itemParentLocationId) {
		return itemLocationDao.getListItemLocationParent(itemParentLocationId);
	}

	@Override
	public ItemLocationModel getParentLocationByName(String itemLocationName) {
		return itemLocationDao.getParentLocationByName(itemLocationName);
	}

	@Override
	public List<ItemLocationModel> getListItemParent(Integer itemParentLocationId) {
		return itemLocationDao.getListItemParent(itemParentLocationId);
	}

	@Override
	public List<ItemLocationModel> getListBranch(ItemLocationModel model) {
		return itemLocationDao.getListBranch(model);
	}

	@Override
	public ItemLocationModel getLocationName(Integer itemLocationId) {
		return itemLocationDao.getLocationName(itemLocationId);
	}
	
	@Override
	public List<ItemLocationModel> getListItemLocationOnly(){
		return itemLocationDao.getListItemLocationOnly();
	}
	
	@Override
	public List<ItemLocationModel> getListLocationByFilter(ItemLocationBean itemLocationBean){
		return itemLocationDao.getListLocationByFilter(itemLocationBean);		
	}

}
