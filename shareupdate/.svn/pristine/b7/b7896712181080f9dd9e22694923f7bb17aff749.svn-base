	@RequestMapping(value = "/saveRoleType", method = RequestMethod.POST)
	public ModelAndView saveRoleType(@ModelAttribute("command") @Validated RoleTypeBean roleTypeBean,
			BindingResult result, HttpServletRequest request) {
		ModelAndView modelAndView = null;
		try {
			// Return early if there are validation errors
			if (result.hasErrors()) {
				modelAndView = new ModelAndView("pages/roleType/addroleType");
				return modelAndView;
			}

			// Fetch the logged-in user
			LoginBean loginUser = (LoginBean) request.getSession().getAttribute("LOGGEDIN_USER");
			modelAndView = new ModelAndView("pages/roleType/displayroleType");

			// Check if roleName is already in use
			if (roleTypeBean.getRoleName() != null && !roleTypeBean.getRoleName().isEmpty()) {
				RoleTypeModel existingRole = roleTypeService.getRoleTypeByRoleName(roleTypeBean.getRoleName());

				if (existingRole != null && (roleTypeBean.getRoleId() == null || roleTypeBean.getRoleId() <= 0)) {
					modelAndView = new ModelAndView("pages/roleType/addroleType");
					modelAndView.addObject("roleTypeBean", roleTypeBean);
					ObjectError error = new ObjectError("message", "Role Name Already Exists!");
					result.addError(error);
					return modelAndView;
				}
			}

			// Set timestamps and user information
			roleTypeBean.setCreatedOn(new Date());
			roleTypeBean.setModifyOn(new Date());
			roleTypeBean.setCreatedBy(loginUser.getLoginId());
			roleTypeBean.setModifyBy(loginUser.getLoginId());

			// Add or update the role
			roleTypeService.addRoleType(RoleTypeBean.prepareModel(roleTypeBean));

			// Determine success message
			String successMessage = (roleTypeBean.getRoleId() == null || roleTypeBean.getRoleId() <= 0)
					? "Record successfully inserted."
					: "Record successfully modified.";

			modelAndView.addObject("successMessage", successMessage);

			// Prepare the roleTypeList to display
			List<RoleTypeBean> list = new ArrayList<>();
			list.add(RoleTypeBean.prepareBean(RoleTypeBean.prepareModel(roleTypeBean)));
			modelAndView.addObject("roleTypeList", list);
			modelAndView.addObject("roleTypeBean", roleTypeBean);

		} catch (Exception e) {
			// Log the exception instead of using printStackTrace
			e.printStackTrace(); // Replace with logging framework
			modelAndView.addObject("error", "An error occurred while processing the request.");
		}
		return modelAndView;
	}

	@RequestMapping(value = "/displayRoleType", method = RequestMethod.GET)
	public ModelAndView displayRoleType(@ModelAttribute("command") RoleTypeBean roleTypeBean, BindingResult result,
			HttpServletRequest request) {
		ModelAndView modelAndView = null;
		if (result.hasErrors()) {
			modelAndView = new ModelAndView("pages/roleType/displayroleType");
			return modelAndView;
		} else {

			modelAndView = new ModelAndView("pages/roleType/displayroleType");
			modelAndView.addObject("roleTypeList", RoleTypeBean.prepareListBean(roleTypeService.getListRoleType()));
			modelAndView.addObject("roleTypeBean", roleTypeBean);
			return modelAndView;
		}

	}

