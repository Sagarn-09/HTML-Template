	@RequestMapping(value = "/editRoleType", method = RequestMethod.GET)
	public ModelAndView editRoleType(@ModelAttribute("command") RoleTypeBean roleTypeBean, BindingResult result,
			HttpServletRequest request) {
		ModelAndView modelAndView = new ModelAndView("pages/roleType/addroleType");

		// Validate the result
		if (result.hasErrors()) {
			return modelAndView;
		}

		RoleTypeModel roleTypeModel = roleTypeService.getRoleType(roleTypeBean.getRoleId());
		if (roleTypeModel != null) {
			RoleTypeBean preparedBean = RoleTypeBean.prepareBean(roleTypeModel);
			modelAndView.addObject("roleTypeBean", preparedBean);
		} else {
			modelAndView.addObject("error", "Role type not found.");
		}

		return modelAndView;
	}

}
