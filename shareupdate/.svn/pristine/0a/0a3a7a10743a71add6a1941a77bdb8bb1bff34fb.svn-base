	    public static String padWithZeros(String input, int desiredLength) {
	        int currentLength = input.length();
	        if (currentLength >= desiredLength) {
	            return input; 
	        }
	        
	        StringBuilder paddedString = new StringBuilder(input);
	        for (int i = currentLength; i < desiredLength; i++) {
	            paddedString.append('0');
	        }
	        
	        return paddedString.toString();
	    }
	
	
	
	
	
	
	
	
	//-------------------read excel sheet-----------------------

	public static void readExcelData(String searchValue) {
		
		System.out.println("searchValue " + searchValue);
		String filename = "C:\\RFID\\BDL\\SampleData.xlsx";

		File f = new File(filename);
		if (!f.exists()) {
			return;
		}

		File inputFile = new File(filename);

		try {
			if (Common1.sheet == null) {
				Common1.inputStream = new FileInputStream(inputFile);
				Common1.workbook = new XSSFWorkbook(Common1.inputStream);
				Common1.sheet = Common1.workbook.getSheetAt(0);
				Common1.rowsCount = Common1.sheet.getPhysicalNumberOfRows();
				Common1.formulaEvaluator = Common1.workbook.getCreationHelper().createFormulaEvaluator();
			}

			for (int r = 1; r < Common1.rowsCount; r++) {
				XSSFRow row = Common1.sheet.getRow(r);
				String value = getCellAsString(row, 1, Common1.formulaEvaluator);

				if (value.contains(searchValue)) {
					parseStringBuilder(row, Common1.formulaEvaluator, r);
					break;
				}
			}

		} catch (FileNotFoundException e) {
			System.out.println("readExcelData: FileNotFoundException. " + e.getMessage());
		} catch (IOException e) {
			System.out.println("readExcelData: Error reading inputstream. " + e.getMessage());
		}
	}

	public static String getCellAsString(Row row, int c, FormulaEvaluator formulaEvaluator) {
		String value = "";
		try {
			Cell cell = row.getCell(c);
			CellValue cellValue = formulaEvaluator.evaluate(cell);
			switch (cellValue.getCellType()) {
			case XSSFCell.CELL_TYPE_BOOLEAN:
				value = "" + cellValue.getBooleanValue();
				break;
			case XSSFCell.CELL_TYPE_NUMERIC:
				double numericValue = cellValue.getNumberValue();
				if (DateUtil.isCellDateFormatted(cell)) {
					double date = cellValue.getNumberValue();
					SimpleDateFormat formatter = new SimpleDateFormat("dd/MM/yyyy");
					value = formatter.format(DateUtil.getJavaDate(date));
				} else {
					value = "" + numericValue;
				}
				break;
			case XSSFCell.CELL_TYPE_STRING:
				value = "" + cellValue.getStringValue();
				break;
			}
		} catch (NullPointerException e) {
			System.out.println("getCellAsString: NullPointerException: " + e.getMessage());
			System.out.println("No record found!.");
		}
		return value;
	}

	static String userMemory;

	public static void parseStringBuilder(Row row, FormulaEvaluator formulaEvaluator, int r) {
		try {
			userMemory = String.valueOf(getCellAsString(row, 2, formulaEvaluator));
			System.out.println("userMemory"+userMemory);
		} catch (Exception e) {
			System.out.println("Error parsing data: " + e.getMessage());
		}
	}
	
	//--------------------generate EPC no------------------------
	
	
	
    static String hexString;
    
    public static String getEPC(String sscc) {

        String fixBinary = "00110001000010";
        String epcManager = sscc.substring(1, 11);//"8908024569";
        String serialNo = "0" + sscc.substring(11, sscc.length() - 1);
        String epcManagerBinary = padLeft(decimal2Binary(epcManager), 34);
        String serialNoBinary = padLeft(decimal2Binary(serialNo), 24);
        String fixRight = "000000000000000000000000";
        String ssccBinary = epcManagerBinary + serialNoBinary;
        ssccBinary = padLeft(ssccBinary, 58);

        String finalBinaryEPC = fixBinary + ssccBinary + fixRight;
        BigInteger decimalECP = new BigInteger(finalBinaryEPC, 2);
        hexString = decimalECP.toString(16).toUpperCase();
        hexString = padRight(hexString, 24);
//        tv_epc.setText(hexString);
        
        System.out.println("hexString:"+hexString);
        return hexString;
    }

    public static String decimal2Binary(String decimalString) {

        BigInteger decimal = new BigInteger(decimalString);
        String binaryString = decimal.toString(2);
        int paddingLength = 96 - binaryString.length();
        StringBuilder paddedBinary = new StringBuilder();
        for (int i = 0; i < paddingLength; i++) {
            paddedBinary.append('0');
        }
        paddedBinary.append(binaryString);
        return binaryString.toString();

    }

    public static String padRight(String s, int n) {
        return String.format("%-" + n + "s", s).replace(' ', '0');
    }

    public static String padLeft(String s, int n) {
        return String.format("%" + n + "s", s).replace(' ', '0');
    }
    
    //---------------update excel sheet-------------------
    
    public static void updateExcelData(String value, String hexString) {
    	
    	System.out.println("value:"+value);
    	System.out.println("hexString"+hexString);

    	try {
            for (int r = 1; r < Common1.rowsCount; r++) {
                XSSFRow row = Common1.sheet.getRow(r);
                String cellValue = getCellAsString(row, 1, Common1.formulaEvaluator);

                if (cellValue.contains(value)) {
                    XSSFCell cell = row.getCell(6); // Column 7 (index 6)
                    if (cell == null) {
                        cell = row.createCell(6);
                    }
                    cell.setCellValue(hexString);

                    FileOutputStream outputStream = new FileOutputStream("C:\\RFID\\BDL\\SampleData.xlsx");
                    Common1.workbook.write(outputStream);
                    outputStream.close();
                    System.out.println("Excel sheet updated successfully.");
                    break;
                }
            }
        } catch (IOException e) {
            System.out.println("updateExcelData: Error writing to Excel file. " + e.getMessage());
        }
    }
    
    

}
