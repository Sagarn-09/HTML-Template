package com.ecartes.bean;
import java.io.Serializable;
import java.util.ArrayList;
import java.util.Date;
import java.util.List;

import com.ecartes.common.Common;
import com.ecartes.model.TempLogModel;

public class TempLogBean implements Serializable
{
private static final long serialVersionUID = -723583058586873479L;
private Integer logId=null;
public Integer getLogId() {
	return logId;
}
public void setLogId(Integer logId) {
	this.logId = logId;
}

private RawMaterialInwardBean item=null;


public RawMaterialInwardBean getItem() {
	return item;
}
public void setItem(RawMaterialInwardBean item) {
	this.item = item;
}

private String isMovable=null;
public String getIsMovable() {
	return isMovable;
}
public void setIsMovable(String isMovable) {
	this.isMovable = isMovable;
}

private Date intime=null;
private Date logTime=null;
private Date outTime=null;
public Date getIntime() {
	return intime;
}
public void setIntime(Date intime) {
	this.intime = intime;
}
public Date getLogTime() {
	return logTime;
}
public void setLogTime(Date logTime) {
	this.logTime = logTime;
}
public Date getOutTime() {
	return outTime;
}
public void setOutTime(Date outTime) {
	this.outTime = outTime;
}
public String getLocationName() {
	return locationName;
}
public void setLocationName(String locationName) {
	this.locationName = locationName;
}


public Integer getStatus() {
	return status;
}
public void setStatus(Integer status) {
	this.status = status;
}

private String locationName=null;
private Integer status=null;

private String inTimeUtc =null;
private String outTimeUtc =null;
private String logTimeUtc =null;

public String getInTimeUtc() {
	return inTimeUtc;
}
public void setInTimeUtc(String inTimeUtc) {
	this.inTimeUtc = inTimeUtc;
}
public String getOutTimeUtc() {
	return outTimeUtc;
}
public void setOutTimeUtc(String outTimeUtc) {
	this.outTimeUtc = outTimeUtc;
}
public String getLogTimeUtc() {
	return logTimeUtc;
}
public void setLogTimeUtc(String logTimeUtc) {
	this.logTimeUtc = logTimeUtc;
}


private Boolean successFlag=null;
public Boolean getSuccessFlag()
{
 return successFlag;
}
public void  setSuccessFlag(Boolean successFlag)
{
 this.successFlag=successFlag;
}

private String message =null;
public String getMessage()
{
 return message;
}
public void  setMessage(String message)
{
 this.message=message;
}
private String callingPage =null;
public String getCallingPage()
{
 return callingPage;
}
public void  setCallingPage(String callingPage)
{
 this.callingPage=callingPage;
}

private String operation =null;
public String getOperation()
{
 return operation;
}
public void  setOperation(String operation)
{
 this.operation=operation;
}
private Boolean active=false;

public Boolean getActive() {
	return active;
}
public void setActive(Boolean active) {
	this.active = active;
}
public static TempLogModel prepareModel(TempLogBean bean)
{
TempLogModel model=new TempLogModel();
model.setLogId(bean.getLogId());
if(bean.getItem()!=null)
{
	model.setItem(RawMaterialInwardBean.prepareModel(bean.getItem()));
}
model.setLogTime(bean.getLogTime());
model.setIntime(bean.getIntime());
model.setOutTime(bean.getOutTime());
model.setStatus(bean.getStatus());
model.setLocationName(bean.getLocationName());

if(bean.getInTimeUtc()!=null && !bean.getInTimeUtc().equalsIgnoreCase("null"))
	model.setIntime(Common.getDateFromUtcFormat(bean.getInTimeUtc()));

if(bean.getOutTimeUtc()!=null && !bean.getOutTimeUtc().equalsIgnoreCase("null"))
	model.setOutTime(Common.getDateFromUtcFormat(bean.getOutTimeUtc()));

if(bean.getLogTimeUtc()!=null && !bean.getLogTimeUtc().equalsIgnoreCase("null"))
	model.setLogTime(Common.getDateFromUtcFormat(bean.getLogTimeUtc()));

model.setActive(bean.getActive());
return model;
}

public static TempLogBean prepareBean(TempLogModel model)
{
TempLogBean bean=new TempLogBean();
bean.setLogId(model.getLogId());
if(model.getItem()!=null)
{
	bean.setItem(RawMaterialInwardBean.prepareBean(model.getItem()));
}
bean.setLogId(model.getLogId());
bean.setIntime(model.getIntime());
bean.setOutTime(model.getOutTime());
bean.setLogTime(model.getLogTime());
bean.setLocationName(model.getLocationName());
bean.setStatus(model.getStatus());

if(model.getIntime()!=null)
	bean.setInTimeUtc(Common.getUtcFormat(model.getIntime()));

if(model.getOutTime()!=null)
	bean.setOutTimeUtc(Common.getUtcFormat(model.getOutTime()));

if(model.getLogTime()!=null)
	bean.setLogTimeUtc(Common.getUtcFormat(model.getLogTime()));
bean.setActive(model.getActive());
return bean;
}

public static List<TempLogBean> prepareListBean(List<TempLogModel> listModel)
{
List<TempLogBean> beans=null;
if(listModel!=null && !listModel.isEmpty())
{
beans=new ArrayList<TempLogBean>();
for(TempLogModel model : listModel)
{
beans.add(prepareBean(model));
}
}
return beans;
}
public static List<TempLogModel> prepareListModel(List<TempLogBean> beans)
{
List<TempLogModel> listModel=null;
if(beans!=null && !beans.isEmpty())
{
listModel=new ArrayList<TempLogModel>();
for(TempLogBean bean : beans)
{
listModel.add(prepareModel(bean));
}
}
return listModel;
}
}
