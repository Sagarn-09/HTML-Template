package com.ecartes.common;

import java.io.File;
import java.util.ArrayList;
import java.util.Date;
import java.util.List;

import com.ecartes.bean.FilesBean;

public class DisplayFiles {
	public void printFileNames(File[] a, int i, int lvl) {

		if (i == a.length) {
			return;
		}
// checking if the encountered object is a file or not  
		if (a[i].isFile()) {
			System.out.println(a[i].getName());
		}
// recursively printing files from the directory  
// i + 1 means look for the next file  
		printFileNames(a, i + 1, lvl);
	}

// Main Method  
	public static List<FilesBean> getFiles() {
		List<FilesBean> list = new ArrayList<FilesBean>();
		try {
			String path = Common.DownloadExcelFiles;
			File fObj = new File(path);
			if (fObj.exists() && fObj.isDirectory()) {
				File fileList[] = fObj.listFiles();
				for (int i = 0; fileList != null && i < fileList.length; i++) {
					if (fileList[i].length() > 0 && fileList[i].isFile()) {
						FilesBean filesBean = new FilesBean();
						filesBean.setFileName(fileList[i].getName());
						filesBean.setFileDate(new Date(fileList[i].lastModified()));
						list.add(filesBean);

					}
				}
			}
		} catch (Exception e) {
			e.printStackTrace();
		}

		return list;
	}
}