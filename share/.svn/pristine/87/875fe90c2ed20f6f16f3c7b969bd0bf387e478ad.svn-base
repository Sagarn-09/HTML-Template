	@RequestMapping(value = "/rawMaterialRegister", method = RequestMethod.POST, consumes = MediaType.APPLICATION_JSON_VALUE, produces = MediaType.APPLICATION_JSON_VALUE)
	@ResponseBody
	public String rawMaterialRegister(HttpEntity<String> httpEntity) {
		System.out.println("json1rawMaterialInward call");
		String json1 = httpEntity.getBody();
		System.out.println("json1rawMaterialInward" + json1);

		String json = "";
		ObjectMapper objectMapper = new ObjectMapper();

		try {
			RawMaterialInwardBean rawMaterialInwardBean = objectMapper.readValue(json1, RawMaterialInwardBean.class);		
			// Check for duplicate Tag ID
			RawMaterialInwardModel existingMaterial = rawMaterialInwardService
					.getRawMaterialInward(rawMaterialInwardBean.getTagID());
			if (existingMaterial != null && (rawMaterialInwardBean.getCallingPage().equalsIgnoreCase("Registration") || rawMaterialInwardBean.getCallingPage().equalsIgnoreCase("RegistrationNew")) ) {
				// Duplicate Tag ID case
				rawMaterialInwardBean.setMessage("Tag ID already registered");
				rawMaterialInwardBean.setAssetCategory(null);
				rawMaterialInwardBean.setBinLocation(null);
				rawMaterialInwardBean.setScanLocation(null);
				rawMaterialInwardBean.setSuccessFlag(true);
				
				System.out.println("Tag ID already registered"+rawMaterialInwardBean.getTagID());
			}else if (existingMaterial != null && (rawMaterialInwardBean.getCallingPage().equalsIgnoreCase("RegistrationUpdate") ) ) {
				// Duplicate Tag ID case
				rawMaterialInwardBean.setMessage("Tag ID update successfully");
				ItemLocationBean locationModel=new ItemLocationBean();
				locationModel.setItemLocationId(rawMaterialInwardBean.getParentLocationId());
				rawMaterialInwardBean.setBinLocation(locationModel);
					AssetCategoryModel assetCategory = new AssetCategoryModel();
					assetCategory.setAssetCategoryId(rawMaterialInwardBean.getAssetCategoryId());				
					RawMaterialInwardModel rawMaterialModel = RawMaterialInwardBean.prepareModel(rawMaterialInwardBean);
					rawMaterialModel.setAssetCategory(assetCategory); 
					rawMaterialInwardService.addRawMaterialInward(rawMaterialModel);
					rawMaterialInwardBean.setMessage("Data saved successfully!");
					rawMaterialInwardBean.setSuccessFlag(true);
					rawMaterialInwardBean.setBinLocation(null);
					rawMaterialInwardBean.setScanLocation(null);
				
				System.out.println("Tag ID update successfully"+rawMaterialInwardBean.getTagID());
			} 
			else {
			
				ItemLocationBean locationModel=new ItemLocationBean();
				locationModel.setItemLocationId(rawMaterialInwardBean.getParentLocationId());
				rawMaterialInwardBean.setBinLocation(locationModel);
					AssetCategoryModel assetCategory = new AssetCategoryModel();
					assetCategory.setAssetCategoryId(rawMaterialInwardBean.getAssetCategoryId());				
					RawMaterialInwardModel rawMaterialModel = RawMaterialInwardBean.prepareModel(rawMaterialInwardBean);
					rawMaterialModel.setAssetCategory(assetCategory); 
					rawMaterialInwardService.addRawMaterialInward(rawMaterialModel);
					rawMaterialInwardBean.setMessage("Data saved successfully!");
					rawMaterialInwardBean.setSuccessFlag(true);
					rawMaterialInwardBean.setBinLocation(null);
					rawMaterialInwardBean.setScanLocation(null);
				}

			json = objectMapper.writeValueAsString(rawMaterialInwardBean);

		} catch (Exception e) {
			e.printStackTrace();

			// Handle errors and return a meaningful response
			RawMaterialInwardBean errorResponse = new RawMaterialInwardBean();
			errorResponse.setMessage("An error occurred while processing the request.");
			errorResponse.setSuccessFlag(false);

			// Prepare error response JSON
			try {
				json = objectMapper.writeValueAsString(errorResponse);
			} catch (Exception jsonException) {
				jsonException.printStackTrace();
				json = "{\"message\": \"An error occurred while processing the error response\", \"successFlag\": false}";
			}
		}

		System.out.println("Response JSON: " + json);
		return json;
	}
	
