		return list;
	}

	@RequestMapping(value = "/login", method = RequestMethod.POST, consumes = MediaType.APPLICATION_JSON_VALUE, produces = MediaType.APPLICATION_JSON_VALUE)
	@ResponseBody
	public String loginHH(HttpEntity<String> httpEntity) {
		System.out.println("loginHH");
		String json1 = httpEntity.getBody();
		JSONObject jsonObject = null;
		String json = "";
		JSONParser parser = new JSONParser();
		try {
			System.out.println("json1" + json1);
			jsonObject = (JSONObject) parser.parse(json1);
			String uId = "";
			String password = "";
			String parentLocationId = null;
			String createdOnUtc = "";

			if (jsonObject.containsKey("userLoginId") && jsonObject.containsKey("password")
					&& jsonObject.containsKey("locationId")) {

				uId = (String) jsonObject.get("userLoginId");
				password = (String) jsonObject.get("password");
				parentLocationId = (String) jsonObject.get("locationId");
				if (jsonObject.containsKey("createdOnUtc"))
					createdOnUtc = (String) jsonObject.get("createdOnUtc");
				LoginBean login = LoginBean.prepareBean(loginService.getLogin(uId, password));
				ObjectMapper objectMapper = new ObjectMapper();

				try {
					RawMaterialInwardBean rawMaterialInwardBean = new RawMaterialInwardBean();
					if (createdOnUtc != null && createdOnUtc.length() > 0) {
						rawMaterialInwardBean.setFromDate(new Date(Long.valueOf(createdOnUtc)));
					}

					rawMaterialInwardBean.setParentLocationId(Integer.valueOf(parentLocationId));

					List<RawMaterialInwardBean> list = RawMaterialInwardBean.prepareListBean(
							rawMaterialInwardService.getListRawMaterialInwardActiveIncremental(rawMaterialInwardBean));
					for(int i=0;list!=null && i<list.size();i++)
					{
						list.get(i).setScanLocation(null);
						if(list.get(i).getAssetCategory()!=null)
						{
					
							list.get(i).setAssetCategoryId(list.get(i).getAssetCategory().getAssetCategoryId());
					
							list.get(i).setAssetCategory(null);
				
						}
					}
					MaterailBeanList materailBeanList = new MaterailBeanList();

					materailBeanList.setLocationBeanList(
							ItemLocationBean.prepareListBean(itemLocationService.getListItemLocationAll()));

					materailBeanList.setAssetCategoryBeanList(
							AssetCategoryBean.prepareListBean(assetCategoryService.getListAssetCategory()));

					materailBeanList.setLocationSpaceBeanList(
							ItemLocationSpaceBean.prepareListBean(itemLocationSpaceService.getListItemLocationSpace()));

					materailBeanList.setMaterailBeanList(list);
					json = objectMapper.writeValueAsString(materailBeanList);
					login.setMessage(json);
					login.setCreatedOnUtc("" + System.currentTimeMillis());
				} catch (Exception e) {
					e.printStackTrace();
				}

				json = objectMapper.writeValueAsString(login);
				System.out.println("json" + json);
			}

		} catch (ParseException e) {

			e.printStackTrace();
		} catch (Exception e) {
			e.printStackTrace();
		}
		return json;
	}

	@RequestMapping(value = "/operationData", method = RequestMethod.POST, consumes = MediaType.APPLICATION_JSON_VALUE, produces = MediaType.APPLICATION_JSON_VALUE)
	@ResponseBody
	public String operationData(HttpEntity<String> httpEntity) {
		System.out.println("operationData");
		String json1 = httpEntity.getBody();
		String json = "";

		try {

			ObjectMapper objectMapper = new ObjectMapper();
			System.out.println("json1  operationData" + json1);

			BulkProcessHH bulkProcessHH = objectMapper.readValue(json1, BulkProcessHH.class);

			rawMaterialInwardService.postData(bulkProcessHH);
			bulkProcessHH.setTagList("");
			bulkProcessHH.setProcessName("Successfully uploded");
			json = objectMapper.writeValueAsString(bulkProcessHH);
			System.out.println("Post Data" + json);

		} catch (Exception e) {
			e.printStackTrace();
		}
		return json;
	}

	@RequestMapping(value = "/rawMaterialData", method = RequestMethod.POST, consumes = MediaType.APPLICATION_JSON_VALUE, produces = MediaType.APPLICATION_JSON_VALUE)
	@ResponseBody
	public String rawMaterialData(HttpEntity<String> httpEntity) {

		String json1 = httpEntity.getBody();
		String json = "";
		ObjectMapper objectMapper = new ObjectMapper();

		try {
			RawMaterialInwardBean rawMaterialInwardBean = objectMapper.readValue(json1, RawMaterialInwardBean.class);

			String operation = rawMaterialInwardBean.getOperation();
			String callingPage = rawMaterialInwardBean.getCallingPage();
			if (operation != null && operation.equalsIgnoreCase("Upload") && callingPage.equalsIgnoreCase("new")) {
				RawMaterialInwardBean rawMaterialInwardBeanCheck = RawMaterialInwardBean
						.prepareBean(rawMaterialInwardService.getRawMaterialInward(rawMaterialInwardBean.getTagID()));
				if (rawMaterialInwardBeanCheck == null || !rawMaterialInwardBeanCheck.getActive()) {
					RawMaterialInwardModel rawMaterial = rawMaterialInwardService
							.getRawMaterialInwardByMaterialCode(rawMaterialInwardBean.getAssetUID());
					if (rawMaterial == null) {

						RawMaterialInwardModel model = RawMaterialInwardBean.prepareModel(rawMaterialInwardBean);
						rawMaterialInwardService.addRawMaterialInward(model);
						rawMaterialInwardBean = RawMaterialInwardBean.prepareBean(model);
						rawMaterialInwardBean.setSuccessFlag(true);
						rawMaterialInwardBean.setOperation(operation);
						rawMaterialInwardBean.setCallingPage(callingPage);
						rawMaterialInwardBean.setMessage("Data uploaded successfully!");
						json = objectMapper.writeValueAsString(rawMaterialInwardBean);
					} else {
						rawMaterialInwardBean.setMessage("Material Code Already Exit!");
						rawMaterialInwardBean.setSuccessFlag(false);
						rawMaterialInwardBean.setOperation(operation);
						rawMaterialInwardBean.setCallingPage(callingPage);
						json = objectMapper.writeValueAsString(rawMaterialInwardBean);
					}
				} else {
					System.out.println("Tag already in use");
					rawMaterialInwardBean.setMessage("Tag already in use");
					rawMaterialInwardBean.setSuccessFlag(false);
					rawMaterialInwardBean.setOperation(operation);
					rawMaterialInwardBean.setCallingPage(callingPage);
					json = objectMapper.writeValueAsString(rawMaterialInwardBean);
				}

			} else if (operation != null && operation.equalsIgnoreCase("Upload")
					&& callingPage.equalsIgnoreCase("old")) {
				RawMaterialInwardModel model = rawMaterialInwardService
						.getRawMaterialInward(rawMaterialInwardBean.getTagID());
				if (model != null) {
					LoginModel loginMode = new LoginModel();
					loginMode.setLoginId(rawMaterialInwardBean.getCreatedBy());
					model.setModifyBy(loginMode);
					model.setModifyOn(rawMaterialInwardBean.getModifyOn());
					rawMaterialInwardService.addRawMaterialInward(model);
					rawMaterialInwardBean = RawMaterialInwardBean.prepareBean(model);
					rawMaterialInwardBean.setOperation(operation);
					rawMaterialInwardBean.setCallingPage(callingPage);
					rawMaterialInwardBean.setSuccessFlag(true);
					rawMaterialInwardBean.setMessage("Data uploaded successfully!");
					json = objectMapper.writeValueAsString(rawMaterialInwardBean);

				} else {
					rawMaterialInwardBean = new RawMaterialInwardBean();
					rawMaterialInwardBean.setOperation(operation);
					rawMaterialInwardBean.setCallingPage(callingPage);
					rawMaterialInwardBean.setSuccessFlag(false);
					rawMaterialInwardBean.setMessage("Data not uploaded!");
					json = objectMapper.writeValueAsString(rawMaterialInwardBean);
				}
			} else if (operation != null && operation.equalsIgnoreCase("Upload")
					&& callingPage.equalsIgnoreCase("outward")) {
				RawMaterialInwardModel model = rawMaterialInwardService
						.getRawMaterialInward(rawMaterialInwardBean.getTagID());
				if (model != null) {

					LoginModel loginMode = new LoginModel();
					loginMode.setLoginId(rawMaterialInwardBean.getCreatedBy());
					model.setModifyBy(loginMode);
					model.setModifyOn(rawMaterialInwardBean.getModifyOn());
					rawMaterialInwardService.addRawMaterialInward(model);
					rawMaterialInwardBean = RawMaterialInwardBean.prepareBean(model);
					rawMaterialInwardBean.setOperation(operation);
					rawMaterialInwardBean.setCallingPage(callingPage);
					rawMaterialInwardBean.setSuccessFlag(true);
					rawMaterialInwardBean.setMessage("Data uploaded successfully!");
					json = objectMapper.writeValueAsString(rawMaterialInwardBean);

				} else {
					rawMaterialInwardBean = new RawMaterialInwardBean();
					rawMaterialInwardBean.setOperation(operation);
					rawMaterialInwardBean.setCallingPage(callingPage);
					rawMaterialInwardBean.setSuccessFlag(false);
					rawMaterialInwardBean.setMessage("Data not uploaded!");
					json = objectMapper.writeValueAsString(rawMaterialInwardBean);
				}
			} else if (operation != null && operation.equalsIgnoreCase("Upload")
					&& callingPage.equalsIgnoreCase("Registration")) {
				System.out.println("getRawMaterialInwardID" + rawMaterialInwardBean.getRawMaterialInwardID());
				RawMaterialInwardModel model = rawMaterialInwardService
						.getRawMaterialInward(rawMaterialInwardBean.getRawMaterialInwardID());
				if (model != null) {

					LoginModel loginMode = new LoginModel();
					loginMode.setLoginId(rawMaterialInwardBean.getCreatedBy());
					model.setModifyBy(loginMode);
					model.setTagID(rawMaterialInwardBean.getTagID());
					model.setModifyOn(rawMaterialInwardBean.getModifyOn());
//					 model.setRegistrationDate(new Date());
					model.setActive(true);
					rawMaterialInwardService.addRawMaterialInward(model);
					rawMaterialInwardBean = RawMaterialInwardBean.prepareBean(model);
					rawMaterialInwardBean.setOperation(operation);
					rawMaterialInwardBean.setCallingPage(callingPage);
					rawMaterialInwardBean.setSuccessFlag(true);
					rawMaterialInwardBean.setAssetCategory(null);
					rawMaterialInwardBean.setMessage("Data uploaded successfully!");
					json = objectMapper.writeValueAsString(rawMaterialInwardBean);

					RawMaterialInwardModelHistory modelHistory = RawMaterialInwardBean
							.prepareModelHistory(RawMaterialInwardBean.prepareBean(model));

					rawMaterialInwardService.addRawMaterialInwardHistory(modelHistory);
					System.out.println("Post Data Old Raw Material");
				} else {
					rawMaterialInwardBean = new RawMaterialInwardBean();
					rawMaterialInwardBean.setOperation(operation);
					rawMaterialInwardBean.setCallingPage(callingPage);
					rawMaterialInwardBean.setSuccessFlag(false);
					rawMaterialInwardBean.setMessage("Data not uploaded!");
					json = objectMapper.writeValueAsString(rawMaterialInwardBean);
				}
			} else if (operation != null && operation.equalsIgnoreCase("Download")) {
				rawMaterialInwardBean = RawMaterialInwardBean
						.prepareBean(rawMaterialInwardService.getRawMaterialInward(rawMaterialInwardBean.getTagID()));
				if (rawMaterialInwardBean != null) {
					rawMaterialInwardBean.setOperation(operation);
					rawMaterialInwardBean.setCallingPage(callingPage);
					rawMaterialInwardBean.setSuccessFlag(true);
					rawMaterialInwardBean.setMessage("Data downloded successfully!");
					json = objectMapper.writeValueAsString(rawMaterialInwardBean);

				} else {
					rawMaterialInwardBean = new RawMaterialInwardBean();
					rawMaterialInwardBean.setOperation(operation);
					rawMaterialInwardBean.setCallingPage(callingPage);
					rawMaterialInwardBean.setSuccessFlag(false);
					rawMaterialInwardBean.setMessage("Data not availabled for scaned EPC!");
					json = objectMapper.writeValueAsString(rawMaterialInwardBean);
					System.out.println("Download Data not available scaned EPC" + json);
				}
			}

		} catch (Exception e) {

			e.printStackTrace();
		}
		System.out.println("json" + json);
		return json;
	}

	
	
	
