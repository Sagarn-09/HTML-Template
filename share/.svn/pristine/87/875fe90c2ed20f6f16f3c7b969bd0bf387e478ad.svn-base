	@RequestMapping(value = "/getspaceNameList", method = RequestMethod.GET)
	@ResponseStatus(org.springframework.http.HttpStatus.OK)
	public @ResponseBody List<ItemLocationSpaceBean> getItemLocationSpaceBean(
			@RequestParam(value = "locationID", required = true) String locationID) {

		List<ItemLocationSpaceBean> list = null;

		try {
			list = ItemLocationSpaceBean.prepareListBean(itemLocationSpaceService.getListItemLocationSpace(locationID));
		} catch (Exception e) {
			e.printStackTrace();
		}
		return list;
	}

