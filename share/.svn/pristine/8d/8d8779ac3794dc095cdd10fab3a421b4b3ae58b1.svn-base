<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:jsp="http://java.sun.com/xml/ns/javaee/jsp"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
	id="WebApp_ID" version="3.0">
	<display-name>NIMS</display-name>
	<servlet>
		<servlet-name>spring</servlet-name>
		<servlet-class>org.springframework.web.servlet.DispatcherServlet</servlet-class>
		<init-param>
			<param-name>contextConfigLocation</param-name>
			<param-value>/WEB-INF/config/spring-servlet.xml</param-value>
		</init-param>
		<load-on-startup>1</load-on-startup>
	</servlet>
	<listener>
		<listener-class>org.springframework.web.context.ContextLoaderListener</listener-class>
	</listener>
	<context-param>
		<param-name>contextConfigLocation</param-name>
		<param-value>/WEB-INF/config/spring-servlet.xml</param-value>
	</context-param>
	<servlet-mapping>
		<servlet-name>spring</servlet-name>
		<url-pattern>*.do</url-pattern>
	</servlet-mapping>
	<!-- Spring Security <filter> <filter-name>springSecurityFilterChain</filter-name> 
		<filter-class>org.springframework.web.filter.DelegatingFilterProxy </filter-class> 
		</filter> <filter-mapping> <filter-name>springSecurityFilterChain</filter-name> 
		<url-pattern>*.do</url-pattern> </filter-mapping> -->
	<welcome-file-list>
		<welcome-file>login.do</welcome-file>
	</welcome-file-list>
	<error-page>
		<error-code>403</error-code>
		<location>/resource/403.jsp</location>
	</error-page>
	<error-page>
		<error-code>404</error-code>
		<location>/resource/404.jsp</location>
	</error-page>
	<error-page>
		<error-code>500</error-code>
		<location>/resource/500.jsp</location>
	</error-page>
	<env-entry>
		<env-entry-name>IPADDRESS</env-entry-name>
		<env-entry-type>java.lang.String</env-entry-type>
		<env-entry-value>192.168.1.254</env-entry-value>
	</env-entry>
	<env-entry>
		<env-entry-name>PORT</env-entry-name>
		<env-entry-type>java.lang.String</env-entry-type>
		<env-entry-value>27001</env-entry-value>
	</env-entry>
	<env-entry>
		<env-entry-name>RfidUpload</env-entry-name>
		<env-entry-type>java.lang.String</env-entry-type>
		<env-entry-value>C:/RFID/</env-entry-value>
	</env-entry>
	<env-entry>
		<env-entry-name>PdfFiles</env-entry-name>
		<env-entry-type>java.lang.String</env-entry-type>
		<env-entry-value>C:/RFID/PDF</env-entry-value>
	</env-entry>
	<env-entry>
		<env-entry-name>toEmail</env-entry-name>
		<env-entry-type>java.lang.String</env-entry-type>
		<env-entry-value>navyaravi1806@gmail.com</env-entry-value>
	</env-entry>
	<env-entry>
		<env-entry-name>ExcelFiles</env-entry-name>
		<env-entry-type>java.lang.String</env-entry-type>
		<env-entry-value>C:/RFID/ExcelFiles</env-entry-value>
	</env-entry>
	<env-entry>
		<env-entry-name>CSVFiles</env-entry-name>
		<env-entry-type>java.lang.String</env-entry-type>
		<env-entry-value>C:/RFID/CSVFiles</env-entry-value>
	</env-entry>
	<env-entry>
		<env-entry-name>insuranceAlertDays</env-entry-name>
		<env-entry-type>java.lang.String</env-entry-type>
		<env-entry-value>7</env-entry-value>
	</env-entry>
	<env-entry>
		<env-entry-name>UploadExcelFiles</env-entry-name>
		<env-entry-type>java.lang.String</env-entry-type>
		<env-entry-value>C:/RFID/UPLOADEXCEL</env-entry-value>
	</env-entry>
	<env-entry>
		<env-entry-name>DownloadExcelFiles</env-entry-name>
		<env-entry-type>java.lang.String</env-entry-type>
		<env-entry-value>C:\\RFID\\DOWNLOADEXCEL\\</env-entry-value>
	</env-entry>
	<env-entry>
		<env-entry-name>DownloadExcelFilesEpc</env-entry-name>
		<env-entry-type>java.lang.String</env-entry-type>
		<env-entry-value>C:\\RFID\\DOWNLOADEXCELEPC\\</env-entry-value>
	</env-entry>
	<env-entry>
		<env-entry-name>ReaderUrL</env-entry-name>
		<env-entry-type>java.lang.String</env-entry-type>
		<env-entry-value>http://localhost:8085/api/getEPC</env-entry-value>
	</env-entry>
	<jsp-config>
		<taglib>
			<taglib-uri>http://www.owasp.org/index.php/Category:OWASP_Enterprise_Security_API</taglib-uri>
			<taglib-location>/WEB-INF/tld/esapi.tld</taglib-location>
		</taglib>
	</jsp-config>
</web-app>