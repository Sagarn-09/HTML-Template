package com.ecartes.bean;

import java.io.Serializable;
import java.util.ArrayList;
import java.util.Date;
import java.util.List;

import com.ecartes.model.AssetCategoryModel;

public class AssetCategoryBean implements Serializable {
	private static final long serialVersionUID = -723583058586873479L;
	private Integer assetCategoryId = null;

	public Integer getAssetCategoryId() {
		return assetCategoryId;
	}

	public void setAssetCategoryId(Integer assetCategoryId) {
		this.assetCategoryId = assetCategoryId;
	}

	private String assetCategoryName = null;

	public String getAssetCategoryName() {
		return assetCategoryName;
	}

	public void setAssetCategoryName(String assetCategoryName) {
		this.assetCategoryName = assetCategoryName;
	}

	private String description = null;

	public String getDescription() {
		return description;
	}

	public void setDescription(String description) {
		this.description = description;
	}

	private Integer createdBy = 0;

	public Integer getCreatedBy() {
		return createdBy;
	}

	public void setCreatedBy(Integer createdBy) {
		this.createdBy = createdBy;
	}

	private Date createdOn = null;

	public Date getCreatedOn() {
		return createdOn;
	}

	public void setCreatedOn(Date createdOn) {
		this.createdOn = createdOn;
	}

	private Integer modifyBy = 0;

	public Integer getModifyBy() {
		return modifyBy;
	}

	public void setModifyBy(Integer modifyBy) {
		this.modifyBy = modifyBy;
	}

	private Date modifyOn = null;

	public Date getModifyOn() {
		return modifyOn;
	}

	public void setModifyOn(Date modifyOn) {
		this.modifyOn = modifyOn;
	}

	private Boolean active = false;

	public Boolean getActive() {
		return active;
	}

	public void setActive(Boolean active) {
		this.active = active;
	}

	private AssetCategoryBean assetCategory;

	public AssetCategoryBean getAssetCategory() {
		return assetCategory;
	}

	public void setAssetCategory(AssetCategoryBean assetCategory) {
		this.assetCategory = assetCategory;
	}

	public static AssetCategoryModel prepareModel(AssetCategoryBean bean) {
		AssetCategoryModel model = new AssetCategoryModel();
		model.setAssetCategoryId(bean.getAssetCategoryId());
		model.setAssetCategoryName(bean.getAssetCategoryName());
		model.setDescription(bean.getDescription());
		model.setCreatedBy(bean.getCreatedBy());
		model.setCreatedOn(bean.getCreatedOn());
		model.setModifyBy(bean.getModifyBy());
		model.setModifyOn(bean.getModifyOn());
		model.setActive(bean.getActive());
		if (bean.getAssetCategory() != null && bean.getAssetCategory().getAssetCategoryId() != null)
			model.setAssetCategory(AssetCategoryBean.prepareModel(bean.getAssetCategory()));
		return model;
	}

	public static AssetCategoryBean prepareBean(AssetCategoryModel model) {
		if (model == null)
			return null;
		AssetCategoryBean bean = new AssetCategoryBean();
		bean.setAssetCategoryId(model.getAssetCategoryId());
		bean.setAssetCategoryName(model.getAssetCategoryName());
		bean.setDescription(model.getDescription());
		bean.setCreatedBy(model.getCreatedBy());
		bean.setCreatedOn(model.getCreatedOn());
		bean.setModifyBy(model.getModifyBy());
		bean.setModifyOn(model.getModifyOn());
		bean.setActive(model.getActive());
		if (model.getAssetCategory() != null && model.getAssetCategory().getAssetCategoryId() != null)
			bean.setAssetCategory(AssetCategoryBean.prepareBean(model.getAssetCategory()));
		return bean;
	}

	public static List<AssetCategoryBean> prepareListBean(List<AssetCategoryModel> listModel) {
		List<AssetCategoryBean> beans = null;
		if (listModel != null && !listModel.isEmpty()) {
			beans = new ArrayList<AssetCategoryBean>();
			for (AssetCategoryModel model : listModel) {
				beans.add(prepareBean(model));
			}
		}
		return beans;
	}

	public static List<AssetCategoryModel> prepareListModel(List<AssetCategoryBean> beans) {
		List<AssetCategoryModel> listModel = null;
		if (beans != null && !beans.isEmpty()) {
			listModel = new ArrayList<AssetCategoryModel>();
			for (AssetCategoryBean bean : beans) {
				listModel.add(prepareModel(bean));
			}
		}
		return listModel;
	}

}
