//if(bean.getModifyOnUtc()!=null)
//	model.setModifyOn(Common.getDateFromUtcFormat(bean.getModifyOnUtc()));
return model;
}


public static RoleTypeBean prepareBean(RoleTypeModel model)
{
RoleTypeBean bean=new RoleTypeBean();
bean.setRoleId(model.getRoleId());
bean.setRoleName(model.getRoleName());
bean.setCreatedBy(model.getCreatedBy());
bean.setCreatedOn(model.getCreatedOn());
bean.setModifyBy(model.getModifyBy());
bean.setModifyOn(model.getModifyOn());
bean.setActive(model.getActive());
bean.setRoleSequece(model.getRoleSequece());
//if(model.getCreatedOn()!=null)
//	bean.setCreatedOnUtc(Common.getUtcFormat(model.getCreatedOn()));
//if(model.getModifyOn()!=null)
//	bean.setModifyOnUtc(Common.getUtcFormat(model.getModifyOn()));
return bean;
}

public static List<RoleTypeBean> prepareListBean(List<RoleTypeModel> listModel)
{
List<RoleTypeBean> beans=null;

if(listModel!=null && !listModel.isEmpty())
{
beans=new ArrayList<RoleTypeBean>();
for(RoleTypeModel model : listModel)
{
	
beans.add(prepareBean(model));
}
}
return beans;
}
public static List<RoleTypeModel> prepareListModel(List<RoleTypeBean> beans)
{
List<RoleTypeModel> listModel=null;
if(beans!=null && !beans.isEmpty())
{
listModel=new ArrayList<RoleTypeModel>();
for(RoleTypeBean bean : beans)
{
listModel.add(prepareModel(bean));
}
}
return listModel;
}
