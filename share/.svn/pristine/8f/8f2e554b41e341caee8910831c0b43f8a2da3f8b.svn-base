package com.ecartes.validator;

import java.util.regex.Pattern;

import org.springframework.stereotype.Component;
import org.springframework.validation.Errors;
import org.springframework.validation.ValidationUtils;
import org.springframework.validation.Validator;

import com.ecartes.bean.ItemLocationSpaceBean;

@Component
public class ItemSpaceLocationValidator implements Validator {

	@Override
	public boolean supports(Class<?> clazz) {
		return ItemLocationSpaceBean.class.equals(clazz);
	}

	@Override
	public void validate(Object obj, Errors err) {
	    ValidationUtils.rejectIfEmpty(err, "itemLocationSpaceName", "itemLocation.itemLocationSpaceName.empty");
	    ValidationUtils.rejectIfEmpty(err, "itemLocationFloor", "itemLocation.itemLocationFloor.empty");

	    if (!err.hasErrors()) {
	        ItemLocationSpaceBean itemLocationspaceBean = (ItemLocationSpaceBean) obj;

	        Pattern pattern = Pattern.compile("[a-zA-Z0-9 [-_////&(),.]]*", Pattern.CASE_INSENSITIVE);
	        if (!pattern.matcher(itemLocationspaceBean.getItemLocationSpaceName()).matches()) {
	            err.rejectValue("itemLocationSpaceName", "itemLocationSpaceName.invalid.characters");
	        }

	        if (itemLocationspaceBean.getItemLocationSpaceName() != null
	                && itemLocationspaceBean.getItemLocationSpaceName().length() >= 90) {
	            err.rejectValue("itemLocationSpaceName", "itemLocationSpaceName.field.length");
	        }
	        
	        if (itemLocationspaceBean.getItemLocationFloor() == null 
	                || itemLocationspaceBean.getItemLocationFloor().getItemLocationId() == null) {
	        	err.rejectValue("itemLocationFloor", "itemLocationFloor.unsaved");
	        }

	        if (itemLocationspaceBean.getItemLocationFloor() == null) {
	            err.rejectValue("itemLocationFloor", "itemLocationFloor.null");
	        } else if (itemLocationspaceBean.getItemLocationFloor().getItemLocationId() == null) {
	            err.rejectValue("itemLocationFloor", "itemLocationFloor.unsaved");
	        }
	    }
	}


}
