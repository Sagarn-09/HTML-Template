	@Override
	public boolean preHandle(HttpServletRequest request, HttpServletResponse response, Object handler)
			throws Exception {
		
		boolean mobileRequest = false;
		if (request.getHeader("User-Agent").indexOf("Mobile") != -1
				|| request.getHeader("User-Agent").contains("Android")
				|| request.getHeader("User-Agent").contains("Apache-HttpClient")) {
			mobileRequest = true;
		}

		boolean ajaxRequest = "XMLHttpRequest".equals(request.getHeader("X-Requested-With"));

		String uri = request.getRequestURI();
//		System.out.println("uri" + uri);

		request.getSession().setAttribute("mm", request.getParameter("mm"));
		request.getSession().setAttribute("ms", request.getParameter("ms"));
		request.getSession().setAttribute("ss", request.getParameter("ss"));
		request.getSession().setAttribute("uri", uri);

		// **********************withoutLoginUrlHit**************


		// ************************withaout login end************

	//	System.out.println("ajaxRequest" + ajaxRequest);
	//	System.out.println("mobileRequest" + mobileRequest);
		// ajaxRequest=true;
		if (ajaxRequest || mobileRequest || uri.contains("rfid") || uri.contains("resource")) {

			return true;
		} else /*
				 * if((uri.contains("device")|| uri.contains("Device")) && mobileRequest ) {
				 * 
				 * LoginBean userData = (LoginBean)
				 * request.getSession().getAttribute("LOGGEDIN_USER"); if(userData == null &&
				 * !uri.contains("devicelogin.do")) { response.sendRedirect("devicelogin.do");
				 * return false; }
				 * 
				 * 
				 * }else
				 * 
				 */

		if (!uri.endsWith("login.do") && !uri.endsWith("logout.do")) {

			LoginBean userData = (LoginBean) request.getSession().getAttribute("LOGGEDIN_USER");
			if (userData == null) {
				response.sendRedirect("login.do");
				return false;
			}
		}
		return true;
	}
}