package com.ecartes.controller;

import java.util.ArrayList;
import java.util.Date;
import java.util.List;

import javax.servlet.http.HttpServletRequest;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;

import com.ecartes.bean.LoginBean;
import com.ecartes.bean.RoleTypeBean;
import com.ecartes.model.RoleTypeModel;
import com.ecartes.service.RoleTypeService;
import com.ecartes.validator.RoleTypeValidator;

import org.springframework.validation.BindingResult;
import org.springframework.validation.ObjectError;
import org.springframework.validation.annotation.Validated;
import org.springframework.web.bind.WebDataBinder;
import org.springframework.web.bind.annotation.InitBinder;
import org.springframework.web.bind.annotation.ModelAttribute;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestMethod;
import org.springframework.web.servlet.ModelAndView;

@Controller
public class RoleTypeController {
	@Autowired
	RoleTypeService roleTypeService;

	@Autowired
	RoleTypeValidator roleTypeValidator;

	@ModelAttribute
	public void addingCommonObject(Model model, HttpServletRequest request) {
		model.addAttribute("roleTypeList", RoleTypeBean.prepareListBean(roleTypeService.getListRoleType()));
	}

	@InitBinder
	public void InitBinder(WebDataBinder binder) {
		binder.addValidators(roleTypeValidator);

	}

	@RequestMapping(value = "/addRoleType", method = RequestMethod.GET)
	public ModelAndView addRoleType(@ModelAttribute("command") RoleTypeBean roleTypeBean, BindingResult result,
			HttpServletRequest request) {
		ModelAndView modelAndView = new ModelAndView("pages/roleType/addroleType");
		roleTypeBean.setActive(true);
		modelAndView.addObject("roleTypeBean", roleTypeBean);
		return modelAndView;

	}

	@RequestMapping(value = "/saveRoleType", method = RequestMethod.POST)
	public ModelAndView saveRoleType(@ModelAttribute("command") @Validated RoleTypeBean roleTypeBean,
			BindingResult result, HttpServletRequest request) {
		ModelAndView modelAndView = null;
		try {
			if (result.hasErrors()) {
				modelAndView = new ModelAndView("pages/roleType/addroleType");
				return modelAndView;
			} else {
				LoginBean loginUser = (LoginBean) request.getSession().getAttribute("LOGGEDIN_USER");
				modelAndView = new ModelAndView("pages/roleType/displayroleType");

				if (roleTypeBean.getRoleName() != null && roleTypeBean.getRoleName().length() > 0) {

					RoleTypeModel roleTypeModel = roleTypeService.getRoleTypeByRoleName(roleTypeBean.getRoleName());

					if (roleTypeModel != null) {

						if (roleTypeBean.getRoleId() == null || roleTypeBean.getRoleId() <= 0) {

							modelAndView = new ModelAndView("pages/roleType/addroleType");
							modelAndView.addObject("roleTypeBean", roleTypeBean);
							ObjectError objectError = new ObjectError("message", "Role Name Already Exit!");
							result.addError(objectError);
							return modelAndView;

						} /*
							 * else if (roleTypeModel.getRoleName().equals(roleTypeBean.getRoleName())) {
							 * modelAndView = new ModelAndView("pages/roleType/addroleType");
							 * modelAndView.addObject("roleTypeBean", roleTypeBean); ObjectError objectError
							 * = new ObjectError("message", "Role Name Already Exit!");
							 * result.addError(objectError); return modelAndView; }
							 */
					}

				}
				Integer roleId = null;
				roleId = roleTypeBean.getRoleId();

				roleTypeBean.setCreatedOn(new Date());
				roleTypeBean.setModifyOn(new Date());
				roleTypeBean.setCreatedBy(loginUser.getLoginId());
				roleTypeBean.setModifyBy(loginUser.getLoginId());

				roleTypeService.addRoleType(RoleTypeBean.prepareModel(roleTypeBean));

				if (roleId == null)
					modelAndView.addObject("successMessage", "Record successfully inserted.");
				else
					modelAndView.addObject("successMessage", "Record successfully modified.");

				RoleTypeModel model = RoleTypeBean.prepareModel(roleTypeBean);
				List<RoleTypeBean> list = new ArrayList<RoleTypeBean>();
				list.add(RoleTypeBean.prepareBean(model));

				modelAndView.addObject("roleTypeList", list);
				modelAndView.addObject("roleTypeBean", roleTypeBean);
			}

		} catch (Exception e) {
			e.printStackTrace();
		}
		return modelAndView;

	}

	@RequestMapping(value = "/displayRoleType", method = RequestMethod.GET)
	public ModelAndView displayRoleType(@ModelAttribute("command") RoleTypeBean roleTypeBean, BindingResult result,
			HttpServletRequest request) {
		ModelAndView modelAndView = null;
		if (result.hasErrors()) {
			modelAndView = new ModelAndView("pages/roleType/displayroleType");
			return modelAndView;
		} else {

			modelAndView = new ModelAndView("pages/roleType/displayroleType");
			modelAndView.addObject("roleTypeList", RoleTypeBean.prepareListBean(roleTypeService.getListRoleType()));
			modelAndView.addObject("roleTypeBean", roleTypeBean);
			return modelAndView;
		}

	}

	@RequestMapping(value = "/editRoleType", method = RequestMethod.GET)
	public ModelAndView editRoleType(@ModelAttribute("command") RoleTypeBean roleTypeBean, BindingResult result,
			HttpServletRequest request) {
		ModelAndView modelAndView = null;
		if (result.hasErrors()) {
			modelAndView = new ModelAndView("pages/roleType/addroleType");
			return modelAndView;
		} else {

			modelAndView = new ModelAndView("pages/roleType/addroleType");

			modelAndView.addObject("roleTypeBean",
					RoleTypeBean.prepareBean(roleTypeService.getRoleType(roleTypeBean.getRoleId())));

			return modelAndView;
		}

	}

}
