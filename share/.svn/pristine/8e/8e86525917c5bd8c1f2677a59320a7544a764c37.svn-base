package com.ecartes.model;
import java.io.Serializable;
import java.util.Date;
import javax.persistence.Column;
import javax.persistence.Entity;
import javax.persistence.GeneratedValue;
import javax.persistence.GenerationType;
import javax.persistence.Id;
import javax.persistence.JoinColumn;
import javax.persistence.ManyToOne;
import javax.persistence.Table;

@Entity
@Table(name="templog")
public class TempLogModel implements Serializable
{
private static final long serialVersionUID = -723583058586873479L;
@Id
@GeneratedValue(strategy=GenerationType.AUTO)
@Column(name = "logId")
private Integer logId=null;
public Integer getLogId() {
	return logId;
}
public void setLogId(Integer logId) {
	this.logId = logId;
}

@ManyToOne
@JoinColumn(name="bookID" , nullable = true, updatable=true)
private RawMaterialInwardModel item=null;



public RawMaterialInwardModel getItem() {
	return item;
}
public void setItem(RawMaterialInwardModel item) {
	this.item = item;
}

@Column(name = "intime", nullable = true, updatable=true)	
private Date intime=null;
@Column(name = "logTime", nullable = true, updatable=true)	
private Date logTime=null; 
@Column(name = "outTime", nullable = true, updatable=true)	
private Date  outTime=null; 
public Date getIntime() {
	return intime;
}
public void setIntime(Date intime) {
	this.intime = intime;
}
public Date getLogTime() {
	return logTime;
}
public void setLogTime(Date logTime) {
	this.logTime = logTime;
}
public Date getOutTime() {
	return outTime;
}
public void setOutTime(Date outTime) {
	this.outTime = outTime;
}
public String getLocationName() {
	return locationName;
}
public void setLocationName(String locationName) {
	this.locationName = locationName;
}


private String locationName=null; 
private Integer status=null;
private Boolean active=false;
public Integer getStatus() {
	return status;
}
public Boolean getActive() {
	return active;
}
public void setActive(Boolean active) {
	this.active = active;
}
public void setStatus(Integer status) {
	this.status = status;
}

}
