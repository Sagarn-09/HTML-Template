package com.ecartes.model;

import java.io.Serializable;
import java.util.Date;
import javax.persistence.Column;
import javax.persistence.Entity;
import javax.persistence.GeneratedValue;
import javax.persistence.GenerationType;
import javax.persistence.Id;
import javax.persistence.JoinColumn;
import javax.persistence.ManyToOne;
import javax.persistence.Table;

@Entity
@Table(name = "RawMaterialInward")
public class RawMaterialInwardModel implements Serializable {

	private static final long serialVersionUID = -723583058586873479L;

	@Id
	@GeneratedValue(strategy = GenerationType.AUTO)
	@Column(name = "rawMaterialInwardID")
	private Integer rawMaterialInwardID = null;
	@Column(name = "assetTagToBeEncoded")
	private String assetTagToBeEncoded = null;
	@Column(name = "assetUID")
	private String assetUID = null;
	@Column(name = "typeOfTags")
	private String typeOfTags = null;
	
	@ManyToOne
	@JoinColumn(name = "binLocationId", nullable = true, updatable = true)
	private ItemLocationModel binLocation = null;
	
	@ManyToOne
	@JoinColumn(name = "scanLocationId", nullable = true, updatable = true)
	private ItemLocationModel scanLocation = null;
	
	@Column(name = "tagID")
	private String tagID = null;
	@Column(name = "verifiedOnSite")
	private Boolean verifiedOnSite = false;
	@Column(name = "active")
	private Boolean active = false;
	@Column(name = "createdBy")
	private Integer createdBy = 0;
	@Column(name = "createdOn", updatable = false)
	private Date createdOn = null;
	@ManyToOne
	@JoinColumn(name = "modifyBy", updatable = false)
	private LoginModel modifyBy = null;
	@Column(name = "modifyOn", updatable = true)
	private Date modifyOn = null;
	@Column(name = "trade")
	private String trade = null;
	
	@Column(name = "parentLocationId")
	private Integer parentLocationId = null;	

	public Integer getParentLocationId() {
		return parentLocationId;
	}

	public void setParentLocationId(Integer parentLocationId) {
		this.parentLocationId = parentLocationId;
	}

	@ManyToOne
	@JoinColumn(name = "assetCategoryId", nullable = true, updatable = true)
	private AssetCategoryModel assetCategory = null;

	@Column(name = "scanSpaceFloorName")
	private String scanSpaceFloorName = null;
	
	private String spaceFloorName=null;
	
	private String assetName =null;
	
	private String description = null;
	
	private Date amcDueDate =null;
	
	@Column(name = "srNo")
	private String srNo = null;
	
	public String getSrNo() {
		return srNo;
	}

	public void setSrNo(String srNo) {
		this.srNo = srNo;
	}

	public Date getAmcDueDate() {
		return amcDueDate;
	}

	public void setAmcDueDate(Date amcDueDate) {
		this.amcDueDate = amcDueDate;
	}

	public String getAssetName() {
		return assetName;
	}

	public void setAssetName(String assetName) {
		this.assetName = assetName;
	}

	public String getDescription() {
		return description;
	}

	public void setDescription(String description) {
		this.description = description;
	}

	public String getSpaceFloorName() {
		return spaceFloorName;
	}

	public void setSpaceFloorName(String spaceFloorName) {
		this.spaceFloorName = spaceFloorName;
	}

	public String getScanSpaceFloorName() {
		return scanSpaceFloorName;
	}

	public void setScanSpaceFloorName(String scanSpaceFloorName) {
		this.scanSpaceFloorName = scanSpaceFloorName;
	}

	public Integer getRawMaterialInwardID() {
		return rawMaterialInwardID;
	}

	public void setRawMaterialInwardID(Integer rawMaterialInwardID) {
		this.rawMaterialInwardID = rawMaterialInwardID;
	}

	public String getAssetTagToBeEncoded() {
		return assetTagToBeEncoded;
	}

	public void setAssetTagToBeEncoded(String assetTagToBeEncoded) {
		this.assetTagToBeEncoded = assetTagToBeEncoded;
	}

	public String getAssetUID() {
		return assetUID;
	}

	public void setAssetUID(String assetUID) {
		this.assetUID = assetUID;
	}

	public String getTypeOfTags() {
		return typeOfTags;
	}

	public void setTypeOfTags(String typeOfTags) {
		this.typeOfTags = typeOfTags;
	}

	public ItemLocationModel getBinLocation() {
		return binLocation;
	}

	public void setBinLocation(ItemLocationModel binLocation) {
		this.binLocation = binLocation;
	}

	public ItemLocationModel getScanLocation() {
		return scanLocation;
	}

	public void setScanLocation(ItemLocationModel scanLocation) {
		this.scanLocation = scanLocation;
	}

	public String getTagID() {
		return tagID;
	}

	public void setTagID(String tagID) {
		this.tagID = tagID;
	}

	public Boolean getVerifiedOnSite() {
		return verifiedOnSite;
	}

	public void setVerifiedOnSite(Boolean verifiedOnSite) {
		this.verifiedOnSite = verifiedOnSite;
	}

	public Boolean getActive() {
		return active;
	}

	public void setActive(Boolean active) {
		this.active = active;
	}

	public Integer getCreatedBy() {
		return createdBy;
	}

	public void setCreatedBy(Integer createdBy) {
		this.createdBy = createdBy;
	}

	public Date getCreatedOn() {
		return createdOn;
	}

	public void setCreatedOn(Date createdOn) {
		this.createdOn = createdOn;
	}

	public LoginModel getModifyBy() {
		return modifyBy;
	}

	public void setModifyBy(LoginModel modifyBy) {
		this.modifyBy = modifyBy;
	}

	public Date getModifyOn() {
		return modifyOn;
	}

	public void setModifyOn(Date modifyOn) {
		this.modifyOn = modifyOn;
	}

	public String getTrade() {
		return trade;
	}

	public void setTrade(String trade) {
		this.trade = trade;
	}

	public AssetCategoryModel getAssetCategory() {
		return assetCategory;
	}

	public void setAssetCategory(AssetCategoryModel assetCategory) {
		this.assetCategory = assetCategory;
	}

}
